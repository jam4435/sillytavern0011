{"schemaVersion":1,"id":"shard-0007","definitions":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":20,"时":23,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":0,"分":0},"事件引子":"少室山大雄宝殿前夜色深沉，厮杀初平的广场杀气未散，殿顶骤响裂空破风之声。","事件详情":"少室山大雄宝殿前夜色深沉，各派高手的厮杀方才平息，玄慈方丈率少林群僧合十肃立，丐帮与大理群雄犹自惊魂未定。正当众人以为战局已定时，屋脊两侧陡然炸响两道撕裂长空的尖锐破空之声。只见两道黑袍蒙面身影宛如两头扑食苍鹰，自重檐庑殿顶俯冲而下，足尖仅在悬空的铜钟与蟠龙立柱上轻点借力，身形飘忽若鬼魅。萧峰见状瞳孔骤缩，沉腰扎马暗催丹田内劲护体，段誉与虚竹亦各自踏奇门步法护持两侧，少林罗汉堂众僧更是齐声呼喝、横棍结成铁桶金刚阵。两名黑衣老者刹那间并肩落于广场正中，浑厚无匹的护体罡气随之轰然外涌，落脚处坚硬的青石地板应声寸寸龟裂，激荡的气浪硬生生将前排持棍的六名少林武僧震得倒退三步、胸口烦闷欲呕。两名神秘人不置一词，渊渟岳峙地傲立全场焦点，目光冷冽地扫过玄慈、萧峰与慕容复等人，原本稍见平息的少林广场瞬间陷入冰封般的极度死寂，各派豪强纷纷按剑凝神，一场更为凶险的滔天杀局骤然降临。","事件概要":"少室山大战刚平，两名黑袍蒙面神秘老者自大雄宝殿殿顶如苍鹰般飞扑而下，携沛然莫御的护体罡气震裂青石，逼退少林武僧。二人渊渟岳峙冷视全场，萧峰沉腰运劲戒备，段誉、虚竹与玄慈等各方高手按兵凝神，稍显平息的少林广场再度陷入凶险死寂。","insert":{"乔峰":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"自南京毒酒之厄与囚禁中获救后，在两位义弟帮助调息下毒力渐退、内力恢复；忽闻殿顶破空之声大作，抬眼见两名黑袍蒙面老者如鹰隼般自屋脊俯冲而下并震裂青石，心头骤凛，当即沉腰扎马、暗运浑厚丹田真气以防不测。"}},"段誉":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"见两道黑袍蒙面怪影从殿顶俯冲坠落、落地罡风将少林武僧逼退数步，惊异之余迅即脚踏奇门步法抢步护在长兄身侧，提运内力凝神戒备。"}},"虚竹":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"见殿脊两侧掠下两名身法诡异的黑衣老者，护体罡气威势惊人、震裂石板，急忙施展奇门步法与三弟并肩拱卫大哥，合力御敌以防变故。"}},"玄慈":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"刚率群僧平定战局，突见两名黑衣蒙面人凌空飞落大殿广场并以无匹罡气震退门下持棍武僧，深感来者武功深不可测，合十肃立凝视二人以静观其变。"}},"慕容复":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"败局方定之际，忽见两名黑衣蒙面高手破空飞降广场、激荡罡气震裂青石，引得全场陷入死寂，心中惊疑不定，暗自按剑冷眼窥伺局势走向。"}}},"update":{},"后续事件":{"天龙第四十一回02-萧远山揭面认亲与萧峰痛哭":"少林古刹前剑拔弩张，立于广场左侧的蒙面老者凝视萧峰，山风猎猎间胸膛剧烈起伏。"},"参与人物":["乔峰","段誉","虚竹","玄慈","慕容复"]},"天龙第四十一回02-萧远山揭面认亲与萧峰痛哭":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":0,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":1,"分":0},"事件引子":"少林古刹前剑拔弩张，立于广场左侧的蒙面老者凝视萧峰，山风猎猎间胸膛剧烈起伏。","事件详情":"面对少林广场上如临大敌的各派豪杰，立于左侧的黑衣老者久久凝视着昂藏巍峨的萧峰，胸膛剧烈起伏，忽然仰天爆发出一阵凄厉苍凉的长笑，笑声中夹杂着三十年刻骨铭心的悲愤，震得少室山漫山古刹嗡嗡作响。在群雄惊愕的目光注视下，老者右手猛然发力，一把扯下遮面的黑巾甩落于地。黑巾飘落处，露出一张与萧峰生得八九分相似的粗豪脸庞，浓眉阔口，宛如同一块生铁铸就，唯独两鬓如霜，面颊上刻满了风刀霜剑雕凿的深刻皱纹。萧峰见状如遭焦雷轰顶，挺拔的身躯禁不住剧烈颤抖，失声喃喃自语。萧远山眼中泪光滚落，跨步上前沉声唤道：“孩儿，三十年了！”这一声呼唤彻底击溃了契丹战神的铁石心肠，萧峰再无迟疑，轰然双膝跪倒在青石地上，膝行上前一把抱住生父的腰肢，将头颅深埋在父亲怀中放声痛哭。萧远山亦双臂如铁钳般紧紧搂住爱子，泪洒衣襟。三十载骨肉分离的凄苦与冤屈在少林寺前化作撼天动地的恸哭，令在场的少林高僧与天下豪侠尽皆心神剧震、怆然失色。","事件概要":"黑衣老者仰天发出一阵凄厉长笑，当众猛然扯下黑巾，露出一张与萧峰生得八九分相似的面庞并沉声唤儿。萧峰心神大震认出生父，轰然跪地膝行抱住其腰肢放声痛哭，三十载骨肉分离终在天下豪杰前相认。","insert":{"萧远山":{"人物经历":{"天龙第四十一回02-萧远山揭面认亲与萧峰痛哭":"久视昂藏而立的骨肉，三十年刻骨悲愤化作仰天凄凉长笑，猛力扯下面巾露出真容唤其相认，旋即伸铁臂紧紧搂住跪地哭拜的爱子，热泪滚落衣襟。"}},"乔峰":{"人物经历":{"天龙第四十一回02-萧远山揭面认亲与萧峰痛哭":"突见黑衣老者仰天大笑并扯下面巾，显出一张与自己宛如生铁同铸的面孔，听其一声呼唤如遭雷震，登时轰然跪倒膝行扑入生父怀中放声痛哭。"}}},"update":{"萧远山":{"外貌":"身材魁梧高大，身着黑色夜行布袍，两鬓如霜，浓眉阔口，面颊饱经风霜且面貌与萧峰生得八九分相似。","关系网":{"乔峰":"亲子/100"}},"乔峰":{"关系网":{"萧远山":"生父/100"}}},"后续事件":{"天龙第四十一回03-萧远山自述潜伏复仇揭杀戮真相":"大殿前石阶旁寒风卷地，各派豪杰与少林僧众屏息按刃，场中死一般沉寂。"},"参与人物":["萧远山","乔峰"]},"天龙第四十一回03-萧远山自述潜伏复仇揭杀戮真相":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":1,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":2,"分":0},"事件引子":"大殿前石阶旁寒风卷地，各派豪杰与少林僧众屏息按刃，场中死一般沉寂。","事件详情":"父子相认后，萧远山扶起萧峰，霍然转身逼视少林群僧与天下豪杰，眼中喷薄出森然杀气。他踏前三步，声音如铜钟激荡，当众揭开三十年前雁门关绝壁跳崖后的骇人隐秘：当年他怀抱亡妻跳下万丈深渊，幸得绝壁古树悬挂保全残躯，自此隐姓埋名，暗中潜伏进少林寺藏经阁三十载，夜夜翻阅偷学少林七十二绝技以积蓄复仇力量。言及此处，萧远山面露快意与狠厉，厉声宣布近来震惊江湖的连环血案皆系他一人所为——潜入乔家村震毙养育萧峰的乔三槐夫妇，夜闯菩提院击碎授业恩师玄苦大师的胸骨，乃至在聚贤庄外与卫辉城中先后掌毙赵钱孙、谭公谭婆以及单正全家。他步步紧逼喝道：“当年带头大哥杀我爱妻、夺我幼子，凡是隐瞒元凶的知情者，皆该碎尸万段！”此言一出，全场武林名宿骇然失色，少林僧众齐诵佛号悲愤难抑。萧峰听闻恩师与养父母竟丧于生父之手，面色惨白、心如刀绞，三十年笼罩在聚贤庄与少林寺头顶的冤狱谜团终以最残酷的方式水落石出。","事件概要":"萧远山扶起萧峰并逼视天下豪杰，当众揭露三十年前雁门关绝壁逢生后潜伏少林偷学绝技的隐秘，更厉声承认乔三槐夫妇、玄苦及赵钱孙等连环血案皆系己所为，以血腥报复隐瞒“带头大哥”的知情者。萧峰惊闻噩耗心如刀绞，轰动江湖的连环悬案至此水落石出。","insert":{"萧远山":{"人物经历":{"天龙第四十一回03-萧远山自述潜伏复仇揭杀戮真相":"扶起萧峰后横眉逼视少林群僧与天下豪杰，厉声宣告自己三十年来潜伏少林寺藏经阁偷学绝技、暗中格杀乔三槐夫妇与玄苦等隐瞒者的复仇经过，誓要让血案元凶血债血偿。"}},"乔峰":{"人物经历":{"天龙第四十一回03-萧远山自述潜伏复仇揭杀戮真相":"被生父扶起后惊闻雁门关绝壁生还与三十载潜伏旧事，骤然得知抚育自己的养父母、授业恩师玄苦及赵钱孙等人竟全丧于生父之手，面色惨白、心如刀绞。"}}},"update":{},"后续事件":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"少室山广场上杀气未散，另一名黑衣老者忽发森寒嗤笑，引得满场豪杰错愕侧目。"},"参与人物":["萧远山","乔峰"]},"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":2,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":3,"分":0},"事件引子":"少室山广场上杀气未散，另一名黑衣老者忽发森寒嗤笑，引得满场豪杰错愕侧目。","事件详情":"就在全场豪杰为萧远山的复仇杀戮惊骇莫名之际，站在一侧始终冷眼旁观的另一名黑衣老者忽然发出一阵森寒刺骨的嗤笑。在天下英雄与少林高僧的错愕注视下，该老者神色自若地抬起枯瘦的右掌，慢条斯理地扯下遮面黑巾，随手掷于脚下。黑巾褪去，显出一张清瘦矍铄、双目神光如电的威严面庞。少林玄字辈高僧玄渡与玄生定睛望去，顿时如见鬼魅般倒退数步，颤声惊呼：“慕容老施主？你……你当年不是早已染疾西归？！”一旁的慕容复更是浑身剧颤，扑通跪倒在地，失声悲呼：“爹爹！”慕容博负手傲立，嘴角挂着睥睨众生的冷笑，坦然承认三十年前假死遁世乃金蝉脱壳之计。他这三十年来同样隐姓埋名潜伏于少林藏经阁中，不仅将七十二绝技抄录带回燕子坞参合庄，更在暗中窥伺列国烽烟、图谋光复大燕皇朝。慕容博的死而复生如同一记惊雷在大雄宝殿前炸开，假死面具彻底撕碎，姑苏慕容氏三十年的复国野心与阴谋诡计在天下英雄面前暴露无遗。","事件概要":"黑衣老者当众扯下面巾现出真容，赫然是三十年前已传染疾西归的姑苏慕容博，引得少林群僧骇然失色、慕容复悲哭跪拜。慕容博傲然承认当年假死遁世之计，并公然坦陈数十年来潜伏少林藏经阁盗录绝技、窥伺天下以图复兴大燕的野心，假死伪装至此彻底告破。","insert":{"慕容博":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"在群雄骇异注视下冷笑扯去遮面黑巾显露真容，受慕容复跪拜相认，当众傲然宣告昔年金蝉脱壳假死之谋，并坦承三十年来潜伏藏经阁抄录绝技以图复燕的毕生大计。"}},"慕容复":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"见冷眼旁观的黑衣老者揭面竟是亡故数十年的先父，心神剧震之下扑通跪地痛哭悲呼，在震惊与狂喜交加中聆听其揭晓假死脱身与潜伏少林的复国大谋。"}},"萧远山":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"冷眼怒视另一名曾同在藏经阁潜伏的黑衣僧人扯下面巾，见其竟是假死三十载的姑苏慕容博，心中杀机与旧恨翻涌，严阵以待其图谋。"}},"玄渡":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"惊见黑衣人扯下面巾显出早年故人慕容博的面容，震骇之下连退数步失声惊呼，难以置信这位染疾西归数十载的慕容老施主竟假死潜藏少林盗取绝技。"}},"玄生":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"目睹扯下面巾之人确系本已死灭三十年的慕容博，心神大骇如见鬼魅，闻听其自承潜入藏经阁盗录七十二绝技与复国野心，惊怒交加戒备以对。"}}},"update":{},"后续事件":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"大雄宝殿前朔风呼啸，群雄屏息凝神，肃杀之气笼罩着整座青石广场。"},"参与人物":["慕容博","慕容复","萧远山","玄渡","玄生"]},"天龙第四十一回05-雁门血案元凶大白引两家对立":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":3,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":4,"分":0},"事件引子":"大雄宝殿前朔风呼啸，群雄屏息凝神，肃杀之气笼罩着整座青石广场。","事件详情":"慕容博的真实面目昭然若揭，三十年前酿成雁门关惨剧的万恶之源终于大白于天下。萧远山双目赤红，咬牙切齿地当众喝破慕容博当年的毒计：正是慕容博为挑起宋辽两国交兵、以便趁乱复兴大燕，居心叵测地向少林玄慈方丈假传密信，谎称契丹武士要血洗少林盗取藏经，这才引得中原二十一位武林高手在雁门关设伏截杀。玄慈方丈闻言闭目垂泪，双手合十长叹：“善哉，善哉！老衲当年轻信慕容施主之言，误杀无辜，罪孽深重！”面对玄慈的自责与全场群雄的怒视，慕容博却仰天狂笑，毫无愧悔之色，反斥成大事者不拘小节。得悉生母惨死崖底、生父跳崖残生、自己沦为孤儿且蒙冤半生的根源全系眼前之人所为，萧峰胸中怒焰滔天，周身降龙真气疯狂鼓荡，青袍无风自鼓；萧远山更是拔出随身兵刃，杀气贯顶。慕容复则拔出佩剑护在慕容博身侧，仇人相见分外眼红，萧氏与慕容氏两代人的血海深仇至此激化至万劫不复的绝境。","事件概要":"萧远山当众揭露慕容博假传契丹夺经密信、挑起雁门关惨案的复燕毒计。玄慈方丈垂泪认错悔恨误杀无辜，慕容博狂笑反唇相讥毫无悔意。得悉身世浩劫根源，萧峰父子怒发冲冠拔刃相向，慕容复按剑护父，两代世仇彻底爆发。","insert":{"玄慈":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"闻听萧远山当众痛陈当年雁门关惨案的伪信真相，心头大震、闭目垂泪，双手合十悲叹自己当年失于明察、轻信妄语而戕害无辜，悔恨难当。"}},"萧远山":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"双目赤红逼视慕容博，厉声喝破其假传契丹武士盗经密信、挑起宋辽交兵以图复燕的滔天阴谋；见仇敌狂笑无悔，怒极拔出随身兵刃，杀意贯顶。"}},"乔峰":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"乍闻三十年前生母惨死、家破人亡及自身半生孤苦蒙冤之根由全系慕容博毒计所致，悲愤交加，胸中怒焰狂涌，周身降龙真气暴涨鼓荡，誓报血海深仇。"}},"慕容博":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"面对萧远山的当众揭发与玄慈的愧疚自责，昂首仰天狂笑，非但不思悔过，反斥妇人之仁成不得大事，冷对怒发冲冠的萧氏父子，暗运真气凝神戒备。"}},"慕容复":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"眼见父亲昔年筹谋大白于天下招致群雄侧目，又见萧峰父子真气暴涌、杀气凛冽地逼近，当即拔出随身佩剑横身护在父亲身侧，严阵以待。"}}},"update":{},"后续事件":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"少室山广场宿怨如炽，秋风卷过寺旗，四下杀气凝滞直逼殿宇穹顶。"},"参与人物":["玄慈","萧远山","乔峰","慕容博","慕容复"]},"天龙第四十一回06-萧氏慕容两代父子广场生死斗":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":4,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":5,"分":0},"事件引子":"少室山广场宿怨如炽，秋风卷过寺旗，四下杀气凝滞直逼殿宇穹顶。","事件详情":"血海深仇引爆千钧杀机，萧峰暴喝一声率先发难，双掌划弧推出降龙廿八掌之“亢龙有悔”，雄浑无匹的刚猛掌力化作低沉龙吟，如惊涛骇浪般直拍慕容博面门。慕容博不敢撄其锋芒，足尖滑步斜掠，右手食指连弹，家传绝技“参合指”化作数道凌厉无匹的破空无形指劲，嗤嗤作响迎向排山倒海的掌风。与此同时，萧远山厉啸着合身扑向慕容复，少林般若掌挟着三十年沉淀的伏魔罡气呼啸击出，每一掌均势沉力拔。慕容复咬紧牙关，全力运转“斗转星移”借力打力之术，佩剑化作漫天银芒试图卸去刚猛掌力，然而双雄内力悬殊，剑锋触及掌风的瞬间嗡嗡剧颤，震得慕容复虎口开裂、气血翻涌。四位当世绝顶高手在少林寺广场上捉对厮杀，掌影翻飞，剑气纵横，狂暴的真气余波将广场四周数根合抱粗的寺旗巨柱连根震断，碎石泥尘冲天而起。两代父子生死相搏，招招直取要害，慕容复渐渐不支嘴角溢血，慕容博见状招式一变，急催内力护住儿子，场中杀戮陷入白热化的死斗。","事件概要":"两代血仇彻底爆发，萧峰发难施展降龙廿八掌怒拍慕容博，萧远山亦运般若掌力合身猛扑慕容复。慕容博以参合指斜掠卸劲，慕容复全力运转斗转星移却因内力悬殊震裂虎口、吐血不支。四人激战震断巨柱，慕容博急变招护子，死斗陷入白热化。","insert":{"乔峰":{"人物经历":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"为报父母血仇率先暴喝发难，双掌划弧推出降龙廿八掌之亢龙有悔，以排山倒海般的雄浑罡气直轰慕容博面门，誓杀首恶以雪三十载奇冤。"}},"慕容博":{"人物经历":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"面对萧峰威势无俦的刚猛掌力不敢正面撄锋，滑步斜掠连发参合指劲凌厉迎击；眼见复儿不敌受创喋血，当即变招急催内力飞身护子。"}},"萧远山":{"人物经历":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"趁萧峰缠斗慕容博之际厉啸扑向慕容复，催动三十年苦修的少林伏魔罡气连环拍出般若掌，以泰山压顶之势震得慕容复吐血溃退。"}},"慕容复":{"人物经历":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"拔剑全力施展斗转星移卸化萧远山沉雄掌风，终因内力相去悬殊被狂暴罡风震裂虎口、气血翻涌，嘴角溢血渐觉抵挡不住。"}}},"update":{"慕容复":{"状态":"负伤吐血"}},"后续事件":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"少林广场尘土弥漫，四道残影破空疾驰，无形掌风与指力碎裂沿途瓦木。"},"参与人物":["乔峰","慕容博","萧远山","慕容复"]},"天龙第四十一回07-两代高手一路搏杀转战藏经阁":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":5,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":6,"分":0},"事件引子":"少林广场尘土弥漫，四道残影破空疾驰，无形掌风与指力碎裂沿途瓦木。","事件详情":"少林广场上尘土漫天，慕容博眼见慕容复在萧远山的狂攻下左支右绌、险象环生，深知萧峰掌力威猛天下第一，若在空旷平地硬拼久战必落下风。他心思电转，蓦地虚晃一指逼退萧峰，随即提气纵身，展开绝顶轻功如灰鹤般拔地而起，直向少林寺后山禁地飞遁，慕容复亦紧随其后施展身法逃遁。萧峰父子复仇心切，岂肯容仇敌脱逃？萧远山厉吼“休走”，与萧峰并肩踏碎青石腾空直追。四道绝顶身影穿房过脊，一路激战不休，劈空掌风与无形指力沿途将达摩院的红墙、罗汉堂的琉璃屋瓦与数株百年苍松尽数震得粉碎。眨眼之间，慕容博破窗撞入少林武学圣地藏经阁，萧氏父子破门而入紧咬不放。狭窄幽暗的经阁之内，四人再度短兵相接，狂暴激荡的内力将层层沉香木书架掀翻，无数佛门古籍与秘籍手抄残卷在暴烈气浪中如雪片般漫天碎裂飞舞。退路尽绝，幽闭绝地中的四位当世宗师杀红了双眼，生死存亡的惨烈决战在此一触即发。","事件概要":"慕容博见慕容复难支萧远山狂攻，虚晃逼退萧峰后纵身引向后山，慕容复紧随遁走。萧氏父子踏石疾追，四人一路穿房破瓦激战至藏经阁内。沉香木书架在暴烈罡气中倾覆碎裂，佛门秘籍漫天飞扬，幽闭绝境中两代宿怨的生死决战一触即发。","insert":{"慕容博":{"人物经历":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"深知平地硬拼久战难敌萧氏父子，遂虚晃一指逼退萧峰，携复儿提气急遁后山并破窗撞入藏经阁，借幽闭狭室与纵横书架周旋死斗。"}},"慕容复":{"人物经历":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"在萧远山压迫下险象环生，趁父亲逼退萧峰之机全力施展轻功跟随后山，破门撞进藏经阁内，背水一战拔剑与二萧在乱卷飞舞中拼死搏杀。"}},"萧远山":{"人物经历":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"见慕容博引子脱逃，厉喝一声与峰儿并肩提气疾追，一路掌裂殿宇瓦木，直撞入幽暗藏经阁内，誓要在三十年潜伏之地将大燕元凶彻底掌毙。"}},"乔峰":{"人物经历":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"眼见杀母仇人破空遁逃，提足震碎青石紧咬不放，沿途以凌厉掌力硬撼指劲直追入藏经阁，盛怒之下催动刚猛掌风掀翻书架，誓雪血海深仇。"}}},"update":{},"后续事件":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"藏经阁内纸屑尘卷飞扬，两代四位绝顶高手倾力对轰，玉石俱焚的狂暴真气抽空周遭。"},"参与人物":["慕容博","慕容复","萧远山","乔峰"]},"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":6,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":7,"分":0},"事件引子":"藏经阁内纸屑尘卷飞扬，两代四位绝顶高手倾力对轰，玉石俱焚的狂暴真气抽空周遭。","事件详情":"藏经阁内尘卷飞扬，萧氏父子与慕容氏父子四人已然杀至癫狂境地。萧峰与萧远山催动十成内力，双龙出海般的降龙掌与般若掌蓄势待发，狂暴真气将周遭空气彻底抽空；慕容博与慕容复亦并肩立定，十指连弹凝起毕生功力的参合指剑气，生死存亡的玉石俱焚一击迫在眉睫。便在千钧一发的绝境关头，经阁最深处尘封的书架阴影中，一名身着灰布破旧僧袍的老僧手持一把光秃残破的竹帚，迈着无声轻缓的步伐缓步走出。老僧身形枯瘦如柴，面容苍老干瘪，神态却安详宁和，只低眉持帚沙沙扫地。就在四人毁天灭地的掌风指力轰然爆发、即将触及老僧身前三尺之时，一道无形的三尺气墙骤然凭空生出，狂暴绝伦的真气触之竟如泥牛入海，无声无息间化解得干干净净。四位绝顶宗师只觉胸口气血一窒，齐齐被浑厚柔和的无形巨力逼退三步，狂暴的内息瞬间归于平寂。老僧手扶竹帚合十诵佛，以超凡入圣的莫测神威，刹那间化解了这场同归于尽的武林浩劫。","事件概要":"萧氏父子与慕容氏父子在藏经阁内催动毕生内力决死对轰，千钧一发之际，一名枯瘦灰袍老僧手持残帚自阴影中缓步走出。四人毁天灭地的掌风指劲触及老僧身前三尺无形气墙，竟如泥牛入海般无声消弭，四位宗师齐被柔和巨力逼退平息内息，浩劫顿解。","insert":{"萧远山":{"人物经历":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"催动十成内力与峰儿并肩拍出般若掌决死一击，不料狂暴掌力轰至身前三尺处竟被一持帚老僧的无形气墙尽数化解，反被浑厚柔力震退三步，心头骇然惊服。"}},"乔峰":{"人物经历":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"提聚十成降龙真气欲毙大仇，掌风狂啸轰出之际，忽见灰袍老僧持残帚走出，排山倒海的刚猛掌力触及其护体气墙竟如泥牛入海，胸口微窒被柔力逼退数步。"}},"慕容博":{"人物经历":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"十指连弹凝出毕生参合指力拼死相搏，指风激射之时忽遇老僧现身，无形气墙刹那间将绝伦指劲消融殆尽并迫己后退，暗自惊骇于对方神乎其技的超凡功力。"}},"慕容复":{"人物经历":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"与父亲并肩倾尽残余真气击出指力，甫一出手，刚猛劲风便被一名枯瘦老僧周身气墙化解得干干净净，自身被浑厚力道反震退开数步，骇然不知所措。"}}},"update":{},"后续事件":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"},"参与人物":["萧远山","乔峰","慕容博","慕容复"]},"天龙第四十二回01-老僧现身宣讲佛法化解戾气":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":7,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":8,"分":0},"事件引子":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。","事件详情":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。","事件概要":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。","insert":{"萧远山":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}},"乔峰":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}},"慕容博":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}},"慕容复":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}},"扫地老僧":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}}},"update":{},"后续事件":{"天龙第四十二回02-老僧道破隐疾双雄试气骇然":"藏经阁内残帚横陈，扫地老僧目光深邃，凝视着剑拔弩张的萧远山与慕容博。"},"参与人物":["萧远山","乔峰","慕容博","慕容复","扫地老僧"]},"天龙第四十二回02-老僧道破隐疾双雄试气骇然":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":8,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":9,"分":0},"事件引子":"藏经阁内残帚横陈，扫地老僧目光深邃，凝视着剑拔弩张的萧远山与慕容博。","事件详情":"藏经阁内，扫地老僧在阐明佛法化解戾气之理后，目光平静而深邃地投向萧远山与慕容博二人。老僧言辞如炬，当面一语道破二人三十年来潜伏在少林藏经阁内强行兼练多门绝技、导致体内早已积聚下致命隐疾的惊天秘密。萧远山与慕容博闻听此言，心神剧震，面上虽强自镇定，暗中却各自暗提丹田真气，沿周天经脉飞速流转以验虚实。岂料真气甫一运转行至关隘，二人胸口与丹田处猛然传来一阵剧烈难当的撕裂刺痛，真气逆冲乱撞，痛彻骨髓，令二人身形微晃、呼吸受阻，险些难以自持。二人三十年来苦练绝技所积攒的凶煞戾气，此刻在老僧点拨下彻底发作显形。面对体内这般无法逆转的致命内伤绝症，萧远山与慕容博面色惨白、骇然失色，彻底认清了自身早已病入膏肓的严酷现实，原本不可一世的腾腾杀气顿时被无尽的惊恐与动摇所取代，阁内原本剑拔弩张的死斗局势由此产生剧烈转折。","事件概要":"扫地老僧当面道破萧远山与慕容博强练少林绝技已积下致命隐疾。二人暗提真气自验，关隘处剧痛攻心、经脉逆乱，彻底证实内伤已深入脏腑、无药可救。二人骇然失色，原本不可一世的滔天杀气化作惊恐，阁内生死搏杀之势骤生逆转。","insert":{"扫地老僧":{"人物经历":{"天龙第四十二回02-老僧道破隐疾双雄试气骇然":"面对凶悍对峙的萧远山与慕容博二人，平静道破其三十年来偷潜藏经阁强练绝技、戾气积聚致生致命暗疾之实，待二人试气受挫后温言点化执念。"}},"萧远山":{"人物经历":{"天龙第四十二回02-老僧道破隐疾双雄试气骇然":"闻听老僧一语道破自己三十年偷练少林绝技所积下的隐患，暗自提气运转周天以验虚实，不料关隘处猛遭真气逆冲、剧痛锥心，骇然发觉体内恶疾果已深入膏肓。"}},"慕容博":{"人物经历":{"天龙第四十二回02-老僧道破隐疾双雄试气骇然":"听闻老僧直指自己强练多门绝技致使周身经络潜藏致命隐疾，表面不动声色暗催真气查验，岂料真气刚至丹田胸口便剧痛如撕，面色惨白惊觉自身早已危在旦夕。"}}},"update":{"萧远山":{"状态":"内伤"},"慕容博":{"状态":"内伤"}},"后续事件":{"天龙第四十二回03-鸠摩智偷袭老僧气墙化刀劲":"藏经阁内佛法回荡、杀气初敛，暗角阴影处潜伏之人却已运劲蓄势，杀机暗涌。"},"参与人物":["扫地老僧","萧远山","慕容博"]},"天龙第四十二回03-鸠摩智偷袭老僧气墙化刀劲":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":9,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":10,"分":0},"事件引子":"藏经阁内佛法回荡、杀气初敛，暗角阴影处潜伏之人却已运劲蓄势，杀机暗涌。","事件详情":"吐蕃国师鸠摩智一直悄然潜伏于少林藏经阁暗处，窥伺良机。见老僧言谈之间震慑全场，鸠摩智既忌惮老僧莫测高深的神通，又欲彰显自身强绝武功以称霸武林，遂决定暗施辣手突袭老僧。鸠摩智屏息凝神，毫无预兆地自暗处暴起出手，运起毕生功力悍然轰出足以开山裂石、无坚不摧的少林绝技“火焰刀”，炽热霸道的无形刀劲裹挟着狂暴杀气直逼老僧后心。面对这突如其来的致命突袭，扫地老僧神色安详未变，甚至未曾回头，仅仅轻描淡写地袍袖微拂。刹那之间，老僧周身自然涌现出一股厚达三尺的无形护体真气墙。鸠摩智那开碑裂石、势不可挡的火焰刀神力重重撞击在无形气墙之上，犹如泥牛入海，没有激起半分狂澜，顷刻间便被消融得无影无踪。鸠摩智引以为傲的杀招被老僧以通天神功轻描淡写彻底化解，偷袭图谋瞬间化为泡影，全场绝顶高手皆为老僧这般鬼神莫测的护体神通而深感骇然。","事件概要":"鸠摩智潜伏于藏经阁暗处窥伺，为慑服全场并试探虚实，骤施辣手以毕生功力暗发无形火焰刀直袭老僧后心。不料老僧不闪不避亦未回身，仅拂袖间便以三尺浑厚护体气墙将至刚刀劲尽数化散融解，偷袭瞬成泡影，全场无不震骇于其通天神威。","insert":{"鸠摩智":{"人物经历":{"天龙第四十二回03-鸠摩智偷袭老僧气墙化刀劲":"潜伏阁中暗处窥伺老僧声威，为立威并除大患骤施辣手，自后方运足十成内力暗发火焰刀突袭其后心；岂料至刚劲力触及对方三尺护体真气墙竟如泥牛入海般消融殆尽，心头大骇，深忌其鬼神莫测之神通。"}},"扫地老僧":{"人物经历":{"天龙第四十二回03-鸠摩智偷袭老僧气墙化刀劲":"正立于阁中点化群雄，察觉暗处突来凌厉霸道的无形刀劲偷袭后心，神色自若未曾回身，仅微拂袍袖布下三尺护体真气墙，将狂暴劲力尽数化散无形。"}}},"update":{},"后续事件":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"藏经阁内檀香沉寂、散落书册狼藉，老僧佛法震慑之下，慕容博内伤发作、面色惨白。"},"参与人物":["扫地老僧","鸠摩智"]},"天龙第四十二回04-慕容博求死老僧击其天灵盖":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":10,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":11,"分":0},"事件引子":"藏经阁内檀香沉寂、散落书册狼藉，老僧佛法震慑之下，慕容博内伤发作、面色惨白。","事件详情":"在体内致命隐疾发作与神僧佛法的浩瀚震慑之下，慕容博深知自己当年挑起雁门关惨案罪孽深重，且身患绝症早已时日无多。但他一生执念于大燕复国大业，企图以自身的性命为筹码，当众提出愿以自身一死来换取大燕复国。然而扫地老僧闻言却只是慈悲长叹一声，宣了一声“冤冤相报何时了，阿弥陀佛”。话音未落，老僧看似轻描淡写地抬起一掌，掌势看似缓慢柔和毫无杀气，实则快逾闪电，正正击中慕容博的天灵盖！这看似轻飘飘的一掌落下，慕容博甚至未能做出任何抵挡与闪避，整个人浑身剧烈一震，顶门受击之下体内气息瞬间断绝，双眼翻白，当场颓然倒地气息断绝、陷入假死！一心筹谋复国的绝顶枭雄慕容博猝然毙命，这一惊天变故发生得快如电光石火，令一旁的萧峰与慕容复惊骇欲绝，藏经阁内的局势瞬间从博弈交锋陷入了极度的死寂与惊恐之中。","事件概要":"慕容博深知自身恶疾缠身、时日无多，遂以性命为筹码提出愿以己死换取大燕复国。扫地老僧长叹慈悲，看似轻描淡写地抬掌击中慕容博天灵盖，慕容博当场气息断绝倒地暴毙，阁内众人骇异失色。","insert":{"慕容博":{"人物经历":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"深知自身隐疾缠身且大势已去，遂当众提出以己一死换取大燕复国之诺，未料老僧悲叹声中看似轻柔的一掌快逾闪电按落顶门，不及变招闪避便觉周身剧震、真气尽绝，颓然仆地气绝。"}},"扫地老僧":{"人物经历":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"闻听慕容博执迷不悟仍欲以死作赌图谋复燕，慈悲宣佛叹惋因果，随即以柔掌拍中其天灵盖，令其陷入假死龟息。"}},"慕容复":{"人物经历":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"惊闻父亲竟欲舍命以全大燕复国之谋，尚未来得及劝阻，忽见扫地老僧轻飘飘一掌正中父亲顶门，眼睁睁看着父亲双目翻白、气绝仆地，惊骇欲绝、肝胆俱裂。"}},"乔峰":{"人物经历":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"冷眼听闻大仇慕容博甘愿舍命换取复燕图谋，正惊异戒备间，骤见扫地老僧电光石火间抬掌拍落其天灵，亲睹三十载血海深仇之元凶瞬间断气暴毙，心神剧震、骇异莫名。"}}},"update":{"慕容博":{"状态":"假死龟息"}},"后续事件":{"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":"藏经阁内书架森然，慕容博方才仆地气绝，残存掌风犹自回旋，空气中杀意与死寂交织。"},"参与人物":["慕容博","扫地老僧","乔峰","慕容复"]},"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":11,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":12,"分":0},"事件引子":"藏经阁内书架森然，慕容博方才仆地气绝，残存掌风犹自回旋，空气中杀意与死寂交织。","事件详情":"眼见慕容博瞬间毙命于老僧掌下，萧峰心头大骇，误以为这神秘老僧乃是手段狠辣、滥杀无辜之徒。为了护卫父亲周全并讨还公道，萧峰怒发冲冠，丹田内力如怒涛狂涌，奋起平生全部神力，轰出一记十成威力的“降龙廿八掌”，刚猛绝伦的霸道掌力排空而出，直击扫地老僧胸口！这一记当世至刚至强的降龙掌力结结实实轰在老僧胸膛之上，掌力澎湃雄浑，打得老僧身形剧震倒退数步，肋骨当场断裂，嘴角亦溢出殷红鲜血。然而老僧借着这股狂暴的反震之势顺势反手一掌，轻柔无匹地正中萧远山顶门。萧远山根本来不及闪避，双目一闭，同样气息断绝，重重倒地气息断绝、陷入假死！老僧虽承受萧峰至强一击受创吐血，却成功顺势击杀萧远山，使得两位纠缠三十年的宿敌在瞬息之间双双气绝倒地，阁内父子死别，场面惨烈至极。","事件概要":"见慕容博暴毙，萧峰惊怒之下催动十成降龙掌力直轰老僧胸膛，震断其肋骨并迫其吐血；老僧却借反震之势顺势反拍萧远山顶门，致其立毙当场。三十年宿敌双双倒地气绝，阁中局势骤变。","insert":{"乔峰":{"人物经历":{"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":"见慕容博猝死老僧掌下，大骇之下恐生父遭难，怒发冲冠催动平生神力轰出十成降龙掌力，虽震裂老僧肋骨迫其吐血，却惊见对方借反震之势反掌击杀父亲，心胆俱裂、悲痛欲绝。"}},"扫地老僧":{"人物经历":{"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":"承受萧峰十成威力的至刚降龙掌力直击胸膛，虽肋骨断裂受创吐血，仍借其雄浑反震之力反手一掌按落萧远山顶门，当场断其气息以解宿怨。"}},"萧远山":{"人物经历":{"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":"见慕容博气绝与峰儿出掌，猝不及防间被受创借力的老僧轻柔一掌印上顶门，眼前发黑，重重仆地陷入假死。"}}},"update":{"萧远山":{"状态":"假死龟息"}},"后续事件":{"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":"藏经阁内弥漫着浓重的死寂与血腥，两位老者颓然仆地绝气，四壁书架在劲气余波中微颤。"},"参与人物":["乔峰","扫地老僧","萧远山"]},"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":12,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":13,"分":0},"事件引子":"藏经阁内弥漫着浓重的死寂与血腥，两位老者颓然仆地绝气，四壁书架在劲气余波中微颤。","事件详情":"目睹至亲双双气绝倒地，萧峰与慕容复悲痛欲绝，心中的宿怨敌意瞬间被巨大的丧父之痛吞没，两人发狂般扑向各自父亲冰冷的尸身痛哭。就在二人扑至尸身旁的刹那，原本受创吐血的扫地老僧却身形微动，双手如电探出，一手提起萧远山尸身，另一手提起慕容博尸身。老僧双臂各负一人，神态从容安详，当即施展出超凡脱俗的“缩地成寸”绝顶神通。老僧身法快如鬼魅，宛若一缕青烟般轻飘飘掠出藏经阁窗棂，其绝世轻功让天下无双的萧峰与慕容复根本无从阻拦与追及。瞬息之间，老僧已负二人身躯掠过少林寺的重重殿宇屋脊，足不点地般飘然落在了少林寺后山一片清幽宁静的开阔草地之上。老僧将两具尸身平稳安置于芳草之上，彻底摆脱了阁内的纠缠纷扰，为后续施展佛门神功创造了清幽绝佳的环境。","事件概要":"目睹至亲断气，萧峰与慕容复悲痛欲绝扑尸痛哭。受创的老僧忽现缩地成寸神通，双臂各提一具尸身破窗遁走，瞬息掠过重重殿宇飞落后山草地安置，摆脱阁内纠缠。","insert":{"乔峰":{"人物经历":{"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":"扑至气绝的生父身旁悲恸痛哭，尚未回神，忽见负伤老僧身形如电掠至，一把提起父亲尸身破窗飞遁，自己惊怒之下提气追赶却不及阻拦。"}},"慕容复":{"人物经历":{"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":"眼见父亲暴毙仆地，万念俱灰扑向尸身放声号哭，惊见重伤老僧竟以鬼魅身法携走父亲遗体掠向阁外，自身仓皇追阻却被绝世轻功甩脱。"}},"扫地老僧":{"人物经历":{"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":"趁二子扑尸痛哭之际，双手如电分别提起萧远山与慕容博身躯，施展缩地成寸身法掠出藏经阁，足踏重重屋脊飞遁至少林后山草地稳妥安置。"}}},"update":{"扫地老僧":{"所在位置":"大宋/少室山/少林寺/后山草地"},"萧远山":{"所在位置":"大宋/少室山/少林寺/后山草地"},"慕容博":{"所在位置":"大宋/少室山/少林寺/后山草地"}},"后续事件":{"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":"少林后山微风拂动幽静草木，两具假死之躯并卧草地，四下静寂无声。"},"参与人物":["乔峰","慕容复","扫地老僧"]},"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":{"事件地点":"大宋/少室山/少林寺/后山草地","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":13,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":14,"分":0},"事件引子":"少林后山微风拂动幽静草木，两具假死之躯并卧草地，四下静寂无声。","事件详情":"少林寺后山幽静草地之上，微风拂动草木，四下寂静无声。扫地老僧将萧远山与慕容博并排平放于草地之间，其先前出手击杀两人的慈悲深意终于彻底显露——唯有通过假死闭气之法，方能彻底洗髓伐毛、化解体内经络深处的宿疾。老僧神情肃穆安详，双手互按在萧远山与慕容博头顶百会穴之上，沛然运起少林无上佛门神功。醇厚纯净的佛门真气如春风化雨般源源不断灌入二人顶门，以玄妙莫测的假死龟息之法洗涤二人体内积攒了三十年的凶煞戾气与经脉剧毒。在无上佛门神功的反复冲刷与滋养下，二人受损郁结的经脉逐渐舒张平复，体内剧毒与戾气尽数消解，冰冷的体温亦渐渐回暖。片刻之后，萧远山与慕容博双双眼睫微颤，悠悠从假死状态中苏醒转来。二人只觉体内三十年的陈年顽疾尽数消融，周身经脉清爽通透，内息变得前所未有的纯正清纯。","事件概要":"扫地老僧将萧远山与慕容博并排平放于后山草地，双手互按二人顶门百会穴，沛然运起无上佛门神功。醇厚真气藉龟息假死之法洗涤冲刷二人三十年积攒的凶煞戾气与经脉剧毒。待得体内宿疾尽消、体温渐暖，萧远山与慕容博双双苏醒，周身经络通透清正，重获生机。","insert":{"扫地老僧":{"人物经历":{"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":"双手分按萧远山与慕容博顶门百会穴，沛然运转无上佛门内力，施展龟息假死之法为二人洗髓冲脉，彻底化解其体内郁积三十年的戾气宿疾与经络剧毒。"}},"萧远山":{"人物经历":{"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":"在醇厚清纯的佛门真气反复冲刷灌注下悠悠自假死中苏醒，顿觉困扰三十年的周身阴毒顽疾尽数冰消瓦解，体内经络前所未有地清爽通畅。"}},"慕容博":{"人物经历":{"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":"承接老僧自百会穴灌入的浩瀚佛门内劲，自闭气假死之态渐次回暖苏醒，惊觉纠缠多年的致命经络暗疾已彻底荡涤无存，浑身真气变得纯正澄澈。"}}},"update":{"萧远山":{"状态":"正常"},"慕容博":{"状态":"正常"}},"后续事件":{"天龙第四十二回08-双雄顿悟前非剃度皈依佛门":"后山幽谷草地清风拂面，经历生死轮回的萧远山与慕容博缓缓起立，四目相对间旧恨化解。"},"参与人物":["扫地老僧","萧远山","慕容博"]},"天龙第四十二回08-双雄顿悟前非剃度皈依佛门":{"事件地点":"大宋/少室山/少林寺/后山草地","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":14,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":15,"分":0},"事件引子":"后山幽谷草地清风拂面，经历生死轮回的萧远山与慕容博缓缓起立，四目相对间旧恨化解。","事件详情":"历经这场从生到死、又由死转生的龟息与轮回洗礼，萧远山与慕容博恍如大梦初醒，心境发生了彻底的蜕变与升华。二人缓缓自草地上站起身来，彼此四目相对，数十年来纠缠不休的家国血仇、杀妻之恨与复国狂念，在死亡边缘真正走过一遭之后，皆化作了虚妄的过眼云烟。萧远山与慕容博相视一笑，彻底消解了心中的滔天仇怨与复国魔障。大彻大悟的当世两大绝顶高手神情虔诚肃穆，双双跪倒在扫地神僧脚下，恭敬叩首恳求剃度出家、皈依三宝。老僧面带慈悲微笑欣然受礼，当场为萧远山与慕容博摩顶受戒、剃度落发，赐予法名“圆融”，正式引渡二人皈依佛门清净之地。一代神僧以通天彻地的无上神功与广大慈悲，彻底化解了两代人的滔天世仇与武林浩劫，少林古刹与天下武林自此重归祥和安宁。","事件概要":"萧远山与慕容博经历假死轮回大梦初醒，三十年来纠缠不休的家国血仇与复国执念皆化作过眼云烟。二人相视一笑泯恩仇，双双跪倒在扫地神僧座前恳求剃度。老僧欣然应允，当场为二人摩顶受戒赐号圆融，彻底化解两代深仇宿怨。","insert":{"萧远山":{"身份":{"少林僧人":"法名圆融，皈依佛门参禅修持"},"关系网":{"慕容博":"同门同修/80"},"人物经历":{"天龙第四十二回08-双雄顿悟前非剃度皈依佛门":"自假死轮回中悠然醒转，心境空明澄澈，三十年杀妻深仇与怨毒执念皆化作过眼云烟；与对面的慕容博相视一笑泯尽仇障，肃穆跪拜扫地神僧叩求剃度，受摩顶落发赐名圆融，正式皈依佛门。"}},"慕容博":{"身份":{"少林僧人":"法名圆融，皈依佛门参禅修持"},"人物经历":{"天龙第四十二回08-双雄顿悟前非剃度皈依佛门":"死生回转之间如梦初醒，顿觉数十年复国狂念与机关算尽皆是虚妄魔障；见萧远山起身释怀而笑，自身亦彻底放下宿怨，恭敬跪倒于神僧脚下乞求出家，受老僧摩顶受戒赐号圆融。"}}},"update":{"慕容博":{"关系网":{"萧远山":"同门同修/80"}}},"后续事件":{"天龙第四十三回01-群雄聚殿开审武林公案":"大雄宝殿内戒棍森列、香烟缭绕，群雄屏息凝神，静候方丈开堂宣示三十年武林隐秘。"},"参与人物":["萧远山","慕容博"]},"天龙第四十三回01-群雄聚殿开审武林公案":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":15,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":16,"分":15},"事件引子":"大雄宝殿内戒棍森列、香烟缭绕，群雄屏息凝神，静候方丈开堂宣示三十年武林隐秘。","事件详情":"藏经阁宿世恩怨暂歇，天下各派豪杰随少林僧众移步至大雄宝殿前。法堂阶下人头攒动，玄慈方丈身披袈裟、端坐正中法椅，戒律院达摩院众僧各执戒棍分列两厢，法度森严。群雄低声议论，急欲探究三十年武林隐秘。正当玄慈合十垂目、欲开堂宣谕之际，殿外忽起急促破风之声。值守武僧厉声喝阻，手中熟铜棍呼啸合围，来人却全然不顾自身安危，如疯虎般合身硬撞。只听得“砰砰”两声闷响，两名武僧受巨力反震踉跄退开，一道青黑身影跌撞冲入殿中，正是四大恶人之二的叶二娘。她披头散发，面上泪痕与血渍交错，怀中死死攥着一件残破的婴孩旧襁褓，双眼布满血丝，在殿内众僧脸上疯狂梭巡，厉声尖啸逼问当年抢走婴儿的蒙面黑衣人所在。面对突如其来的闯殿之举，玄慈拨动念珠的枯指骤然一僵，殿内群雄纷纷按剑拔刀、严阵以待。叶二娘踉跄摔扑在冰冷石阶上，怀中婴儿旧物‘长命百岁’银锁滑落，在空旷大殿中砸出刺耳脆响。少林戒律威严瞬间被撕裂，一桩尘封二十四载的佛门孽案在大殿中心正式揭开序幕。","事件概要":"群雄齐聚大雄宝殿，静候玄慈开堂宣谕以决武林公案。未料叶二娘癫狂闯殿、合身撞开值守武僧，怀抱残破襁褓厉声逼问夺子元凶，长命百岁银锁随之震落阶前。佛门戒律威严骤然被破，一桩尘封二十四载的孽案随之揭开帷幕。","insert":{"玄慈":{"人物经历":{"天龙第四十三回01-群雄聚殿开审武林公案":"端坐大雄宝殿法椅正欲开堂宣谕，忽见叶二娘披发浴血撞退武僧直冲殿内，待见其失手跌落的长命银锁与残破襁褓，拨弄念珠的枯指骤僵，心知深埋二十余年的旧孽因果终已临头。"}},"叶二娘":{"人物经历":{"天龙第四十三回01-群雄聚殿开审武林公案":"全然不顾少林武僧棍阵阻拦，拼死撞入大雄宝殿，紧抱残破襁褓在众僧面孔间狂乱梭巡，摔跌于冷硬石阶上致使贴身银锁坠地，满含血泪厉声尖啸逼问当年夺走爱子的黑衣人下落。"}}},"update":{},"后续事件":{"天龙第四十三回02-虚竹验明戒疤母子相认":"大雄宝殿内戒备森严，群雄屏息凝神，行刑僧按棍肃立两侧，殿内气氛压抑如铁。"},"参与人物":["玄慈","叶二娘"]},"天龙第四十三回02-虚竹验明戒疤母子相认":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":16,"分":15},"事件结束时间":{"年":1203,"月":6,"日":21,"时":17,"分":30},"事件引子":"大雄宝殿内戒备森严，群雄屏息凝神，行刑僧按棍肃立两侧，殿内气氛压抑如铁。","事件详情":"萧远山在藏经阁抛出的身世线索直指少林，戒律院首座当即下令当堂查验虚竹身躯以正视听。虚竹面色煞白，双手连连摆动，口中急切分辩：“小僧自幼在寺中剃度，绝非恶人之子！”然而两名行刑僧不由分说跨步上前，反剪其臂，当众褪去虚竹身上的粗布僧袍与中单。众目睽睽之下，虚竹后背及两股之间赫然显露出九处呈梅花状排列的自幼灼烙香疤，痕迹焦深。叶二娘见状浑身剧震，发出撕心裂肺的悲鸣，踉跄扑倒在虚竹脚边。她颤抖着双手抚摸那些凹凸不平的疤痕，指尖因极度激动而泛白，旋即自怀中掏出珍藏二十四年的半截染血襁褓，比对之下，襁褓破损处的焦痕与虚竹背上戒疤严丝合缝。叶二娘再无半分疑虑，一把将木雕泥塑般的虚竹死死抱入怀中，热泪滚落打湿其裸背。虚竹脑中一片空白，浑身僵直，合十的双手无力垂落，僧衣委顿在地。群雄目睹这铁证如山的骨肉相认，大殿四周顿时爆发出一片惊叹与窃窃私语，虚竹二十四年来作为少林孤儿的清白身世在此刻彻底颠覆。","事件概要":"少林戒律院当众褪去虚竹僧袍查验身躯，其背部九处梅花焦痕戒疤赫然显露。叶二娘见状悲鸣扑出，取出珍藏二十四年的残破襁褓严密比对，确认虚竹即为当年被盗亲子并相拥痛哭。群雄皆惊，虚竹二十余年的孤儿身世由此真相大白。","insert":{"叶二娘":{"关系网":{"虚竹":"亲子/100"},"人物经历":{"天龙第四十三回02-虚竹验明戒疤母子相认":"见僧人当众褪去虚竹衣衫露出背脊九处梅花戒疤，心头巨震抢步扑倒其脚下，取出珍藏多年的染血残破襁褓严丝合缝对齐焦痕，再无疑虑死死抱住亲儿放声恸哭。"}},"虚竹":{"关系网":{"叶二娘":"生母/80"},"人物经历":{"天龙第四十三回02-虚竹验明戒疤母子相认":"面对戒律院查验百般分辩自幼清白未果，被行刑僧强行反剪双臂褪去僧袍露出背股戒疤；骤见叶二娘持残襁哭扑而来抱住自身相认，满心惊骇慌乱、手足无措僵立当场。"}}},"update":{},"后续事件":{"天龙第四十三回03-玄慈当众坦承破戒生子":"大雄宝殿内群情鼎沸，各派豪杰厉声逼问虚竹生父，禅台前肃穆沉郁，风波骤起。"},"参与人物":["虚竹","叶二娘"]},"天龙第四十三回03-玄慈当众坦承破戒生子":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":17,"分":30},"事件结束时间":{"年":1203,"月":6,"日":21,"时":18,"分":45},"事件引子":"大雄宝殿内群情鼎沸，各派豪杰厉声逼问虚竹生父，禅台前肃穆沉郁，风波骤起。","事件详情":"母子相认引得大雄宝殿内群情激愤，丐帮长老与各派豪杰纷纷按捺不住，指着叶二娘厉声逼问：“这小和尚的生父究竟是哪个少林贼秃？还不快快招来！”叶二娘紧咬牙关，将虚竹护在身后，宁死不吐半字。面对满堂汹涌的质询与唾骂，端坐法台正中的玄慈方丈缓缓合上双目，面容悲悯而释然。沉寂片刻后，他口中长宣一声佛号：“阿弥陀佛！”沛然纯阳内力如暮鼓晨钟激荡开来，瞬间将大殿内嘈杂的人声强行压制。在全寺僧众惊骇的目光中，玄慈毅然起身，亲手解下象征少林至高法统的锦斓袈裟，郑重递交到身旁戒律院首座手中。随后他缓步走下台阶，面向阶下数千武林英豪深深合十稽首，朗声说道：“既造如是因，当受如是果。虚竹的生父并非旁人，正是老衲玄慈。二十四年前老衲犯下根本淫戒，贻害无穷，今日当向天下谢罪。”言罢，玄慈躬身垂首。此言如平地炸雷，殿内群雄惊得瞠目结舌，少林众僧尽皆面如死灰，一代佛门领袖当众卸下法衣自承破戒，神圣威望刹那间荡然无存。","事件概要":"大雄宝殿内群雄激愤逼问虚竹生父，叶二娘誓死护子不吐一字。玄慈长宣佛号以纯阳内力震慑喧嚣，毅然解下象征法统的锦斓袈裟，步下石阶当众坦承二十四年前犯戒生下虚竹并向天下谢罪，满殿震骇。","insert":{"叶二娘":{"人物经历":{"天龙第四十三回03-玄慈当众坦承破戒生子":"面对满堂群雄唾骂逼问生父，紧咬牙关将虚竹死死护在身后宁死不言；忽闻玄慈长宣佛号当众解下袈裟承认真相，心神俱震、悲喜交加间泪如雨下。"},"关系网":{"玄慈":"昔日情郎/90"}},"玄慈":{"人物经历":{"天龙第四十三回03-玄慈当众坦承破戒生子":"端坐法台闭目宣号以深厚内力压制喧嚣，毅然解下锦斓袈裟移交戒律院首座，步下石阶面向数千群雄合十躬身，坦承二十四年前犯下根本淫戒且虚竹实为己出，当众向天下谢罪。"},"关系网":{"虚竹":"亲子/85","叶二娘":"昔日孽缘/60"}},"虚竹":{"人物经历":{"天龙第四十三回03-玄慈当众坦承破戒生子":"僵立殿阶下被生母护在身后承受群雄叱骂，突见素来敬仰的方丈大师卸下袈裟缓步走下法台，朗声承认乃是自己生父并垂首谢罪，心神如遭五雷轰顶、惊骇万分。"}}},"update":{"玄慈":{"外貌":"年过花甲的高僧，面容庄严慈和，身材魁伟方正，颌下飘银髯，已卸下大红锦缎袈裟，身着缁色布袍。"},"虚竹":{"关系网":{"玄慈":"生父/85"}}},"后续事件":{"天龙第四十三回04-玄慈自承雁门关带头大哥":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。"},"参与人物":["叶二娘","玄慈","虚竹"]},"天龙第四十三回04-玄慈自承雁门关带头大哥":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":18,"分":45},"事件结束时间":{"年":1203,"月":6,"日":21,"时":20,"分":0},"事件引子":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。","事件详情":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。","事件概要":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。","insert":{"玄慈":{"人物经历":{"天龙第四十三回04-玄慈自承雁门关带头大哥":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。"}},"萧远山":{"人物经历":{"天龙第四十三回04-玄慈自承雁门关带头大哥":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。"}},"乔峰":{"人物经历":{"天龙第四十三回04-玄慈自承雁门关带头大哥":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。"}}},"update":{},"后续事件":{"天龙第四十三回05-玄慈肉身受杖二百重刑":"大殿内执法僧铁杖森然伫立，玄慈坦然解衣跌坐青石，满堂群雄屏息凝视。"},"参与人物":["玄慈","萧远山","乔峰"]},"天龙第四十三回05-玄慈肉身受杖二百重刑":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":20,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":21,"分":15},"事件引子":"大殿内执法僧铁杖森然伫立，玄慈坦然解衣跌坐青石，满堂群雄屏息凝视。","事件详情":"认下双重罪业后，玄慈神色决然，面向戒律院首座肃容道：“国有国法，寺有寺规。老衲破戒犯僧律、妄造杀业，请依寺规施以重刑，以正少林清规！”戒律院首座含泪宣判杖责二百。四名身形魁梧的执法僧手持数十斤重的粗大铁木刑杖大步出列。玄慈坦然褪去上衣，盘膝垂目端坐于大殿冰冷青石上，主动散去丹田内的护体纯阳真气，纯以血肉残躯受刑。刑杖挟着凌厉破空风声重重砸落，只听得沉闷的“砰！砰！”击打声响彻法堂。初时数十杖下去，玄慈脊背皮肉撕裂、紫涨充血；行至百杖，衣衫碎屑与血沫横飞，鲜血顺着脊梁汩汩流淌，将地面青石染得触目惊心。玄慈面色惨白如纸，唇角溢血，身形虽因剧痛剧烈颤抖，却咬紧牙关始终不发一声痛呼，亦不调动半丝内力御伤。叶二娘与虚竹撕心裂肺地哭喊着欲上前阻拦，却被执法僧以长棍死死架住。二百重杖实打实地行刑完毕，刑杖前端已被鲜血浸透，玄慈脊背血肉模糊、重伤濒死，以最惨烈的皮肉之苦全了佛门戒律的森严威仪。","事件概要":"玄慈主动依律请罚，散去护体真气纯以肉身硬受戒律院二百重刑。行刑铁杖击碎皮肉、血染青石，叶二娘与虚竹号哭扑救遭僧棍阻隔。玄慈咬牙受尽酷刑濒死，以残躯恪守少林戒律威仪。","insert":{"叶二娘":{"人物经历":{"天龙第四十三回05-玄慈肉身受杖二百重刑":"见玄慈褪衣散去真气甘受严刑，眼睁睁看重杖击碎其背脊皮肉、鲜血横流，撕心裂肺哭喊着欲扑上前阻拦，却被执法僧以长棍死死架隔。"}},"玄慈":{"人物经历":{"天龙第四十三回05-玄慈肉身受杖二百重刑":"为正寺规坦然散尽护体纯阳真气，盘坐石地纯以肉身承受戒律院二百刑杖，任由皮开肉绽、鲜血流淌，咬紧牙关不运内力亦不哼一声。"}},"虚竹":{"人物经历":{"天龙第四十三回05-玄慈肉身受杖二百重刑":"骤见方才认下的生父褪衣受戮，二百铁杖重砸之下血肉横飞、重伤垂危，悲恸欲绝哭号抢步上前阻拦，却被执法僧结阵棍棒严密架退。"}}},"update":{"玄慈":{"状态":"濒死"}},"后续事件":{"天龙第四十三回06-玄慈震断心脉含笑圆寂":"大雄宝殿内鸦雀无声，二百刑杖方毕，受刑台前血渍犹存，群雄屏息静默。"},"参与人物":["玄慈","叶二娘","虚竹"]},"天龙第四十三回06-玄慈震断心脉含笑圆寂":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":21,"分":15},"事件结束时间":{"年":1203,"月":6,"日":21,"时":22,"分":30},"事件引子":"大雄宝殿内鸦雀无声，二百刑杖方毕，受刑台前血渍犹存，群雄屏息静默。","事件详情":"受刑完毕，玄慈已是气若游丝，但他深知皮肉之苦仅能偿还寺规，唯有以死谢天下方能洗雪少林之耻、化解萧氏父子三十年的刻骨血仇。在大雄宝殿满堂群雄的屏息注视下，玄慈用尽残存力气强行端正坐姿，双腿盘结，面容重归平静祥和。虚竹泪流满面地扑到身前，颤抖着握住父亲冰凉的手掌；玄慈垂目凝视虚竹，眼中流露出深沉的慈爱与歉疚，随后缓缓将双手合十于胸前。他暗中调动丹田内仅存的一股精纯少林九阳真气，毫不犹豫地倒灌逆行，向着自身心脉猛然一撞！只听得其胸腔内传出一声细微的骨骼闷响，强劲内力瞬间将周身心脉尽数震断。玄慈面色骤然红润如霞，旋即转为蜡白，嘴角浮现出一抹彻底解脱与慈悲的含笑之意，头颅微低，当堂断气圆寂。少林寺内顿时钟磬齐鸣，众僧齐齐合十跪拜、诵念《往生咒》，满堂武林豪杰皆被其自断心脉以命偿罪的气魄所震慑。三十年‘带头大哥’的恩怨纠葛，随同这位少林方丈的生机断绝彻底画上休止符。","事件概要":"受刑已毕的玄慈为雪佛门之耻并消弭三十年血仇，在大雄宝殿内毅然端坐合十，暗催残存九阳真气倒灌震断自身心脉。他在虚竹泪眼注视下含笑圆寂，众僧齐跪诵念往生咒，满堂豪杰尽皆耸然动容。","insert":{"玄慈":{"人物经历":{"天龙第四十三回06-玄慈震断心脉含笑圆寂":"深知唯有以死谢罪方能洗雪少林名誉并化解萧氏血仇，于虚竹握手垂泪之际端正盘坐，调动残存少林九阳真气逆冲心脉自尽，心脉尽断之际含笑圆寂。"}},"虚竹":{"人物经历":{"天龙第四十三回06-玄慈震断心脉含笑圆寂":"见生父受刑后气若游丝，悲恸万分扑上前紧握其冰凉双手，却惊觉父亲双手合十暗催内力自断心脉，眼见生父嘴角含笑当堂断气，悲痛欲绝。"}}},"update":{"玄慈":{"状态":"死亡"},"玄寂":{"身份":{"少林寺方丈":"玄慈圆寂后继任少林寺方丈，主持寺务"}}},"后续事件":{"天龙第四十三回07-叶二娘拔刀自刎殉情而死":"大雄宝殿内玄慈气绝倒地，满堂僧俗惊呼未歇，空气中弥漫着浓重的血腥与沉寂。"},"参与人物":["玄慈","虚竹"],"delete":{"玄慈":{"身份":{"少林寺方丈":{}}},"玄寂":{"身份":{"少林寺戒律院首座":{}}}}},"天龙第四十三回07-叶二娘拔刀自刎殉情而死":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":22,"分":30},"事件结束时间":{"年":1203,"月":6,"日":21,"时":23,"分":45},"事件引子":"大雄宝殿内玄慈气绝倒地，满堂僧俗惊呼未歇，空气中弥漫着浓重的血腥与沉寂。","事件详情":"目睹玄慈震断心脉气绝倒下，叶二娘发出一声凄厉至极的啼哭，整个人疯了般扑倒在玄慈遗体之上。二十四载的相思煎熬与苦寻，未曾想骨肉重逢之日竟是与夫君永诀之时。叶二娘抚摸着玄慈尚有余温的面颊，万念俱灰，眼中疯狂之色尽褪，唯余无限温柔与死志。她转过头，泪眼婆娑地深深看了虚竹最后一眼，凄声呜咽道：“好孩子，娘苦了你二十四年，可你爹爹一个人在黄泉路上太苦，娘得去陪他！”言罢，她右手快如闪电般自腰间皮鞘中拔出一柄薄如柳叶的精钢短刀。虚竹惊骇欲绝，急呼“娘亲”并纵身伸手抓向刀背，殿旁数名少林高僧亦飞身施救。然而叶二娘死意决绝，反手横刃，内力催动下刀锋化作一道雪白匹练，狠绝地割裂自身咽喉。动脉断裂，一股猩红鲜血激喷而出，染红了玄慈胸前的灰白僧袍。精钢短刀当啷坠地，叶二娘软软倒在玄慈怀中，合目气绝。四大恶人中作恶多端的‘无恶不作’，终以血刃割喉自殉，同玄慈交叠瞑目于少林大殿之上。","事件概要":"目睹玄慈圆寂，叶二娘万念俱灰扑倒在其遗体上，抚尸痛哭。二十四载相思化作同穴死志，她在凄声别过骨肉虚竹后，断然拔出精钢短刀狠绝自刎。少林众僧与虚竹抢救未及，叶二娘割喉绝命，倒在玄慈怀中合目同殉。","insert":{"叶二娘":{"人物经历":{"天龙第四十三回07-叶二娘拔刀自刎殉情而死":"目睹玄慈散功绝命，万念俱灰下扑倒在其遗体上痛哭，深感相思二十余载终难相守，决意殉情相伴；凄声别过亲儿虚竹后，迅即拔出腰间柳叶短刀狠绝割喉，伏在玄慈怀中闭目同殉。"}},"虚竹":{"人物经历":{"天龙第四十三回07-叶二娘拔刀自刎殉情而死":"见生父刚逝、生母复悲呼拔刀欲殉，大骇之下急呼抢步抓向刀背施救，奈何慢了一瞬，眼睁睁看着母亲挥刀割裂咽喉、血溅父身倒地气绝，悲痛万分。"}}},"update":{"叶二娘":{"状态":"死亡"}},"后续事件":{"天龙第四十三回08-虚竹痛失双亲悲恸昏厥":"大雄宝殿内血腥刺鼻，玄慈与叶二娘相继绝命陈尸，满堂群雄肃然噤声，殿内死寂如铁。"},"参与人物":["叶二娘","虚竹"]},"天龙第四十三回08-虚竹痛失双亲悲恸昏厥":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":23,"分":45},"事件结束时间":{"年":1203,"月":6,"日":22,"时":1,"分":0},"事件引子":"大雄宝殿内血腥刺鼻，玄慈与叶二娘相继绝命陈尸，满堂群雄肃然噤声，殿内死寂如铁。","事件详情":"大雄宝殿之内血腥弥漫，虚竹在短短一个时辰内经历了身世大白与双亲暴毙的人间至痛。他跪倒在血泊之中，左手死死揽住玄慈冰硬的遗体，右手拼命按住叶二娘鲜血狂涌的颈间伤口，泪如雨下，状若疯魔。虚竹急运体内逍遥派深厚精纯的北冥真气，疯狂灌入父母经脉之中妄图起死回生。然而双亲心脉已碎、咽喉断绝，雄浑真气如泥牛入海毫无回音。面对两具冰冷交叠的至亲尸身，虚竹万念俱灰，仰天发出撕心裂肺的绝望哀嚎：“爹！娘！小僧才刚知道你们是谁，为何要弃我而去啊！”极度的悲恸与暴冲的内力在体内激荡反噬，虚竹气血逆行攻心，面色由惨白转为紫金，蓦地仰天喷出一大口殷红鲜血。他眼前骤然漆黑，身躯晃了晃，脱力栽倒在父母的血衣遗体之上昏死过去。段誉与灵鹫宫梅兰竹菊诸女惊呼抢上，急忙点穴护住其心脉并抬下救治。满堂群雄与少林众僧见此惨状无不扼腕叹息，三十年牵动武林风云的恩怨情仇，终在这场白发人送黑发人、骨肉同归于尽的血色残局中惨烈落幕。","事件概要":"虚竹痛失双亲悲恸狂乱，跪伏血泊中疯狂灌输北冥真气妄图救活父母，却回天乏术。万念俱灰之下他仰天绝望哀嚎，体内暴冲内力反噬攻心，当堂狂喷鲜血脱力昏厥，终由段誉抢上点穴护住心脉并抬下救治，惨烈残局至此落幕。","insert":{"虚竹":{"人物经历":{"天龙第四十三回08-虚竹痛失双亲悲恸昏厥":"跪倒在双亲冰冷遗体间泪如雨下，拼命调动体内深厚北冥真气疯狂灌入二老体内妄图起死回生；见真气石沉大海、双亲绝命不还，万念俱灰下仰天发出绝望凄号，终致气血暴冲反噬心脉，仰天喷血脱力昏厥过去。"}},"段誉":{"人物经历":{"天龙第四十三回08-虚竹痛失双亲悲恸昏厥":"忽见二哥因双亲暴毙发出撕心裂肺的绝望哀嚎，旋即狂喷鲜血脱力栽倒在血泊中昏死过去，惊骇欲绝之下抢步冲上前去，急展内力点穴护住其心脉并协助众人将其抬下救治。"}}},"update":{"虚竹":{"状态":"气血反噬昏厥"}},"后续事件":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"少林寺山门外残阳如血，群雄散尽古刹凄清，灵鹫宫九部侍女与铁骑肃立待命。"},"参与人物":["虚竹"]},"天龙第四十四回00-人物登场":{"事件类型":"登场事件","所属回目":"第四十四回","触发条件":{"类型":"时间","年":1203,"月":6,"日":24,"时":16,"分":0},"新登场人物":["余婆","符敏仪"],"insert":{"余婆":{"性别":"女","外貌":"年约五六十岁，面容端肃沉稳，鬓发微白，身着深色布袍，身形矫健沉着。","性格":"沉稳老练，御下严明，忠心耿耿","境界":"二流-中期","初始属性":{"臂力":6,"根骨":8,"机敏":7,"洞察":13,"悟性":6},"出生年份":1148,"状态":"健康","所在位置":"大宋/少室山/少林寺/山门外","身份":{"灵鹫宫昊天部首领":"统领"},"功法":{"天山折梅手":{"掌握程度":"略有小成"},"天山六阳掌":{"掌握程度":"略有小成"}},"重要物品":{},"人物经历":{},"关系网":{"虚竹":"尊主/95","符敏仪":"同僚/80"}},"符敏仪":{"性别":"女","外貌":"三十余岁年纪，容貌清秀端正，身着葱绿色长衫，腰悬长剑，指法灵巧。","性格":"精明利落，手巧心细，忠贞不二","境界":"二流-中期","初始属性":{"臂力":4,"根骨":7,"机敏":14,"洞察":9,"悟性":7},"出生年份":1170,"状态":"健康","所在位置":"大宋/少室山/少林寺/山门外","身份":{"灵鹫宫阳天部首领":"统领"},"功法":{"天山折梅手":{"掌握程度":"略有小成"}},"重要物品":{},"人物经历":{"天龙第四十四回00-人物登场":"原“针法暗器”（炉火纯青）缺乏飞针暗器对敌的原著证据。原著称符敏仪为“针神”，所示本领是缝制衣袍；因此保留为针线女红经历，不作为战斗功法，也不误归为“金匮针法”等医疗针术。"},"关系网":{"虚竹":"尊主/95","余婆":"同僚/80"}}}},"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":{"事件地点":"大宋/少室山/少林寺/山门外","触发条件":{"类型":"时间","年":1203,"月":6,"日":24,"时":16,"分":0},"事件结束时间":{"年":1203,"月":6,"日":24,"时":22,"分":0},"事件引子":"少林寺山门外残阳如血，群雄散尽古刹凄清，灵鹫宫九部侍女与铁骑肃立待命。","事件详情":"少室山少林寺外残阳如血，中原群雄散尽，古刹前一片凄清。玄慈自受杖刑圆寂、叶二娘殉情自戕，虚竹身世大白却骤失双亲，悲恸难抑，但他谨记父母临终前教其立身从善的嘱托，决意收敛心神承担起灵鹫宫尊主重任。启程前，结义大哥萧峰因自知未必能再返丐帮，专程于少室山门外将打狗棒法要诀逐招传予虚竹，并与其研讨降龙廿八掌的运劲变化，删并繁复而威力重复的末十式，凝成日后传世的降龙十八掌，嘱虚竹代授继任帮主。虚竹以逍遥派修为和悟性将两门武学学得纯熟，郑重接下托付；萧峰则保留这套精炼后的十八掌自身所学。虚竹强忍泪水向少林山门三叩首，转身步至山下阵前。九天九部侍女及附属部众黑压压肃立待命，余婆与符敏仪率众躬身抱拳：“请尊主示下！”段誉见虚竹面带戚容，快步上前扶住其臂膀温言道：“二哥莫忧，小弟愿率大理随从伴兄西行。”虚竹心中感念，合十还礼。面对前路茫茫，虚竹毅然斩断徘徊，接过符敏仪双手呈上的七宝灵鹫令符与随身佩剑，翻身上马下达拔营号令。灵鹫宫九部众刀剑归鞘、严整结阵护卫两侧，段誉引大理铁骑随行相顾，车马辎重齐备，浩浩荡荡踏上远离中原、迢迢西赴天山缥缈峰之路，确立了虚竹统领缥缈峰的全新格局。","事件概要":"临别前萧峰将打狗棒法传予虚竹，二人将降龙廿八掌去繁成十八掌，托虚竹代传丐帮；双亲骤逝后虚竹谨遵父母遗言，收敛悲恸决意担负尊主重任。他向少林寺山门三叩首辞别祖庭，于阵前接过灵鹫令符与佩剑，在三弟段誉引大理铁骑相伴随行下，下令拔营率部众浩浩荡荡西赴天山。","insert":{"虚竹":{"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"临别前受萧峰传授打狗棒法，二人共研廿八掌删繁为十八掌，受其托付代传丐帮；强忍丧亲剧痛谨记父母从善遗言，面向少林山门含泪三叩首拜别祖庭；步至山前接过符敏仪呈递的灵鹫令符与佩剑，感激三弟段誉护送之谊，翻身上马下令拔营启程西赴天山。"},"重要物品":{"七宝灵鹫令符":"符敏仪所呈递的灵鹫宫九天九部尊主令符"},"功法":{"降龙十八掌":{"掌握程度":"融会贯通（少室山临别时与萧峰共研降龙廿八掌，删并末十式后学得传承）"},"打狗棒法":{"掌握程度":"融会贯通（临别时萧峰亲授，受托将来代传丐帮继任帮主）"}}},"段誉":{"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"见二哥神情戚容悲戚难抑，快步上前扶住其臂膀温言抚慰，主动引大理随行铁骑随军护持，与灵鹫宫部众结阵并肩踏上西行之途。"}},"余婆":{"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"率昊天部及各部属众在少室山门前整肃列阵，恭迎尊主出山抱拳请示，待号令一下即指挥部众收刀归鞘、结阵护卫启程西进。"}},"符敏仪":{"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"随余婆肃立阵前护驾，待尊主虚竹步至阵前，双手恭敬呈上七宝灵鹫令符与佩剑，随后整饬部属随行护驾踏上西赴缥缈峰之路。"}},"乔峰":{"功法":{"降龙十八掌":{"掌握程度":"出神入化（与虚竹共同精简降龙廿八掌，形成十八掌传世版本）"}},"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"少室山惜别前亲授虚竹打狗棒法，并与二弟删繁为降龙十八掌，嘱其日后代传丐帮新主；从此将毕生所学降龙廿八掌归整为传世十八掌。"}}},"update":{"虚竹":{"状态":"悲痛隐忍"}},"后续事件":{"天龙第四十四回02-阿紫换眼复明嫌丑弃游坦之":"僻静草堂内弥漫着浓烈血腥与刺鼻药香，染血白纱散落狼藉，案头锋刃银针泛着森森寒芒。"},"参与人物":["虚竹","段誉","余婆","符敏仪","乔峰"],"delete":{"乔峰":{"功法":{"降龙廿八掌":{}}}}},"天龙第四十四回02-阿紫换眼复明嫌丑弃游坦之":{"事件地点":"大宋/少室山/荒山草堂","触发条件":{"类型":"时间","年":1203,"月":6,"日":25,"时":8,"分":0},"事件结束时间":{"年":1203,"月":6,"日":25,"时":14,"分":0},"事件引子":"僻静草堂内弥漫着浓烈血腥与刺鼻药香，染血白纱散落狼藉，案头锋刃银针泛着森森寒芒。","事件详情":"僻静荒山草堂之中，药香混杂着浓烈血腥。阎王敌薛神医施展移目接脉秘术，替失明的阿紫缝合完毕。游坦之双腿早被震断，此番自愿忍受生挖眼珠的钻心之痛献出双目，瘫在榻下血水里虚弱喘息。随着薛神医剪开重重白纱，阿紫眼界骤然大放光明，她抚摸双眼欣喜若狂地娇笑跳起。游坦之听闻笑语，凭借残存双臂在碎石泥泞中艰难爬向阿紫，带血的手指试图触碰其裙角，颤声乞怜：“阿紫姑娘……你看见了吗？这是我的眼睛……”阿紫垂首看清眼前之人：游坦之面容被铁面毁损狰狞如鬼，眼眶只剩两个乌黑淌血的空洞，双腿瘫软如泥。阿紫毫无半分怜惜与感激，反觉恶寒彻骨，尖叫着运足内力飞起一脚狠狠踹在游坦之胸口，厉斥：“滚开！哪来的丑怪怪物，莫弄脏了本姑娘的衣裳！”游坦之重创之下肋骨断裂、狂喷鲜血倒飞数尺。薛神医递上的止血药膏被阿紫扬手打翻，阿紫整肃衣衫绝情拂袖而去，将双目尽盲、瘫痪残喘且身负内伤的游坦之弃于荒山冰冷泥泞中。","事件概要":"薛神医施移目接脉秘术，将游坦之双眼缝予阿紫。阿紫解开眼纱重见光明，正狂喜娇笑间，见双目剜空、面容毁损如鬼且双腿残疾的游坦之爬来攀扯相认。阿紫心生恶寒嫌弃，运足内力飞起一脚踢断其肋骨，绝情拂袖而去，将重创残喘的游坦之弃于荒山泥泞血泊中。","insert":{"阿紫":{"人物经历":{"天龙第四十四回02-阿紫换眼复明嫌丑弃游坦之":"在荒山草堂内承接移目接脉秘术，剪去层层白纱后双目骤然大放光明，重见天日喜不自胜；垂首见一双眼流血空洞、容颜如恶鬼且双腿瘫软的丑怪爬来触碰裙角相认，只觉恶寒彻骨，愤而运足内力一脚将其踹断肋骨吐血震飞，拂袖绝情离去。"}},"游坦之":{"人物经历":{"天龙第四十四回02-阿紫换眼复明嫌丑弃游坦之":"自愿忍受生挖眼珠之奇痛将双目献予阿紫，双腿早折瘫卧在榻下血水残喘；听闻阿紫复明笑语，拼尽残力在泥泞碎石中爬向对方试图触碰裙角表白，未料反被其厌恶斥为丑怪，更遭其凌厉一脚踢断胸口肋骨喷血倒飞，惨遭彻底抛弃于荒山寒泞。"}}},"update":{"阿紫":{"外貌":"约十五六岁年纪，身穿紫色衣衫，身形娇小，一张瓜子脸，双眸清亮复明且灵动有神","状态":"正常","关系网":{"游坦之":"嫌恶抛弃/-20"}},"游坦之":{"外貌":"身形消瘦单薄，面容受铁具毁损狰狞如鬼，眼眶化为两个乌黑淌血空洞，浑身血污泥泞","状态":"濒死（双目失明、双腿骨折、肋骨断裂）"}},"后续事件":{"天龙第四十四回03-游坦之万念俱灰跳崖自尽":"荒山绝顶狂风厉啸，刺骨寒雨倾泻，断崖边泥泞血迹蜿蜒伸向万丈迷雾。"},"参与人物":["阿紫","游坦之"]},"天龙第四十四回03-游坦之万念俱灰跳崖自尽":{"事件地点":"大宋/少室山/少室绝顶","触发条件":{"类型":"时间","年":1203,"月":6,"日":25,"时":14,"分":0},"事件结束时间":{"年":1203,"月":6,"日":25,"时":15,"分":0},"事件引子":"荒山绝顶狂风厉啸，刺骨寒雨倾泻，断崖边泥泞血迹蜿蜒伸向万丈迷雾。","事件详情":"荒山绝顶狂风厉啸，刺骨寒雨漫天倾泻。游坦之双目已剜、双腿尽断且胸骨碎裂，瘫卧在血泥碎石中。他为阿紫倾尽毕生骨血与光明，换来的却只有嫌恶辱骂与绝情弃置，心中最后一丝苟活执念轰然崩塌，万念俱灰只求一死。在无边黑暗与剧痛中，游坦之不再哀嚎，而是咬碎牙关，凭借残存双臂将十指如鹰爪般狠狠抠入坚硬岩缝，拖着毫无知觉的残废下肢向悬崖边缘艰难爬行。嶙峋怪石划破其胸腹，指甲尽数崩裂翻卷，在荒崖泥径上拖曳出一条十余丈长的触目惊心血痕。风声愈发凄厉，游坦之血肉模糊的右手掌心终于探出岩台、抓入一片虚无。感知到下方深不可测的万丈渊薮，游坦之惨然凄笑，经脉中残存的冰蚕寒气最后一次激荡，双臂运足残劲向崖边猛力一推，残躯决绝腾空翻滚，径直坠入深渊白雾之中。崖风呼啸吞没一切，游坦之粉身碎骨殒命崖底，唯余岩边数道带血抓痕与几片撕裂的破烂衣布在寒风中摇曳。","事件概要":"游坦之双目尽盲且残躯碎裂，惨遭阿紫绝情弃置后万念俱灰。他在黑暗与剧痛中咬牙以十指抠石，拖着残废躯体在荒岩间爬行十余丈；探至断崖边缘，游坦之惨然凄笑，运尽残存冰蚕寒劲决绝跃入万丈深渊，粉身碎骨殒命崖底。","insert":{"游坦之":{"人物经历":{"天龙第四十四回03-游坦之万念俱灰跳崖自尽":"遭阿紫嫌恶弃置后万念俱灰，再无苟活之念；在无边剧痛与黑暗中以十指抠入坚岩硬石，拖着残废下肢在泥泞中爬向崖边，终在万丈深渊前惨然凄笑，运尽残存冰蚕寒劲腾身翻入白雾深渊，粉身碎骨自尽殒命。"}}},"update":{"游坦之":{"状态":"死亡"}},"后续事件":{"天龙第四十四回05-萧峰恩怨平息决意返大辽":"离开少林后的山道岔路前，三兄弟暂勒马缰，各有归途。"},"参与人物":["游坦之"],"delete":{"游坦之":{"身份":{"丐帮帮主":{}},"重要物品":{"打狗棒":{}}}}},"天龙第四十四回05-萧峰恩怨平息决意返大辽":{"事件地点":"大宋/少室山/少林寺/山道岔路","触发条件":{"类型":"时间","年":1203,"月":6,"日":25,"时":17,"分":0},"事件结束时间":{"年":1203,"月":6,"日":25,"时":18,"分":0},"事件引子":"离开少林后的山道岔路前，三兄弟暂勒马缰，各有归途。","事件详情":"离开少林后，萧峰与虚竹、段誉同行至山道岔路。萧峰念及辽国旧职与结义兄长，决定先返辽探知边境局势；虚竹与段誉则继续西行。三兄弟相约有事互通消息，在岔路作别后各自启程。","事件概要":"三兄弟离开少林后行至山道岔路，萧峰与继续西行的虚竹、段誉作别，约定互通消息，独自北上返辽。","insert":{"乔峰":{"人物经历":{"天龙第四十四回05-萧峰恩怨平息决意返大辽":"在离开少林后的山道岔路与两位义弟作别，约定互通消息，独自北上返辽探知局势。"}},"虚竹":{"人物经历":{"天龙第四十四回05-萧峰恩怨平息决意返大辽":"在山道岔路与返辽的萧峰作别，约定互通消息，随后与段誉继续西行。"}},"段誉":{"人物经历":{"天龙第四十四回05-萧峰恩怨平息决意返大辽":"在山道岔路与返辽的萧峰作别，约定互通消息，随后与虚竹继续西行。"}}},"update":{},"后续事件":{"天龙第三十六回01-虚竹参悟石壁绝学夜思梦姑":"密室深处幽火摇曳，冰冷石壁上满刻玄奥图谱，隐隐透出逍遥派绝顶武学的沉雄气韵。"},"参与人物":["乔峰","虚竹","段誉"]},"天龙第三十六回00-人物登场":{"事件类型":"登场事件","所属回目":"第三十六回","触发条件":{"类型":"时间","年":1203,"月":7,"日":1,"时":8,"分":0},"新登场人物":["梅剑","兰剑","竹剑","菊剑"],"insert":{"梅剑":{"性别":"女","外貌":"十七八岁年纪，容貌娇美清秀，身着浅绿绸衫，腰悬长剑，与三姐妹形貌宛然一体","性格":"天真烂漫，忠心护主，机敏伶俐","境界":"二流-中期","初始属性":{"臂力":6,"根骨":9,"机敏":14,"洞察":7,"悟性":9},"出生年份":1185,"状态":"健康","所在位置":"西域/天山/灵鹫宫/总坛","身份":{"天山灵鹫宫尊主侍女":"侍女"},"功法":{"天山剑法":{"掌握程度":"略有小成"}},"重要物品":{"佩剑":"防身兵刃"},"人物经历":{},"关系网":{"虚竹":"主仆/90","兰剑":"姐妹/95","竹剑":"姐妹/95","菊剑":"姐妹/95"}},"兰剑":{"性别":"女","外貌":"十七八岁年纪，容貌娇美秀丽，身穿淡青绸衫，腰悬长剑，与三姐妹体态面貌无异","性格":"活泼灵动，忠谨护主，娇憨爽直","境界":"二流-中期","初始属性":{"臂力":6,"根骨":8,"机敏":14,"洞察":8,"悟性":9},"出生年份":1185,"状态":"健康","所在位置":"西域/天山/灵鹫宫/总坛","身份":{"天山灵鹫宫尊主侍女":"侍女"},"功法":{"天山剑法":{"掌握程度":"略有小成"}},"重要物品":{"佩剑":"防身兵刃"},"人物经历":{},"关系网":{"虚竹":"主仆/90","梅剑":"姐妹/95","竹剑":"姐妹/95","菊剑":"姐妹/95"}},"竹剑":{"性别":"女","外貌":"十七八岁年纪，容颜俏丽端庄，身着素色长衫，腰悬长剑，同胞四姐妹神情极似","性格":"心性质朴，忠贞护主，聪慧灵动","境界":"二流-中期","初始属性":{"臂力":7,"根骨":8,"机敏":14,"洞察":7,"悟性":9},"出生年份":1185,"状态":"健康","所在位置":"西域/天山/灵鹫宫/总坛","身份":{"天山灵鹫宫尊主侍女":"侍女"},"功法":{"天山剑法":{"掌握程度":"略有小成"}},"重要物品":{"佩剑":"防身兵刃"},"人物经历":{},"关系网":{"虚竹":"主仆/90","梅剑":"姐妹/95","兰剑":"姐妹/95","菊剑":"姐妹/95"}},"菊剑":{"性别":"女","外貌":"十七八岁年纪，生得娇小秀雅，身穿淡黄绸衫，腰配长剑，言行举止与三姊极似","性格":"天真无邪，忠谨随和，纯真率直","境界":"二流-中期","初始属性":{"臂力":6,"根骨":9,"机敏":14,"洞察":6,"悟性":10},"出生年份":1185,"状态":"健康","所在位置":"西域/天山/灵鹫宫/总坛","身份":{"天山灵鹫宫尊主侍女":"侍女"},"功法":{"天山剑法":{"掌握程度":"略有小成"}},"重要物品":{"佩剑":"防身兵刃"},"人物经历":{},"关系网":{"虚竹":"主仆/90","梅剑":"姐妹/95","兰剑":"姐妹/95","竹剑":"姐妹/95"}}}},"天龙第三十六回01-虚竹参悟石壁绝学夜思梦姑":{"事件地点":"西域/天山/缥缈峰","触发条件":{"类型":"时间","年":1203,"月":7,"日":1,"时":8,"分":0},"事件结束时间":{"年":1203,"月":7,"日":11,"时":8,"分":0},"事件引子":"密室深处幽火摇曳，冰冷石壁上满刻玄奥图谱，隐隐透出逍遥派绝顶武学的沉雄气韵。","事件详情":"虚竹接掌天山灵鹫宫尊主之位后，身处缥缈峰这片武学圣地。为了不负重托并守护灵鹫宫基业，虚竹步入隐秘幽深的密室石壁之前。但见石壁之上刻满了逍遥派历代祖师流传下来的绝顶武学图谱秘笈，招式精妙玄奥，内功心法深邃莫测。虚竹屏气凝神，率领灵鹫宫九天九部的诸位首领与部众，日夜潜心揣摩、依法运功研习。在石壁图谱的印证下，虚竹体内的逍遥派深厚真气流转自如，周身经脉无不通畅，举手投足间武功更臻化境。然而，每当夜幕低垂、万籁俱寂之时，虚竹独自端坐于幽静的寝殿之中，脑海中却无时无刻不浮现出西夏冰洞内的旖旎光景。那位曾与自己肌肤相亲、共度春宵且柔情万种的“梦姑”，令他魂牵梦萦。即便此刻身为万众俯首、威名赫赫的灵鹫宫尊主，虚竹亦难掩心中的刻骨相思与落寞，陷入了修行精进与情思难断的内心煎熬之中。","事件概要":"虚竹率九天九部众女深入灵鹫宫密室，潜心参悟石壁所刻逍遥派绝顶图谱，依律运功使内力贯通融会，武学更臻化境。然而夜阑人静独归寝殿之时，西夏冰窖中与梦姑的温存旧事仍挥之不去，令他在神功精进与深种情根间备受相思煎熬。","insert":{"虚竹":{"人物经历":{"天龙第三十六回01-虚竹参悟石壁绝学夜思梦姑":"率领九天九部众女潜入密室面壁揣摩石刻图谱，运功调息使体内三家内力融会贯通；夜深独自返回寝殿后，冰窖中与梦姑缱绻温存的旧梦却挥之不去，辗转反侧备受相思折磨。"}}},"update":{"虚竹":{"所在位置":"西域/天山/灵鹫宫/寝殿"}},"后续事件":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"天山缥缈峰上朔风呼啸，灵鹫宫总坛石阶前快马急报突至，打破了雪域连日来的宁静。"},"参与人物":["虚竹"]},"天龙第三十六回02-西夏放榜招婿引动天下豪杰":{"事件地点":"西域/天山/灵鹫宫/总坛","触发条件":{"类型":"时间","年":1203,"月":7,"日":11,"时":8,"分":0},"事件结束时间":{"年":1203,"月":7,"日":13,"时":8,"分":0},"事件引子":"天山缥缈峰上朔风呼啸，灵鹫宫总坛石阶前快马急报突至，打破了雪域连日来的宁静。","事件详情":"灵鹫宫总坛的宁静被一份自天山传来的加急文书所打破。西夏国皇妃李秋水之孙女、银川公主李清露正式昭告天下，颁布皇室榜文，面向全天下广招青年才俊与王孙公子前往西夏皇宫应聘选婿。这一消息如同平地惊雷，以极快的速度传遍大江南北，令整个中原与边陲江湖为之震动。各国青年俊彦与各路江湖势力纷纷蠢蠢欲动，大理国镇南王世子段誉、心怀复国大计的姑苏慕容复、西域吐蕃国王子宗赞，以及天下间无数自命不凡的英雄豪杰，皆各自怀揣着截然不同的目的与野心，整顿行装启程西赴西夏。他们或是为了求娶倾国倾城的绝色佳人，或是贪图西夏皇室的至高权柄与联姻助力，天下各方风云随之迅速汇聚于西夏皇城。皇榜的传阅不仅在大江南北掀起了滔天波澜，更彻底点燃了中原与外邦青年才俊之间的角逐战火，形成了一场天下英豪竞相西进的浩大声势。","事件概要":"西夏银川公主正式颁布皇室榜文广招天下才俊为婿，消息如平地惊雷传遍大江南北。灵鹫宫接获飞书急报，天下各路势力亦闻风而动。段誉为顾念王语嫣痴心、慕容复为图谋复国权柄，各怀异心的豪杰纷纷整装西行，西夏皇城顿成天下风云交汇之所。","insert":{"虚竹":{"人物经历":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"在灵鹫宫总坛拆阅自西夏传来的飞书榜文，得知李秋水之孙女银川公主昭告天下选婿，心头骤然忆起冰窖中与梦姑的刻骨缠绵，又虑及西夏联姻恐牵动天下局势，当即下定决心西行赴会。"}},"慕容复":{"人物经历":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"得悉西夏皇室放榜为银川公主选婿，深觉此乃借助西夏雄厚国力与精锐甲兵以图光复大燕的天赐良机，当即决意暂搁私情，携四大家臣收拾行装奔赴西夏竞夺驸马之位。"}},"段誉":{"人物经历":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"闻听西夏放榜招婿而慕容复决意前往应聘，见王姑娘为此伤心欲绝、愁容满面，唯恐慕容复另娶她人会令王姑娘心碎轻生，遂打点行装随众前往西夏，暗自立誓护卫王姑娘周全。"}},"李清露":{"人物经历":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"因苦寻黑暗冰窖中倾心相许的温热情郎无果，遂奏请皇室颁下榜文面向天下招选驸马，意图广聚各国青年才俊入宫应试，借机寻出刻骨铭心的梦郎重续前缘。"}}},"update":{},"后续事件":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"缥缈峰巅云雾缭绕，总坛殿内传书飞至，西夏银川公主选婿的榜文打破了灵鹫宫的宁静。"},"参与人物":["虚竹","李清露","慕容复","段誉"]},"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":{"事件地点":"西域/天山/灵鹫宫/总坛","触发条件":{"类型":"时间","年":1203,"月":7,"日":13,"时":8,"分":0},"事件结束时间":{"年":1203,"月":7,"日":21,"时":8,"分":0},"事件引子":"缥缈峰巅云雾缭绕，总坛殿内传书飞至，西夏银川公主选婿的榜文打破了灵鹫宫的宁静。","事件详情":"在缥缈峰灵鹫宫中，虚竹获悉了西夏国银川公主选婿的传书消息后，心绪翻江倒海，久久不能平静。他细细推想，西夏冰洞与西夏皇室有着千丝万缕的联系，自己苦苦寻觅、朝思暮想的“梦姑”，极有可能正深居于西夏皇宫大内之中。为了求证心中的执念并寻回挚爱，一向清心寡欲的虚竹毅然决定离开缥缈峰，亲赴西夏国都兴庆府一探究竟。灵鹫宫属下对尊主的安全极为挂念，俏丽忠诚的梅剑、兰剑、竹剑、菊剑四位近身侍女领命随行，贴身护卫左右。虚竹身着尊主锦袍，在四剑侍女的紧密簇拥与严密护持下步下天山。一行人快马加鞭，踏上了漫长而险峻的西行驿道。虚竹一路之上虽有四剑悉心照料饮食起居，但心中唯有对冰洞旧事的追忆与对相见的期盼。此次启程，不仅标志着灵鹫宫之主正式介入西夏局势，也让虚竹彻底踏入了一场关乎情缘与宿命的波澜征途。","事件概要":"虚竹获悉西夏招婿传书，推想朝思暮想的“梦姑”极可能身在西夏皇宫，遂决意西行寻觅挚爱。梅兰竹菊四剑挂念尊主安危，领命贴身护卫。虚竹换上锦袍，在四剑簇拥下步下缥缈峰，策马踏上奔赴西夏的征途。","insert":{"虚竹":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"见西夏选婿传书后推想梦姑定与西夏皇室大有关联，难耐相思执念遂决意亲赴兴庆府寻访；身着尊主锦袍，在梅兰竹菊四剑侍女的贴身护持下步下缥缈峰，策马踏上西行漫漫长路。"}},"梅剑":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"见尊主获悉西夏传书后心绪不宁并执意远赴西夏，唯恐其沿途有所闪失，遂与三位姐妹领命随行护驾，佩剑策马紧紧簇拥在尊主身侧步下天山。"}},"兰剑":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"得知尊主欲远赴西夏国都，心忧尊主安危，当即与三姐妹一同领命贴身护卫，整备行装鞍马，随侍尊主离开灵鹫宫总坛踏上西行驿道。"}},"竹剑":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"见尊主下定决心前往西夏，深感护卫之责重大，与梅、兰、菊三姐妹一同躬身领命相随，严密护卫在尊主周遭步下缥缈峰险径。"}},"菊剑":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"见尊主决意前往西夏，与三位姊姊齐声领命贴身随侍，细心照应起居鞍马，寸步不离左右护持尊主启程西去。"}}},"update":{},"后续事件":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"官道两旁枯杨疏朗，风卷黄沙漫卷荒原，远处数骑快马踏尘而来，得得蹄声清晰可闻。"},"参与人物":["虚竹","梅剑","兰剑","竹剑","菊剑"]},"天龙第三十六回04-虚竹中途重逢段誉结伴同行":{"事件地点":"西夏/凉州/凉州荒漠/官道","触发条件":{"类型":"时间","年":1203,"月":7,"日":21,"时":8,"分":0},"事件结束时间":{"年":1203,"月":7,"日":21,"时":12,"分":0},"事件引子":"官道两旁枯杨疏朗，风卷黄沙漫卷荒原，远处数骑快马踏尘而来，得得蹄声清晰可闻。","事件详情":"虚竹此前与段誉自少林同行西赴天山，处理灵鹫宫事务后又与他及王语嫣、阿碧结伴往西夏。途中兄弟谈及近日际遇，虚竹感谢段誉相伴；众人并辔前往兴庆府。","事件概要":"少室山别后，虚竹与段誉同行处理天山事务，随后与王语嫣、阿碧结伴赴西夏。","insert":{"虚竹":{"人物经历":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"与三弟一路同行，料理灵鹫宫事务后结伴赴西夏。"}},"段誉":{"人物经历":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"陪二哥前往天山，又与众人结伴赴西夏。"}},"王语嫣":{"人物经历":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"随段誉等人同行前往西夏，心中仍挂念表哥。"}},"阿碧":{"人物经历":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"随众人西行，温言相伴。"}}},"update":{},"后续事件":{"天龙第三十六回05-慕容复谋求复国决意弃表妹":"荒原官道上黄沙漫漫，西行队伍缓缓前行，车马旁三人各怀心事，暗流涌动。"},"参与人物":["虚竹","段誉","王语嫣","阿碧"]},"天龙第三十六回05-慕容复谋求复国决意弃表妹":{"事件地点":"西夏/凉州/凉州荒漠/官道","触发条件":{"类型":"时间","年":1203,"月":7,"日":21,"时":12,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":12,"分":0},"事件引子":"荒原官道上黄沙漫漫，西行队伍缓缓前行，车马旁三人各怀心事，暗流涌动。","事件详情":"在西行队伍缓缓前行的漫长路途上，众人之间暗流涌动。段誉对王语嫣一往情深，一路上嘘寒问暖、体贴入微，时刻竭尽所能关怀照料王语嫣的饮食起居，然而王语嫣心中眼中唯有自己朝思暮想的表哥慕容复，对段誉的真挚深情视若无睹、漠不关心。与此同时，姑苏慕容复内心却被巨大的野心与焦虑所吞噬。他一心汲汲于光复大燕帝业，深知单凭姑苏慕容氏残存的江湖势力根本无法与中原王朝抗衡，唯有夺得西夏驸马的大位，才能借助西夏一国的倾国精锐军力作为争夺天下的资本。在冷酷的帝王大业权衡之下，慕容复认为表妹王语嫣的儿女私情已然成为自己求娶西夏公主的最大障碍与累赘。经过激烈的权谋算计，慕容复彻底泯灭了青梅竹马的昔日情义，暗中决意斩断情丝，不惜彻底抛弃王语嫣，以此扫清自己争夺西夏乘龙快婿之位的一切羁绊。","事件概要":"西行途中段誉对王语嫣体贴备至，王语嫣却满心只有表哥。慕容复为借西夏重兵光复大燕，深感儿女私情已成争夺驸马的绊脚石，权衡之下泯灭青梅竹马情义，暗中决意彻底抛弃王语嫣。","insert":{"段誉":{"人物经历":{"天龙第三十六回05-慕容复谋求复国决意弃表妹":"随西行队伍前行，一路上对王姑娘嘘寒问暖、体贴照料，见其对自己视若无睹、唯独痴恋表哥，心中虽泛起酸楚，仍甘愿一路相随护其周全。"}},"王语嫣":{"人物经历":{"天龙第三十六回05-慕容复谋求复国决意弃表妹":"行于西夏荒原官道上，虽见段誉沿途殷勤体贴，但满心只系挂表哥争选驸马之事，对段誉的照料冷淡相对，唯盼表哥能顾念昔日情义。"}},"慕容复":{"人物经历":{"天龙第三十六回05-慕容复谋求复国决意弃表妹":"深知仅凭姑苏残存势力绝难复兴大燕，唯有夺得西夏驸马方能借助倾国重兵，冷酷权衡下终将表妹私情视为争夺大位的羁绊，暗自决意斩断情丝将其彻底舍弃。"}}},"update":{"慕容复":{"关系网":{"王语嫣":"视为累赘/30"}}},"后续事件":{"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":"斜阳残照荒郊逆旅，风卷黄沙掠过空地，四下萧索寂静，杀机暗伏。"},"参与人物":["段誉","王语嫣","慕容复"]},"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":{"事件地点":"西夏/凉州/荒漠客栈/门外空地","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":18,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":19,"分":0},"事件引子":"斜阳残照荒郊逆旅，风卷黄沙掠过空地，四下萧索寂静，杀机暗伏。","事件详情":"在荒野客栈外的空地上，慕容复为了彻底断绝王语嫣的念想，当众对王语嫣横加斥责、恶语相向，言辞极其冰冷刻薄，将多年兄妹情分践踏殆尽。王语嫣闻听表哥如此绝情言论，如遭晴天霹雳，顿时心碎神伤、悲痛欲绝，泪流满面地瘫软在侧。段誉见心仪之人受此奇耻大辱与无情折磨，胸中义愤填膺，按捺不住怒火挺身而出，厉声斥责慕容复寡情薄义、枉为君子。慕容复本就因复国大计屡屡受挫而心胸狭隘，见段誉横加干涉并戳中痛处，眼中杀机骤起。趁段誉全神贯注关切王语嫣、毫无防备之际，慕容复骤施辣手，暗中运起狠辣掌力对其暴起突袭。段誉措手不及之下胸口中掌，登时被击得气血翻涌、负伤倒退。这场言语与武力的剧烈冲突，令慕容复与段誉、王语嫣之间的关系彻底决裂，也让事态滑向了更为凶险失控的深渊。","事件概要":"慕容复为断绝痴念当众以刻薄恶语斥责王语嫣，致其心碎瘫软；段誉义愤填膺挺身怒斥其薄幸，反遭慕容复趁隙运狠辣掌力暴起暗算击伤胸口，三人彻底决裂。","insert":{"慕容复":{"人物经历":{"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":"为绝王语嫣痴念当众厉声喝斥、斩断旧情，见段誉挺身斥责戳中痛处，杀机骤起，趁其不备暴施狠辣掌力重击其胸口。"}},"王语嫣":{"人物经历":{"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":"闻听表哥当众严词斥责、将多年兄妹情分践踏殆尽，如遭晴天霹雳，万念俱灰下心碎神伤、瘫软倒地泪流不止。"}},"段誉":{"人物经历":{"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":"目睹王姑娘受尽屈辱折磨，义愤填膺挺身斥责慕容复寡情薄义，分神关切王姑娘之际骤遭慕容复暗施毒手击中胸口，气血翻涌负伤退避。"}}},"update":{"段誉":{"状态":"胸部中掌、气血翻涌"},"王语嫣":{"状态":"心碎神伤、周身酸软","关系网":{"慕容复":"绝望心碎/25"}},"慕容复":{"关系网":{"王语嫣":"绝情弃绝/10","段誉":"心存杀意/10"}}},"后续事件":{"天龙第三十六回07-慕容复趁夜推王语嫣坠枯井":"夜色笼罩死寂荒野，残月如钩，一口干涸幽深的废弃枯井森然矗立在乱石枯草之间。"},"参与人物":["慕容复","王语嫣","段誉"]},"天龙第三十六回07-慕容复趁夜推王语嫣坠枯井":{"事件地点":"西夏/凉州/凉州荒漠/枯井旁","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":19,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":20,"分":0},"事件引子":"夜色笼罩死寂荒野，残月如钩，一口干涸幽深的废弃枯井森然矗立在乱石枯草之间。","事件详情":"夜幕笼罩荒野，四野一片死寂。遭受表哥绝情痛斥与抛弃的王语嫣万念俱灰，失魂落魄地游荡在荒野深处，神情恍惚已无生念。慕容复在暗中紧随其后，眼见王语嫣痴情纠缠不休，生怕她尾随至西夏皇宫破坏自己应聘驸马的大局。为绝后患并彻底抹去这一羁绊，慕容复眼中掠过一丝狠厉与决绝，悄然潜行至荒野中一座废弃已久的深邃干枯枯井旁。趁王语嫣毫无防备、神志恍惚之际，慕容复狠心运力猛然出手，将王语嫣一把推入了漆黑不见底的枯井深渊之中。王语嫣只觉身躯骤然悬空下坠，凄厉惊恐的惨呼声划破了寂静的黑夜，回荡在空旷荒野之上。慕容复伫立井口，眼见表妹坠入黑暗深处，心中毫无悔意，只觉复国路上的重大障碍已被彻底清除。这一冷酷狠毒的举动不仅将王语嫣推向了生死未卜的绝境，更在荒原上掀起了一场致命危机。","事件概要":"遭受抛弃的王语嫣万念俱灰、游荡荒野。慕容复深恐其纠缠破坏争选西夏驸马的大计，尾随至废井旁，趁其恍惚无备狠施掌力将表妹推入万丈深渊，绝情灭口以图复燕霸业。","insert":{"王语嫣":{"人物经历":{"天龙第三十六回07-慕容复趁夜推王语嫣坠枯井":"万念俱灰下游荡至荒野深处，神思恍惚间忽遭表哥运力狠推，猝不及防下跌入漆黑不见底的深邃枯井，凄声哀呼直坠幽暗绝境。"}},"慕容复":{"人物经历":{"天龙第三十六回07-慕容复趁夜推王语嫣坠枯井":"为绝后患以免表妹痴缠破坏竞选西夏驸马大计，暗中尾随至荒野枯井旁，趁其失魂落魄之际骤施毒手推入井底，自忖复国障碍已除。"}}},"update":{"王语嫣":{"状态":"坠落井底、生死未卜","关系网":{"慕容复":"心死绝望/0"}},"慕容复":{"关系网":{"王语嫣":"痛下杀手/0"}}},"后续事件":{"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":"荒原深夜死寂无声，枯井深处骤然响起凄厉惊恐的少女惨叫，撕裂了沉沉夜幕。"},"参与人物":["王语嫣","慕容复"]},"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":20,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":21,"分":0},"事件引子":"荒原深夜死寂无声，枯井深处骤然响起凄厉惊恐的少女惨叫，撕裂了沉沉夜幕。","事件详情":"王语嫣下坠时的凄厉惨叫声划破夜空，正在附近带伤寻找的段誉闻声大惊失色。段誉甚至来不及细想枯井到底有多深、井底有何凶险，出于对王语嫣舍生忘死的深情与护持之心，毫不犹豫地施展轻功，纵身向着漆黑阴森的枯井深处飞扑跃下，誓要以肉身护住心上人的周全。与此同时，一直在暗中窥伺觊觎的吐蕃国师鸠摩智亦现身于附近，他误以为枯井之中藏有绝世罕见的武学秘籍与神功图谱，贪念大炽之下不甘落后，施展身法紧随其后纵身跃入井中，企图抢夺机缘。三人接连坠入冰冷刺骨、漆黑不见五指的枯井底部。这一突发变故使得大理世子、姑苏佳人与吐蕃国师同时困于逼仄深井之内，重伤未愈与贪念交织，彼此立场错综复杂。一场奇绝玄妙、惊心动魄的枯井奇缘，就在这冰冷黑暗的深井底部悄然拉开了序幕。","事件概要":"闻得王语嫣坠井呼号，段誉不顾伤痛舍命扑入深井相护；暗中窥伺的鸠摩智误认井下藏有武学秘籍，贪念驱使下亦纵身随坠。三人相继跌入阴寒逼仄的枯井底部，因缘际会同陷死地。","insert":{"王语嫣":{"人物经历":{"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":"身子急剧坠向无底深渊，正万念俱灰凄声呼救之际，忽见段公子不顾生死随之扑落护持身旁，随后双双跌入刺骨泥泞的井底，惊魂未定间暗暗感念其舍命深情。"}},"段誉":{"人物经历":{"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":"忽闻王姑娘凄厉的呼救声自枯井深处传来，心胆俱裂下全然不顾自身掌伤与深井凶险，唯恐其香消玉殒，当即施展轻功纵身飞扑入井，誓以肉身护其周全，接连坠入漆黑冰冷的井底。"}},"鸠摩智":{"人物经历":{"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":"暗中窥伺见段誉奋不顾身跃入深井，误以为枯井底部藏有不世出的神功秘籍与绝顶图谱，唯恐机缘遭他人抢占，利欲熏心下当即运起轻功紧随跃下，重重跌落入幽暗冰冷的井底。"}}},"update":{"王语嫣":{"状态":"身陷枯井、惊魂未定"}},"后续事件":{"天龙第三十七回01-鸠摩智走火入魔扣脉发难":"幽暗深陷的枯井中泥泞没胫、寒气彻骨，骤然响起野兽濒死般的凄厉咆哮。"},"参与人物":["王语嫣","段誉","鸠摩智"]},"天龙第三十七回00-人物登场":{"事件类型":"登场事件","所属回目":"第三十七回","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":21,"分":0},"新登场人物":["宗赞王子"],"insert":{"宗赞王子":{"性别":"男","外貌":"生得大头大耳，身躯雄伟魁梧，满腮短虬髯，头戴金冠，身着吐蕃华丽锦袍貂裘。","性格":"粗豪狂妄，好色庸俗，心高气傲","境界":"二流-中期","初始属性":{"臂力":15,"根骨":12,"机敏":6,"洞察":5,"悟性":4},"出生年份":1176,"状态":"健康","所在位置":"西夏/灵州/西夏皇宫/偏殿","身份":{"吐蕃王子":"吐蕃赞普之子"},"功法":{},"重要物品":{},"人物经历":{},"关系网":{"鸠摩智":"国师/70"}}},"update":{"李清露":{"所在位置":"西夏/灵州/西夏皇宫/偏殿纱帘后"}}},"天龙第三十七回01-鸠摩智走火入魔扣脉发难":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":21,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":22,"分":0},"事件引子":"幽暗深陷的枯井中泥泞没胫、寒气彻骨，骤然响起野兽濒死般的凄厉咆哮。","事件详情":"黑漆冰冷、污泥没胫的西夏枯井深处，吐蕃国师大轮明王鸠摩智因平生贪求武功天下第一，强行兼修少林七十二绝技、逍遥派小无相功以及少林《易筋经》，体内数股截然相反的至阳至阴霸道真气彻底失衡冲撞，陷入经脉逆乱的走火入魔绝境。鸠摩智周身穴道如万蚁噬咬、烈火灼烧，剧痛之下神智彻底沦入魔障，双目赤红如血，口中发出犹如凶兽濒死般的凄厉咆哮。在逼仄幽暗的井底烂泥中，他狂性大发，挥舞双掌使出狂乱无章的凶狠杀招，四处扑击乱抓。段誉唯恐王语嫣受创，死死将她护在身后，在湿滑泥泞中左支右绌、狼狈翻滚闪避，后背险些被凌厉罡风撕裂。生死一线之际，彻底失控的鸠摩智猛然欺身暴起，右爪如铁箍般咔嚓一声狠厉扣住了段誉的右手腕脉。鸠摩智意欲吐劲震断段誉心脉，却因脉门死死相锁，瞬间沟通了二人体内气血经络，令双方在冰冷泥沼中僵持锁死，直接引动了后续不可逆转的内力狂吸剧变。","事件概要":"鸠摩智因兼修多门神功致真气失衡，经脉逆乱彻底走火入魔，神智尽失下在泥沼中四处扑杀。段誉死命将王语嫣护在身后狼狈翻滚闪避，生死关头右手腕脉被狂乱的鸠摩智如铁箍般死死扣住，二人气血经络瞬间交汇锁死。","insert":{"鸠摩智":{"人物经历":{"天龙第三十七回01-鸠摩智走火入魔扣脉发难":"体内至阴至阳真气彻底冲撞失衡，周身剧痛如蚁噬火灼，癫狂之下神智尽失沦入魔障，双目赤红厉声咆哮四处扑击，狂乱中欺身暴起，右爪如铁箍般狠厉扣死段誉的右手腕脉。"}},"段誉":{"人物经历":{"天龙第三十七回01-鸠摩智走火入魔扣脉发难":"见鸠摩智狂性大发盲目扑杀，唯恐王姑娘受创而拼死将其护在身后，在湿滑烂泥中左支右绌狼狈翻滚，危急之际右手腕脉猝不及防被其铁爪狠厉扣死，二人经络顿时相通僵持难脱。"}},"王语嫣":{"人物经历":{"天龙第三十七回01-鸠摩智走火入魔扣脉发难":"蜷缩在冰冷井底烂泥中，目睹鸠摩智如厉鬼般狂暴扑击，惊骇万状中见段公子舍命将自己护在身后连番躲闪，转瞬见段公子腕脉被狂僧死死扣住僵持不起，心提至嗓子眼惊惧难言。"}}},"update":{"鸠摩智":{"状态":"走火入魔、经脉逆乱"},"段誉":{"状态":"腕脉受制、经络僵持"}},"后续事件":{"天龙第三十七回02-段誉北冥逆转吸尽敌内力":"幽暗冰冷的枯井深处泥泞腥臭，癫狂的低吼声与剧烈搏击的水响混杂回荡。"},"参与人物":["鸠摩智","段誉","王语嫣"]},"天龙第三十七回02-段誉北冥逆转吸尽敌内力":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":22,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":23,"分":0},"事件引子":"幽暗冰冷的枯井深处泥泞腥臭，癫狂的低吼声与剧烈搏击的水响混杂回荡。","事件详情":"段誉右腕脉门遭走火入魔的鸠摩智如钢箍般死死扣住，外来暴虐内劲骤然侵入体内的极度危局下，段誉体内潜伏的《北冥神功》受此生死剧震刺激，护体气机自发产生强烈感应，瞬间犹如巨鲸吞海、天池倒泻般狂暴逆向运转起来。鸠摩智苦修数十载、融汇少林七十二绝技与小无相功的震古烁今浑厚真气，在北冥神功霸道绝伦的吞噬牵引下，化作狂涛怒浪，顺着交接的手太阴肺经不可遏止地倾泻涌入段誉周身百骸。体内积蓄一生的磅礴内力急速流失，撕心裂肺的空虚与脏腑抽搐令鸠摩智神智骤然清醒，眼中布满极度的恐惧与绝望。他凄厉惨嚎，双足在井底冰冷污泥中拼命扑腾蹬踹，左掌疯狂拍打泥泞试图借力震脱手腕自保。然而北冥吸力犹如强力胶漆牢不可破，将二人身躯如焊接般死死锁扣。段誉亦无法主动敛气收功，只能任由经脉承受气海翻涌膨胀的剧痛。真气狂澜持续倾注，直至鸠摩智一身雄浑霸道之内力被彻底抽吸得干干净净、涓滴不剩，狂暴倒灌方休，段誉由此尽纳明王毕生真元。 段誉静心调息，将新纳真气导入六脉，渐能自如催发六脉神剑。","事件概要":"鸠摩智走火入魔扣死段誉腕脉，暴虐内劲倒灌逼发段誉体内北冥神功自发逆行吞噬。鸠摩智清醒后剧痛惊恐挣扎难脱，段誉亦无法收敛神功，任由狂暴真元奔涌灌注。直至鸠摩智毕生功力被涓滴不剩尽数抽干，段誉尽纳其浑厚真气。 段誉调息融通新纳真气，六脉剑气渐能收发自如。","insert":{"段誉":{"人物经历":{"天龙第三十七回02-段誉北冥逆转吸尽敌内力":"右手脉门被鸠摩智死死扣住，生死存亡之际忽觉体内北冥神功如巨浪般狂暴反卷逆行，对方雄浑暴虐的内力如天池倒泻顺经脉源源涌入，周身经脉胀痛难忍却无法敛气罢手，直至强行将其毕生真气尽数吞纳气海。"}},"鸠摩智":{"人物经历":{"天龙第三十七回02-段誉北冥逆转吸尽敌内力":"扣住对方腕脉本欲倾泻杀力，不料反遭对方体内极霸道的怪异吸力牢牢吸附锁定，毕生苦修的深厚真元如决堤狂涛般疯狂流失；自惊惧中清醒后拼死蹬踹挣扎皆无法挣脱，凄厉惨嚎中任由一身磅礴内力被彻底吸噬一空。"}}},"update":{"段誉":{"境界":"绝顶-初期","状态":"真元充盈、经脉胀痛","功法":{"六脉神剑":{"掌握程度":"融会贯通"}}},"鸠摩智":{"境界":"不入流-圆满","状态":"功力尽失、虚脱萎顿"}},"后续事件":{"天龙第三十七回03-鸠摩智散尽内力顿悟出井":"幽暗阴冷的枯井底泥泞刺骨，狂暴撕扯的内力狂澜骤然消歇，四壁唯余粗重喘息。"},"参与人物":["段誉","鸠摩智"]},"天龙第三十七回03-鸠摩智散尽内力顿悟出井":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":23,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":2,"分":0},"事件引子":"幽暗阴冷的枯井底泥泞刺骨，狂暴撕扯的内力狂澜骤然消歇，四壁唯余粗重喘息。","事件详情":"毕生雄浑内力被段誉彻底吸干之后，鸠摩智周身筋骨极度虚脱，经脉空荡无物，整个人如同一滩烂泥般瘫软在冰冷潮湿的井底泥泞中。然而，体内原先如焚似绞的逆乱真气荡然无存，这一场武功的彻底荡尽与死生剧变，犹如当头棒喝，反而彻底击碎了深植其心中数十年的贪嗔痴狂与心魔妄念。鸠摩智眸中原本狂暴狰狞的戾气尽数消退，神色骤然恢复了明镜般的澄澈与宁静。他在污泥中艰难挣扎着坐起身来，神态安详地拂去僧袍上的泥垢，整肃凌乱衣襟，随后神色平和地面向段誉与王语嫣双手合十，微微躬身宣佛号道：“阿弥陀佛，贫僧今日方识本来面目，多谢段公子化解此劫。”历经这番失却神功的大劫难，鸠摩智大彻大悟，彻底放下了对天下武学第一与虚荣名利的贪执妄求，选择皈依佛法本真。他仰天发出三声畅快淋漓的大笑，心无挂碍地攀着湿滑井壁青砖飘然翻身出井，从此彻底远离江湖血雨腥风与纷争恩怨，真正成为了一代名副其实、弘法利生的得道高僧。","事件概要":"内力散尽的鸠摩智瘫软于井底烂泥，经脉空荡反令心魔尽碎、大彻大悟。他神态安详向段誉合十道谢化解魔障之劫，仰天三声朗笑翻身攀壁跃出深井，从此遁离江湖恩怨皈依佛法；段誉与王语嫣劫后余生留在井底。","insert":{"鸠摩智":{"人物经历":{"天龙第三十七回03-鸠摩智散尽内力顿悟出井":"内力尽失瘫卧污泥之中，忽觉体内焚身真气消散殆尽，死生剧变如当头棒喝荡涤数十年贪嗔妄念，心境彻底明澈澄净，遂合十向段公子肃穆道谢，仰天畅笑翻身出井重归佛门。"}},"段誉":{"人物经历":{"天龙第三十七回03-鸠摩智散尽内力顿悟出井":"吞纳毕对方内力后满身真气胀痛难抑，见原本凶狂的吐蕃国师戾气全消、面容安详向自己合十行礼致谢，又见其朗笑攀壁跃出井去，心下既惊奇又感叹佛法玄妙。"}},"王语嫣":{"人物经历":{"天龙第三十七回03-鸠摩智散尽内力顿悟出井":"蜷缩泥泞中惊魂未定，眼见狂暴如恶鬼的吐蕃僧周身戾气退尽，整肃僧袍向段公子躬身致谢后朗笑跃出深井，见段公子安然无恙，紧绷的心弦方才松弛下来。"}}},"update":{"鸠摩智":{"状态":"顿悟通透、心无挂碍","所在位置":"西夏/凉州/凉州荒漠","性格":"慈悲祥和，四大皆空"}},"后续事件":{"天龙第三十七回04-王语嫣看清真相依许段誉":"鸠摩智去后，泥水没膝的幽暗枯井深处重归死寂，唯余二人狼狈相倚。"},"参与人物":["段誉","鸠摩智","王语嫣"]},"天龙第三十七回04-王语嫣看清真相依许段誉":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":2,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":5,"分":0},"事件引子":"鸠摩智去后，泥水没膝的幽暗枯井深处重归死寂，唯余二人狼狈相倚。","事件详情":"鸠摩智离去后，冰冷幽暗、泥水没膝的枯井深处重归死寂，只剩下满身污泥的段誉与王语嫣二人相依独处。经历方才生死悬于一线的剧烈冲击，王语嫣心神巨震，神情凄楚迷茫。她回想起此前在枯井边，表哥慕容复为了争当西夏驸马、图谋复国霸业，竟对自己痛下杀手推入深井，而段誉却毫不犹豫纵身跃下舍命相救，更在鸠摩智发狂时用血肉之躯死死护住自己。这一冷一热的强烈对比，彻底粉碎了她自幼对表哥的盲目痴情与崇拜幻梦。王语嫣凝视着眼前狼狈不堪却满眼关切赤诚的段誉，泪水如断线珍珠般滚滚滑落，哽咽颤声道：“段公子，我表哥待我如此薄情狠毒，你……你为何却待我这般好？”段誉急忙笨拙地替她擦拭泪水，真诚剖白愿为她粉身碎骨。多年痛苦执念瞬间冰消瓦解，王语嫣毅然决然斩断旧情，主动扑入段誉怀中依偎相许。段誉惊喜交集，紧紧搂住心爱姑娘，二人在污泥中定下白首之约，两情相悦终成眷属。","事件概要":"枯井死寂之中，王语嫣回思表哥推己坠井的绝情残忍与段誉舍命相救的赤诚深情，多年盲目执念彻底冰消瓦解。面对段誉的真挚剖白，她痛斩旧情并主动投怀依偎，段誉惊喜交集紧紧相拥，二人于污泥绝境中互许白首之约。","insert":{"段誉":{"人物经历":{"天龙第三十七回04-王语嫣看清真相依许段誉":"见王姑娘神情凄楚垂泪质问，急忙笨拙为她拭泪并剖白甘愿为其粉身碎骨的痴心赤诚；忽见朝思暮想的姑娘主动投怀依偎相许，惊喜交集下紧紧将她搂入怀中，在这污泥深井中定下白首之约。"}},"王语嫣":{"人物经历":{"天龙第三十七回04-王语嫣看清真相依许段誉":"念及表哥狠心下毒手推己坠井、而段公子却舍命相随护持，幡然醒悟表哥寡情薄义而彻底粉碎多年执念；悲咽质问后得闻段公子赤诚剖白，心防冰释下毅然斩断旧情，扑入其怀中依偎托付终身。"}}},"update":{"段誉":{"关系网":{"王语嫣":"白首之约/95"}},"王语嫣":{"状态":"心有所属、互许白首","关系网":{"段誉":"白首之约/95"}}},"后续事件":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"幽暗泥泞的枯井深处寒意刺骨，井口上方忽地传来凌乱急促的脚步声与焦灼呼喊。"},"参与人物":["段誉","王语嫣"]},"天龙第三十七回05-虚竹垂绳救人同赴选婿会":{"事件地点":"西夏/凉州/凉州荒漠/枯井","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":5,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":17,"分":0},"事件引子":"幽暗泥泞的枯井深处寒意刺骨，井口上方忽地传来凌乱急促的脚步声与焦灼呼喊。","事件详情":"段誉与王语嫣在枯井定下终身盟约后，身陷数丈之深的滑腻泥坑无法自行脱困，正在商议如何脱险之际，井口上方忽然传来了急促的脚步声与呼唤声。逍遥派掌门、灵鹫宫尊主虚竹因担忧结拜三弟段誉的安危，亲自率领灵鹫宫梅兰竹菊四剑及九天九部部众一路循迹搜寻至此。虚竹伏在井口向下探视，惊喜高呼：“三弟！你可无恙？”井底段誉闻声大喜，扬声回应报平安。虚竹当机立断，吩咐侍女取来灵鹫宫特制的坚韧长绳垂入幽深井底。段誉细心地先将绳索牢牢系在王语嫣腰间，虚竹以内力与众女合力将王语嫣安稳拽上井沿，随后再次垂绳将段誉拉出泥潭。脱险出井后，众人在井旁引清冽泉水洗去满身污泥秽渍，换上干净素雅的新衣，整肃仪容。段誉与虚竹互道别后情由，决定结伴一同前往西夏皇宫赴银川公主的招婿盛会。众人行至皇宫主殿广场，只见慕容复、吐蕃宗赞王子等数百名青年才俊早已云集列队，正式拉开了选婿角逐的序幕。","事件概要":"段誉与王语嫣身陷湿滑枯井难以脱身，虚竹率灵鹫宫部众循迹寻至井口，垂下长绳以内力将二人拉出泥坑。众人引泉涤净泥污、整肃仪容，段誉与虚竹互叙别情后结伴同赴招婿盛会，抵达皇宫主殿广场与慕容复等百余才俊同列待选。","insert":{"段誉":{"人物经历":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"困于泥泞深井忽闻义兄虚竹呼唤，喜出望外下依言将垂落长绳系于王姑娘腰间护其先登，随后自身亦被拉出枯井脱困；引泉净身更衣后，欣然与二哥结伴奔赴西夏皇宫主殿广场共赴选婿大会。"}},"虚竹":{"人物经历":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"率领灵鹫部众一路搜寻至荒野枯井，喜见三弟段誉与王姑娘受困井底，当即垂下坚韧长绳以内力将二人拽出险境；听闻三弟别后经历后，遂与之相伴前往西夏皇宫广场，欲探明选婿真相与梦姑线索。"}},"王语嫣":{"人物经历":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"陷于枯井烂泥中得段公子悉心照料，忽遇其义兄虚竹垂绳施救，任由段公子细致将绳索系牢腰间拉上井沿脱离死地；更衣涤尘后随众人同赴皇宫广场，默默注视前方整肃待选的表哥慕容复。"}},"慕容复":{"人物经历":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"除却表妹羁绊后疾行赶至西夏皇宫主殿广场列队待选，见各国公侯才俊云集，按捺心神静待内廷召选以图光复大燕。"}}},"update":{"段誉":{"所在位置":"西夏/灵州/西夏皇宫/主殿广场"},"虚竹":{"所在位置":"西夏/灵州/西夏皇宫/主殿广场"},"王语嫣":{"所在位置":"西夏/灵州/西夏皇宫/主殿广场"},"慕容复":{"所在位置":"西夏/灵州/西夏皇宫/主殿广场"}},"后续事件":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"西夏偏殿内幽香浮动，明珠纱帘重垂，侍女执灯宣示三问，阶下求婚群雄屏息肃立。"},"参与人物":["段誉","王语嫣","虚竹"]},"天龙第三十七回06-侍女隔帘设三问群雄竞答":{"事件地点":"西夏/灵州/西夏皇宫/偏殿","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":17,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":19,"分":0},"事件引子":"西夏偏殿内幽香浮动，明珠纱帘重垂，侍女执灯宣示三问，阶下求婚群雄屏息肃立。","事件详情":"西夏皇宫偏殿内烛影摇曳、香烟袅袅，深处重重垂挂着一层薄如蝉翼的明珠纱帘。西夏银川公主李清露端坐帘后暗影中，为从数百名求婚者中寻觅昔日冰洞旧人，特遣贴身侍女手持宫灯款步走出。侍女立于玉阶之上，神情肃穆地向阶下环列的慕容复、宗赞王子、段誉、虚竹等各路青年才俊当众宣示三道古怪考题：一问平生在何处最感逍遥快乐，二问生平最心爱之人容貌若何，三问这心爱之人闺名唤作什么。群雄闻言各怀机心逐一作答：慕容复急于攀附西夏借兵复国，冠冕堂皇答道平生最乐在将来光复大燕，所爱之人容貌绝美却不知闺名，言语满是权谋做作；吐蕃宗赞王子粗俗狂妄，大声道最乐在王宫打猎饮酒，最爱之人便是帘后公主；段誉则坦荡赤诚，直言最快乐在黑暗冰冷的枯井底，最心爱之人便是王语嫣姑娘，闺名即是语嫣。众才俊或虚伪或狂妄，回答皆未能触及帘后公主心弦，大殿内气氛逐渐紧张凝滞，静候最终裁决。","事件概要":"银川公主李清露端坐纱帘后，遣侍女抛出三道古怪问答以寻昔日梦郎。宗赞狂言嗜酒猎艳，慕容复满口复国权谋，段誉赤诚坦陈枯井定情。各路才俊各怀机心逐一作答，皆非意中人，殿内气氛凝滞，只待虚竹应答。","insert":{"李清露":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"端坐重重明珠纱帘之后，遣侍女提出关乎冰洞旧事的三问以寻梦郎；隔帘细听群豪答复，闻其或狂妄庸俗、或虚伪功利，皆非刻骨铭心的意中人，心下惆怅焦灼。"}},"慕容复":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"立于偏殿阶下迎对侍女三问，一心借联姻招揽西夏兵力光复大燕，遂冠冕堂皇答称生平至乐在未来复燕大业，所爱之人绝美却不知闺名，自恃应对得体定能博得公主青睐。"}},"宗赞王子":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"粗声大嗓当众夸口，昂然高呼平生最乐乃在王宫饮酒行猎，所爱之人便是帘后西夏公主，意图以吐蕃王族声势压倒群豪夺得驸马之位。"}},"段誉":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"面对侍女提问毫无争夺驸马之念，坦荡直言生平最快乐在黑暗冰冷的枯井之中，所爱之人唯有王语嫣姑娘，当众表明心迹无悔相许。"}},"虚竹":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"随三弟立于殿中旁观群豪应试，听闻侍女提出平生何处最乐、所爱何人等古怪考题，心头蓦地泛起冰窖缱绻旧忆，见众人竞相争答，唯恐轮及自身而暗自局促不安。"}}},"update":{},"后续事件":{"天龙第三十七回07-虚竹坦陈梦境被选为驸马":"殿内檀香幽微，众俊彦竞答方歇，侍女忽执名册遥遥指向偏隅静立的丑僧。"},"参与人物":["李清露","慕容复","宗赞王子","段誉","虚竹"]},"天龙第三十七回07-虚竹坦陈梦境被选为驸马":{"事件地点":"西夏/灵州/西夏皇宫/偏殿","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":19,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":20,"分":0},"事件引子":"殿内檀香幽微，众俊彦竞答方歇，侍女忽执名册遥遥指向偏隅静立的丑僧。","事件详情":"侍女点名询问虚竹。虚竹据实答出平生至乐在黑暗冰窖，心爱之人只知唤作梦姑。珠帘后传来失声与茶盏碎裂之响，众人惊疑，虚竹尚不知帘后之人是谁，静候回应。","事件概要":"虚竹坦陈冰窖旧梦与梦姑之名，帘后女子失声碎盏，众人静候回应。","insert":{"虚竹":{"人物经历":{"天龙第三十七回07-虚竹坦陈梦境被选为驸马":"据实答出冰窖旧梦和梦姑之名，闻帘后碎盏，茫然静候。"}},"李清露":{"人物经历":{"天龙第三十七回07-虚竹坦陈梦境被选为驸马":"闻虚竹道出冰窖旧事与梦姑之名，惊喜交集，失手碎盏。"}},"段誉":{"人物经历":{"天龙第三十七回07-虚竹坦陈梦境被选为驸马":"听二哥坦陈冰窖旧梦，闻帘后失声碎盏，静候结果。"}}},"update":{},"后续事件":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"珠帘后茶盏破碎，殿上众人屏息静候。"},"参与人物":["虚竹","李清露","段誉"]},"天龙第三十八回00-人物登场":{"事件类型":"登场事件","所属回目":"第三十八回","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":20,"分":0},"新登场人物":["甘宝宝","秦红棉","李青萝"],"insert":{"甘宝宝":{"性别":"女","外貌":"三十余岁少妇模样，容貌娇艳俏丽，身段苗条婀娜，身着锦缎袄裙，眉目含情。","性格":"柔情似水，机敏多心，爱憎分明","境界":"三流-中期","初始属性":{"臂力":5,"根骨":7,"机敏":13,"洞察":8,"悟性":5},"出生年份":1168,"状态":"健康","所在位置":"大宋/太湖/曼陀山庄","身份":{"万劫谷谷主夫人":"俏夜叉"},"功法":{},"重要物品":{},"人物经历":{},"关系网":{"段正淳":"情人/85","钟灵":"母女/90","秦红棉":"同门师妹/60"}},"秦红棉":{"性别":"女","外貌":"三十余岁年纪，长挑身材，容貌俏丽而神色冷峻，身着黑色劲装，腰佩修罗双刀。","性格":"孤僻暴躁，执着痴情，性格刚烈","境界":"二流-中期","初始属性":{"臂力":9,"根骨":8,"机敏":14,"洞察":8,"悟性":6},"出生年份":1166,"状态":"健康","所在位置":"大宋/太湖/曼陀山庄","身份":{"修罗刀":"幽谷隐士"},"功法":{"修罗刀法":{"掌握程度":"略有小成"}},"重要物品":{},"人物经历":{},"关系网":{"段正淳":"情人/85","木婉清":"母女/90","甘宝宝":"同门师姐/60"}},"李青萝":{"性别":"女","外貌":"四十岁上下年纪，面容端庄美艳，眉宇间颇具威严，身穿华贵锦袍，体态丰腴。","性格":"傲慢狠辣，喜怒无常，深情偏执","境界":"二流-中期","初始属性":{"臂力":5,"根骨":7,"机敏":6,"洞察":10,"悟性":13},"出生年份":1162,"状态":"健康","所在位置":"大宋/太湖/曼陀山庄","身份":{"曼陀山庄庄主":"王夫人"},"功法":{},"重要物品":{},"人物经历":{},"关系网":{"段正淳":"旧情人/70","王语嫣":"母女/85","慕容复":"姑甥/40"}}},"update":{"包不同":{"所在位置":"西夏/灵州/城郊荒原/荒谷"}}},"天龙第三十八回01-虚竹成西夏驸马慕容复落选":{"事件地点":"西夏/灵州/西夏皇宫/偏殿","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":20,"分":0},"事件结束时间":{"年":1203,"月":7,"日":29,"时":0,"分":0},"事件引子":"珠帘后茶盏破碎，殿上众人屏息静候。","事件详情":"帘后李清露认出虚竹便是梦郎，掀帘相见，二人欣喜相认。西夏国主随即宣旨赐婚，择虚竹为驸马，赐予金印与龙凤佩饰；虚竹与段誉出列谢恩，西夏、灵鹫宫和大理借此结好。慕容复借婚复国的计划落空，羞愤离殿。","事件概要":"李清露揭帘与虚竹相认，国主赐婚并赐金印佩饰，三方结好；慕容复落选离殿。","insert":{"虚竹":{"人物经历":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"见公主揭帘认出梦姑，领旨受赐金印佩饰，与段誉出列谢恩。"},"身份":{"西夏驸马":"西夏国银川公主之夫婿"},"关系网":{"李清露":"结发夫妻/95"},"重要物品":{"西夏御赐金印":"西夏国主御赐象征皇室联姻与驸马尊荣的金印","龙凤佩饰":"西夏皇室赐予驸马迎娶公主之大婚佩饰信物"}},"慕容复":{"人物经历":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"自恃应对高雅得体定能博取公主青睐借兵复燕，岂料内廷竟将驸马之位钦定予少林丑僧虚竹；眼见数载谋划化为泡影且颜面尽失，胸中妒恨怨毒翻涌，愤然拂袖离殿。"}},"李清露":{"人物经历":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"揭帘与梦郎相认，同受赐婚。"}},"段誉":{"人物经历":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"为二哥与公主相认欢喜，与二哥出列谢恩，见西夏、灵鹫宫与大理结好。"}}},"update":{"李清露":{"关系网":{"虚竹":"结发夫妻/95"}}},"后续事件":{"天龙第三十八回02-慕容复屈膝投靠段延庆为父":"太湖曼陀山庄花厅内冷风萧索，段延庆铁杖拄地铮铮作响，慕容复神色阴鸷踏入厅堂。"},"参与人物":["慕容复","虚竹","李清露","段誉"]},"天龙第三十八回02-慕容复屈膝投靠段延庆为父":{"事件地点":"大宋/太湖/曼陀山庄","触发条件":{"类型":"时间","年":1203,"月":8,"日":19,"时":8,"分":0},"事件结束时间":{"年":1203,"月":8,"日":19,"时":10,"分":0},"事件引子":"太湖曼陀山庄花厅内冷风萧索，段延庆铁杖拄地铮铮作响，慕容复神色阴鸷踏入厅堂。","事件详情":"慕容复在西夏招亲彻底落选之后，深感单凭姑苏慕容氏残存之力绝难实现光复大燕之宏愿，复国欲念炽烈攻心之下，决意破罐子破摔，与四大恶人之首“恶贯满盈”段延庆暗中接洽勾结。段延庆一心夺取大理国皇位，二人各怀鬼胎、一拍即合。为了换取段延庆与四大恶人势力的全力相助，慕容复彻底抛弃大燕皇室之尊严与历代祖宗清誉，在密会之中当众推金山倒玉柱，双膝重重跪倒在段延庆铁杖之下，口称“义父”，甘愿沦为大理段氏之干儿子，立下重誓要借助大理国政权与精锐军力起兵复国。段延庆见名满天下的姑苏慕容公子竟如此卑躬屈膝、甘充义子爪牙，大为快意与满意，当场应允结为父子同盟。至此，慕容复彻底抛弃武林世家道义与正道名节，与邪道恶徒达成政治盟约，确立了借大理夺权的阴毒计划，为其日后掀起滔天血雨腥风铺平了道路。","事件概要":"西夏招亲落选后，慕容复复国心切，决意放下身段与四大恶人之首段延庆暗中勾结。为换取段延庆与大理政权兵力支持，慕容复甘弃大燕尊严，当众屈膝跪拜其为义父，立誓借大理军力起兵复燕；段延庆快意应允，邪道与世家彻底结为政治同盟。","insert":{"慕容复":{"人物经历":{"天龙第三十八回02-慕容复屈膝投靠段延庆为父":"眼见西夏招亲成空、复燕大业无望，决意不惜一切代价借势夺权，遂抛下大燕皇室体面与家训，当众重重跪倒在段延庆铁杖之下口称义父，誓借大理之兵以图复兴大业。"}},"段延庆":{"人物经历":{"天龙第三十八回02-慕容复屈膝投靠段延庆为父":"见姑苏慕容氏家主竟为图谋大业当众向自己屈膝下跪、甘认义父，心下大感快意与受用，当即以腹语应允结为父子同盟，决意借其武功与声势助自己夺回大理皇位。"}}},"update":{"慕容复":{"关系网":{"段延庆":"义父/50"}},"段延庆":{"关系网":{"慕容复":"义子/50"}}},"后续事件":{"天龙第三十八回03-慕容复暴起击杀家臣包不同":"曼陀山庄庄内死寂肃杀，包不同双目喷火怒视方才屈膝认贼的慕容复，空气森冷如铁。"},"参与人物":["慕容复","段延庆"]},"天龙第三十八回03-慕容复暴起击杀家臣包不同":{"事件地点":"大宋/太湖/曼陀山庄","触发条件":{"类型":"时间","年":1203,"月":8,"日":19,"时":10,"分":0},"事件结束时间":{"年":1203,"月":8,"日":19,"时":11,"分":0},"事件引子":"曼陀山庄庄内死寂肃杀，包不同双目喷火怒视方才屈膝认贼的慕容复，空气森冷如铁。","事件详情":"慕容复跪拜认贼作父的屈辱丑态，被其身旁忠心耿耿的家臣包不同等在场众人尽收眼底。包不同向来性格刚烈耿直、对大燕慕容氏忠心不二，眼见少主为了虚无缥缈的权位竟彻底丧尽廉耻与人格，顿时气血翻涌、痛心疾首。包不同按捺不住满腔悲愤，当众厉声痛斥慕容复，怒骂其下跪认贼是不忠不孝不仁不义，甘愿沦为天下走狗、奴颜婢膝，令姑苏慕容数百年英名扫地以尽。其言辞如刀，字字句句直戳慕容复痛处。慕容复被当众揭穿痛处，恼羞成怒之下凶性彻底大发。为了向段延庆交纳投名状以表忠心，同时杀人灭口掩盖自己认贼作父的丑行，慕容复面露狰狞，趁包不同毫无防备之际自其背后悍然暴起，汇聚毕生内力狠辣无情地击出一掌，重重击碎了包不同的背心大穴。包不同护体真气瞬间崩溃，口喷鲜血，圆睁双目倒地气绝身亡。","事件概要":"包不同痛心慕容复屈膝认贼作父，当众厉声斥其不忠不孝、辱没大燕英名。慕容复被戳中痛处恼羞成怒，为向段延庆纳投名状并灭口遮丑，自背后猝施辣手一掌震碎包不同背心大穴，致其当场气绝毙命。","insert":{"慕容复":{"人物经历":{"天龙第三十八回03-慕容复暴起击杀家臣包不同":"见包不同当众破口痛骂、字字戳中自身认贼作父的屈辱痛处，恼羞成怒之下杀机大发；为向段延庆纳投名状并杀人灭口，趁其不备自背后猝施毒手，聚毕生功力一掌震碎其背心要穴，将其当场击毙。"}},"包不同":{"人物经历":{"天龙第三十八回03-慕容复暴起击杀家臣包不同":"眼见少主竟为虚名权位向段延庆屈膝认贼作父，悲愤交加之下当众厉声痛斥其不忠不孝、辱没大燕数百年英名；万没想到背后猝遭慕容复悍然暴起偷袭，背心大穴被其重手震碎，气血溃散当场毙命。"}},"段延庆":{"人物经历":{"天龙第三十八回03-慕容复暴起击杀家臣包不同":"冷眼看着包不同当众痛骂慕容复认贼作父，旋即见慕容复恼羞成怒暴起偷袭、自背后辣手击杀亲信家臣以纳投名状，心中冷哂其心性残忍凉薄，却也乐见其斩断退路效忠自身。"}}},"update":{"包不同":{"状态":"死亡"}},"后续事件":{"天龙第三十八回04-风波恶公冶乾折兵断义而去":"曼陀山庄庭院中弥漫着刺鼻血腥，包不同尸身横卧血泊，周遭空气凝固如冰。"},"参与人物":["慕容复","包不同","段延庆"]}}}
