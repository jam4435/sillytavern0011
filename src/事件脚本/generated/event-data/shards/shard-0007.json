{"schemaVersion":1,"id":"shard-0007","definitions":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":20,"时":23,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":0,"分":0},"事件引子":"少室山大雄宝殿前夜色深沉，厮杀初平的广场杀气未散，殿顶骤响裂空破风之声。","事件详情":"少室山大雄宝殿前夜色深沉，各派高手的厮杀方才平息，玄慈方丈率少林群僧合十肃立，丐帮与大理群雄犹自惊魂未定。正当众人以为战局已定时，屋脊两侧陡然炸响两道撕裂长空的尖锐破空之声。只见两道黑袍蒙面身影宛如两头扑食苍鹰，自重檐庑殿顶俯冲而下，足尖仅在悬空的铜钟与蟠龙立柱上轻点借力，身形飘忽若鬼魅。萧峰见状瞳孔骤缩，沉腰扎马暗催丹田内劲护体，段誉与虚竹亦各自踏奇门步法护持两侧，少林罗汉堂众僧更是齐声呼喝、横棍结成铁桶金刚阵。两名黑衣老者刹那间并肩落于广场正中，浑厚无匹的护体罡气随之轰然外涌，落脚处坚硬的青石地板应声寸寸龟裂，激荡的气浪硬生生将前排持棍的六名少林武僧震得倒退三步、胸口烦闷欲呕。两名神秘人不置一词，渊渟岳峙地傲立全场焦点，目光冷冽地扫过玄慈、萧峰与慕容复等人，原本稍见平息的少林广场瞬间陷入冰封般的极度死寂，各派豪强纷纷按剑凝神，一场更为凶险的滔天杀局骤然降临。","事件概要":"少室山大战刚平，两名黑袍蒙面神秘老者自大雄宝殿殿顶如苍鹰般飞扑而下，携沛然莫御的护体罡气震裂青石，逼退少林武僧。二人渊渟岳峙冷视全场，萧峰沉腰运劲戒备，段誉、虚竹与玄慈等各方高手按兵凝神，稍显平息的少林广场再度陷入凶险死寂。","insert":{"乔峰":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"自南京毒酒之厄与囚禁中获救后，在两位义弟帮助调息下毒力渐退、内力恢复；忽闻殿顶破空之声大作，抬眼见两名黑袍蒙面老者如鹰隼般自屋脊俯冲而下并震裂青石，心头骤凛，当即沉腰扎马、暗运浑厚丹田真气以防不测。"}},"段誉":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"见两道黑袍蒙面怪影从殿顶俯冲坠落、落地罡风将少林武僧逼退数步，惊异之余迅即脚踏奇门步法抢步护在长兄身侧，提运内力凝神戒备。"}},"虚竹":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"见殿脊两侧掠下两名身法诡异的黑衣老者，护体罡气威势惊人、震裂石板，急忙施展奇门步法与三弟并肩拱卫大哥，合力御敌以防变故。"}},"玄慈":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"刚率群僧平定战局，突见两名黑衣蒙面人凌空飞落大殿广场并以无匹罡气震退门下持棍武僧，深感来者武功深不可测，合十肃立凝视二人以静观其变。"}},"慕容复":{"人物经历":{"天龙第四十一回01-蒙面双老现身少室山震动群雄":"败局方定之际，忽见两名黑衣蒙面高手破空飞降广场、激荡罡气震裂青石，引得全场陷入死寂，心中惊疑不定，暗自按剑冷眼窥伺局势走向。"}}},"update":{},"后续事件":{"天龙第四十一回02-萧远山揭面认亲与萧峰痛哭":"少林古刹前剑拔弩张，立于广场左侧的蒙面老者凝视萧峰，山风猎猎间胸膛剧烈起伏。"},"参与人物":["乔峰","段誉","虚竹","玄慈","慕容复"]},"天龙第四十一回02-萧远山揭面认亲与萧峰痛哭":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":0,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":1,"分":0},"事件引子":"少林古刹前剑拔弩张，立于广场左侧的蒙面老者凝视萧峰，山风猎猎间胸膛剧烈起伏。","事件详情":"面对少林广场上如临大敌的各派豪杰，立于左侧的黑衣老者久久凝视着昂藏巍峨的萧峰，胸膛剧烈起伏，忽然仰天爆发出一阵凄厉苍凉的长笑，笑声中夹杂着三十年刻骨铭心的悲愤，震得少室山漫山古刹嗡嗡作响。在群雄惊愕的目光注视下，老者右手猛然发力，一把扯下遮面的黑巾甩落于地。黑巾飘落处，露出一张与萧峰生得八九分相似的粗豪脸庞，浓眉阔口，宛如同一块生铁铸就，唯独两鬓如霜，面颊上刻满了风刀霜剑雕凿的深刻皱纹。萧峰见状如遭焦雷轰顶，挺拔的身躯禁不住剧烈颤抖，失声喃喃自语。萧远山眼中泪光滚落，跨步上前沉声唤道：“孩儿，三十年了！”这一声呼唤彻底击溃了契丹战神的铁石心肠，萧峰再无迟疑，轰然双膝跪倒在青石地上，膝行上前一把抱住生父的腰肢，将头颅深埋在父亲怀中放声痛哭。萧远山亦双臂如铁钳般紧紧搂住爱子，泪洒衣襟。三十载骨肉分离的凄苦与冤屈在少林寺前化作撼天动地的恸哭，令在场的少林高僧与天下豪侠尽皆心神剧震、怆然失色。","事件概要":"黑衣老者仰天发出一阵凄厉长笑，当众猛然扯下黑巾，露出一张与萧峰生得八九分相似的面庞并沉声唤儿。萧峰心神大震认出生父，轰然跪地膝行抱住其腰肢放声痛哭，三十载骨肉分离终在天下豪杰前相认。","insert":{"萧远山":{"人物经历":{"天龙第四十一回02-萧远山揭面认亲与萧峰痛哭":"久视昂藏而立的骨肉，三十年刻骨悲愤化作仰天凄凉长笑，猛力扯下面巾露出真容唤其相认，旋即伸铁臂紧紧搂住跪地哭拜的爱子，热泪滚落衣襟。"}},"乔峰":{"人物经历":{"天龙第四十一回02-萧远山揭面认亲与萧峰痛哭":"突见黑衣老者仰天大笑并扯下面巾，显出一张与自己宛如生铁同铸的面孔，听其一声呼唤如遭雷震，登时轰然跪倒膝行扑入生父怀中放声痛哭。"}}},"update":{"萧远山":{"外貌":"身材魁梧高大，身着黑色夜行布袍，两鬓如霜，浓眉阔口，面颊饱经风霜且面貌与萧峰生得八九分相似。","关系网":{"乔峰":"亲子/100"}},"乔峰":{"关系网":{"萧远山":"生父/100"}}},"后续事件":{"天龙第四十一回03-萧远山自述潜伏复仇揭杀戮真相":"大殿前石阶旁寒风卷地，各派豪杰与少林僧众屏息按刃，场中死一般沉寂。"},"参与人物":["萧远山","乔峰"]},"天龙第四十一回03-萧远山自述潜伏复仇揭杀戮真相":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":1,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":2,"分":0},"事件引子":"大殿前石阶旁寒风卷地，各派豪杰与少林僧众屏息按刃，场中死一般沉寂。","事件详情":"父子相认后，萧远山扶起萧峰，霍然转身逼视少林群僧与天下豪杰，眼中喷薄出森然杀气。他踏前三步，声音如铜钟激荡，当众揭开三十年前雁门关绝壁跳崖后的骇人隐秘：当年他怀抱亡妻跳下万丈深渊，幸得绝壁古树悬挂保全残躯，自此隐姓埋名，暗中潜伏进少林寺藏经阁三十载，夜夜翻阅偷学少林七十二绝技以积蓄复仇力量。言及此处，萧远山面露快意与狠厉，厉声宣布近来震惊江湖的连环血案皆系他一人所为——潜入乔家村震毙养育萧峰的乔三槐夫妇，夜闯菩提院击碎授业恩师玄苦大师的胸骨，乃至在聚贤庄外与卫辉城中先后掌毙赵钱孙、谭公谭婆以及单正全家。他步步紧逼喝道：“当年带头大哥杀我爱妻、夺我幼子，凡是隐瞒元凶的知情者，皆该碎尸万段！”此言一出，全场武林名宿骇然失色，少林僧众齐诵佛号悲愤难抑。萧峰听闻恩师与养父母竟丧于生父之手，面色惨白、心如刀绞，三十年笼罩在聚贤庄与少林寺头顶的冤狱谜团终以最残酷的方式水落石出。","事件概要":"萧远山扶起萧峰并逼视天下豪杰，当众揭露三十年前雁门关绝壁逢生后潜伏少林偷学绝技的隐秘，更厉声承认乔三槐夫妇、玄苦及赵钱孙等连环血案皆系己所为，以血腥报复隐瞒“带头大哥”的知情者。萧峰惊闻噩耗心如刀绞，轰动江湖的连环悬案至此水落石出。","insert":{"萧远山":{"人物经历":{"天龙第四十一回03-萧远山自述潜伏复仇揭杀戮真相":"扶起萧峰后横眉逼视少林群僧与天下豪杰，厉声宣告自己三十年来潜伏少林寺藏经阁偷学绝技、暗中格杀乔三槐夫妇与玄苦等隐瞒者的复仇经过，誓要让血案元凶血债血偿。"}},"乔峰":{"人物经历":{"天龙第四十一回03-萧远山自述潜伏复仇揭杀戮真相":"被生父扶起后惊闻雁门关绝壁生还与三十载潜伏旧事，骤然得知抚育自己的养父母、授业恩师玄苦及赵钱孙等人竟全丧于生父之手，面色惨白、心如刀绞。"}}},"update":{},"后续事件":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"少室山广场上杀气未散，另一名黑衣老者忽发森寒嗤笑，引得满场豪杰错愕侧目。"},"参与人物":["萧远山","乔峰"]},"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":2,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":3,"分":0},"事件引子":"少室山广场上杀气未散，另一名黑衣老者忽发森寒嗤笑，引得满场豪杰错愕侧目。","事件详情":"就在全场豪杰为萧远山的复仇杀戮惊骇莫名之际，站在一侧始终冷眼旁观的另一名黑衣老者忽然发出一阵森寒刺骨的嗤笑。在天下英雄与少林高僧的错愕注视下，该老者神色自若地抬起枯瘦的右掌，慢条斯理地扯下遮面黑巾，随手掷于脚下。黑巾褪去，显出一张清瘦矍铄、双目神光如电的威严面庞。少林玄字辈高僧玄渡与玄生定睛望去，顿时如见鬼魅般倒退数步，颤声惊呼：“慕容老施主？你……你当年不是早已染疾西归？！”一旁的慕容复更是浑身剧颤，扑通跪倒在地，失声悲呼：“爹爹！”慕容博负手傲立，嘴角挂着睥睨众生的冷笑，坦然承认三十年前假死遁世乃金蝉脱壳之计。他这三十年来同样隐姓埋名潜伏于少林藏经阁中，不仅将七十二绝技抄录带回燕子坞参合庄，更在暗中窥伺列国烽烟、图谋光复大燕皇朝。慕容博的死而复生如同一记惊雷在大雄宝殿前炸开，假死面具彻底撕碎，姑苏慕容氏三十年的复国野心与阴谋诡计在天下英雄面前暴露无遗。","事件概要":"黑衣老者当众扯下面巾现出真容，赫然是三十年前已传染疾西归的姑苏慕容博，引得少林群僧骇然失色、慕容复悲哭跪拜。慕容博傲然承认当年假死遁世之计，并公然坦陈数十年来潜伏少林藏经阁盗录绝技、窥伺天下以图复兴大燕的野心，假死伪装至此彻底告破。","insert":{"慕容博":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"在群雄骇异注视下冷笑扯去遮面黑巾显露真容，受慕容复跪拜相认，当众傲然宣告昔年金蝉脱壳假死之谋，并坦承三十年来潜伏藏经阁抄录绝技以图复燕的毕生大计。"}},"慕容复":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"见冷眼旁观的黑衣老者揭面竟是亡故数十年的先父，心神剧震之下扑通跪地痛哭悲呼，在震惊与狂喜交加中聆听其揭晓假死脱身与潜伏少林的复国大谋。"}},"萧远山":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"冷眼怒视另一名曾同在藏经阁潜伏的黑衣僧人扯下面巾，见其竟是假死三十载的姑苏慕容博，心中杀机与旧恨翻涌，严阵以待其图谋。"}},"玄渡":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"惊见黑衣人扯下面巾显出早年故人慕容博的面容，震骇之下连退数步失声惊呼，难以置信这位染疾西归数十载的慕容老施主竟假死潜藏少林盗取绝技。"}},"玄生":{"人物经历":{"天龙第四十一回04-慕容博冷笑揭面暴露假死行径":"目睹扯下面巾之人确系本已死灭三十年的慕容博，心神大骇如见鬼魅，闻听其自承潜入藏经阁盗录七十二绝技与复国野心，惊怒交加戒备以对。"}}},"update":{},"后续事件":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"大雄宝殿前朔风呼啸，群雄屏息凝神，肃杀之气笼罩着整座青石广场。"},"参与人物":["慕容博","慕容复","萧远山","玄渡","玄生"]},"天龙第四十一回05-雁门血案元凶大白引两家对立":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":3,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":4,"分":0},"事件引子":"大雄宝殿前朔风呼啸，群雄屏息凝神，肃杀之气笼罩着整座青石广场。","事件详情":"慕容博的真实面目昭然若揭，三十年前酿成雁门关惨剧的万恶之源终于大白于天下。萧远山双目赤红，咬牙切齿地当众喝破慕容博当年的毒计：正是慕容博为挑起宋辽两国交兵、以便趁乱复兴大燕，居心叵测地向少林玄慈方丈假传密信，谎称契丹武士要血洗少林盗取藏经，这才引得中原二十一位武林高手在雁门关设伏截杀。玄慈方丈闻言闭目垂泪，双手合十长叹：“善哉，善哉！老衲当年轻信慕容施主之言，误杀无辜，罪孽深重！”面对玄慈的自责与全场群雄的怒视，慕容博却仰天狂笑，毫无愧悔之色，反斥成大事者不拘小节。得悉生母惨死崖底、生父跳崖残生、自己沦为孤儿且蒙冤半生的根源全系眼前之人所为，萧峰胸中怒焰滔天，周身降龙真气疯狂鼓荡，青袍无风自鼓；萧远山更是拔出随身兵刃，杀气贯顶。慕容复则拔出佩剑护在慕容博身侧，仇人相见分外眼红，萧氏与慕容氏两代人的血海深仇至此激化至万劫不复的绝境。","事件概要":"萧远山当众揭露慕容博假传契丹夺经密信、挑起雁门关惨案的复燕毒计。玄慈方丈垂泪认错悔恨误杀无辜，慕容博狂笑反唇相讥毫无悔意。得悉身世浩劫根源，萧峰父子怒发冲冠拔刃相向，慕容复按剑护父，两代世仇彻底爆发。","insert":{"玄慈":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"闻听萧远山当众痛陈当年雁门关惨案的伪信真相，心头大震、闭目垂泪，双手合十悲叹自己当年失于明察、轻信妄语而戕害无辜，悔恨难当。"}},"萧远山":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"双目赤红逼视慕容博，厉声喝破其假传契丹武士盗经密信、挑起宋辽交兵以图复燕的滔天阴谋；见仇敌狂笑无悔，怒极拔出随身兵刃，杀意贯顶。"}},"乔峰":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"乍闻三十年前生母惨死、家破人亡及自身半生孤苦蒙冤之根由全系慕容博毒计所致，悲愤交加，胸中怒焰狂涌，周身降龙真气暴涨鼓荡，誓报血海深仇。"}},"慕容博":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"面对萧远山的当众揭发与玄慈的愧疚自责，昂首仰天狂笑，非但不思悔过，反斥妇人之仁成不得大事，冷对怒发冲冠的萧氏父子，暗运真气凝神戒备。"}},"慕容复":{"人物经历":{"天龙第四十一回05-雁门血案元凶大白引两家对立":"眼见父亲昔年筹谋大白于天下招致群雄侧目，又见萧峰父子真气暴涌、杀气凛冽地逼近，当即拔出随身佩剑横身护在父亲身侧，严阵以待。"}}},"update":{},"后续事件":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"少室山广场宿怨如炽，秋风卷过寺旗，四下杀气凝滞直逼殿宇穹顶。"},"参与人物":["玄慈","萧远山","乔峰","慕容博","慕容复"]},"天龙第四十一回06-萧氏慕容两代父子广场生死斗":{"事件地点":"大宋/少室山/少林寺/大雄宝殿前广场","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":4,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":5,"分":0},"事件引子":"少室山广场宿怨如炽，秋风卷过寺旗，四下杀气凝滞直逼殿宇穹顶。","事件详情":"血海深仇引爆千钧杀机，萧峰暴喝一声率先发难，双掌划弧推出降龙廿八掌之“亢龙有悔”，雄浑无匹的刚猛掌力化作低沉龙吟，如惊涛骇浪般直拍慕容博面门。慕容博不敢撄其锋芒，足尖滑步斜掠，右手食指连弹，家传绝技“参合指”化作数道凌厉无匹的破空无形指劲，嗤嗤作响迎向排山倒海的掌风。与此同时，萧远山厉啸着合身扑向慕容复，少林般若掌挟着三十年沉淀的伏魔罡气呼啸击出，每一掌均势沉力拔。慕容复咬紧牙关，全力运转“斗转星移”借力打力之术，佩剑化作漫天银芒试图卸去刚猛掌力，然而双雄内力悬殊，剑锋触及掌风的瞬间嗡嗡剧颤，震得慕容复虎口开裂、气血翻涌。四位当世绝顶高手在少林寺广场上捉对厮杀，掌影翻飞，剑气纵横，狂暴的真气余波将广场四周数根合抱粗的寺旗巨柱连根震断，碎石泥尘冲天而起。两代父子生死相搏，招招直取要害，慕容复渐渐不支嘴角溢血，慕容博见状招式一变，急催内力护住儿子，场中杀戮陷入白热化的死斗。","事件概要":"两代血仇彻底爆发，萧峰发难施展降龙廿八掌怒拍慕容博，萧远山亦运般若掌力合身猛扑慕容复。慕容博以参合指斜掠卸劲，慕容复全力运转斗转星移却因内力悬殊震裂虎口、吐血不支。四人激战震断巨柱，慕容博急变招护子，死斗陷入白热化。","insert":{"乔峰":{"人物经历":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"为报父母血仇率先暴喝发难，双掌划弧推出降龙廿八掌之亢龙有悔，以排山倒海般的雄浑罡气直轰慕容博面门，誓杀首恶以雪三十载奇冤。"}},"慕容博":{"人物经历":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"面对萧峰威势无俦的刚猛掌力不敢正面撄锋，滑步斜掠连发参合指劲凌厉迎击；眼见复儿不敌受创喋血，当即变招急催内力飞身护子。"}},"萧远山":{"人物经历":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"趁萧峰缠斗慕容博之际厉啸扑向慕容复，催动三十年苦修的少林伏魔罡气连环拍出般若掌，以泰山压顶之势震得慕容复吐血溃退。"}},"慕容复":{"人物经历":{"天龙第四十一回06-萧氏慕容两代父子广场生死斗":"拔剑全力施展斗转星移卸化萧远山沉雄掌风，终因内力相去悬殊被狂暴罡风震裂虎口、气血翻涌，嘴角溢血渐觉抵挡不住。"}}},"update":{"慕容复":{"状态":"负伤吐血"}},"后续事件":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"少林广场尘土弥漫，四道残影破空疾驰，无形掌风与指力碎裂沿途瓦木。"},"参与人物":["乔峰","慕容博","萧远山","慕容复"]},"天龙第四十一回07-两代高手一路搏杀转战藏经阁":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":5,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":6,"分":0},"事件引子":"少林广场尘土弥漫，四道残影破空疾驰，无形掌风与指力碎裂沿途瓦木。","事件详情":"少林广场上尘土漫天，慕容博眼见慕容复在萧远山的狂攻下左支右绌、险象环生，深知萧峰掌力威猛天下第一，若在空旷平地硬拼久战必落下风。他心思电转，蓦地虚晃一指逼退萧峰，随即提气纵身，展开绝顶轻功如灰鹤般拔地而起，直向少林寺后山禁地飞遁，慕容复亦紧随其后施展身法逃遁。萧峰父子复仇心切，岂肯容仇敌脱逃？萧远山厉吼“休走”，与萧峰并肩踏碎青石腾空直追。四道绝顶身影穿房过脊，一路激战不休，劈空掌风与无形指力沿途将达摩院的红墙、罗汉堂的琉璃屋瓦与数株百年苍松尽数震得粉碎。眨眼之间，慕容博破窗撞入少林武学圣地藏经阁，萧氏父子破门而入紧咬不放。狭窄幽暗的经阁之内，四人再度短兵相接，狂暴激荡的内力将层层沉香木书架掀翻，无数佛门古籍与秘籍手抄残卷在暴烈气浪中如雪片般漫天碎裂飞舞。退路尽绝，幽闭绝地中的四位当世宗师杀红了双眼，生死存亡的惨烈决战在此一触即发。","事件概要":"慕容博见慕容复难支萧远山狂攻，虚晃逼退萧峰后纵身引向后山，慕容复紧随遁走。萧氏父子踏石疾追，四人一路穿房破瓦激战至藏经阁内。沉香木书架在暴烈罡气中倾覆碎裂，佛门秘籍漫天飞扬，幽闭绝境中两代宿怨的生死决战一触即发。","insert":{"慕容博":{"人物经历":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"深知平地硬拼久战难敌萧氏父子，遂虚晃一指逼退萧峰，携复儿提气急遁后山并破窗撞入藏经阁，借幽闭狭室与纵横书架周旋死斗。"}},"慕容复":{"人物经历":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"在萧远山压迫下险象环生，趁父亲逼退萧峰之机全力施展轻功跟随后山，破门撞进藏经阁内，背水一战拔剑与二萧在乱卷飞舞中拼死搏杀。"}},"萧远山":{"人物经历":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"见慕容博引子脱逃，厉喝一声与峰儿并肩提气疾追，一路掌裂殿宇瓦木，直撞入幽暗藏经阁内，誓要在三十年潜伏之地将大燕元凶彻底掌毙。"}},"乔峰":{"人物经历":{"天龙第四十一回07-两代高手一路搏杀转战藏经阁":"眼见杀母仇人破空遁逃，提足震碎青石紧咬不放，沿途以凌厉掌力硬撼指劲直追入藏经阁，盛怒之下催动刚猛掌风掀翻书架，誓雪血海深仇。"}}},"update":{},"后续事件":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"藏经阁内纸屑尘卷飞扬，两代四位绝顶高手倾力对轰，玉石俱焚的狂暴真气抽空周遭。"},"参与人物":["慕容博","慕容复","萧远山","乔峰"]},"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":6,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":7,"分":0},"事件引子":"藏经阁内纸屑尘卷飞扬，两代四位绝顶高手倾力对轰，玉石俱焚的狂暴真气抽空周遭。","事件详情":"藏经阁内尘卷飞扬，萧氏父子与慕容氏父子四人已然杀至癫狂境地。萧峰与萧远山催动十成内力，双龙出海般的降龙掌与般若掌蓄势待发，狂暴真气将周遭空气彻底抽空；慕容博与慕容复亦并肩立定，十指连弹凝起毕生功力的参合指剑气，生死存亡的玉石俱焚一击迫在眉睫。便在千钧一发的绝境关头，经阁最深处尘封的书架阴影中，一名身着灰布破旧僧袍的老僧手持一把光秃残破的竹帚，迈着无声轻缓的步伐缓步走出。老僧身形枯瘦如柴，面容苍老干瘪，神态却安详宁和，只低眉持帚沙沙扫地。就在四人毁天灭地的掌风指力轰然爆发、即将触及老僧身前三尺之时，一道无形的三尺气墙骤然凭空生出，狂暴绝伦的真气触之竟如泥牛入海，无声无息间化解得干干净净。四位绝顶宗师只觉胸口气血一窒，齐齐被浑厚柔和的无形巨力逼退三步，狂暴的内息瞬间归于平寂。老僧手扶竹帚合十诵佛，以超凡入圣的莫测神威，刹那间化解了这场同归于尽的武林浩劫。","事件概要":"萧氏父子与慕容氏父子在藏经阁内催动毕生内力决死对轰，千钧一发之际，一名枯瘦灰袍老僧手持残帚自阴影中缓步走出。四人毁天灭地的掌风指劲触及老僧身前三尺无形气墙，竟如泥牛入海般无声消弭，四位宗师齐被柔和巨力逼退平息内息，浩劫顿解。","insert":{"萧远山":{"人物经历":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"催动十成内力与峰儿并肩拍出般若掌决死一击，不料狂暴掌力轰至身前三尺处竟被一持帚老僧的无形气墙尽数化解，反被浑厚柔力震退三步，心头骇然惊服。"}},"乔峰":{"人物经历":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"提聚十成降龙真气欲毙大仇，掌风狂啸轰出之际，忽见灰袍老僧持残帚走出，排山倒海的刚猛掌力触及其护体气墙竟如泥牛入海，胸口微窒被柔力逼退数步。"}},"慕容博":{"人物经历":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"十指连弹凝出毕生参合指力拼死相搏，指风激射之时忽遇老僧现身，无形气墙刹那间将绝伦指劲消融殆尽并迫己后退，暗自惊骇于对方神乎其技的超凡功力。"}},"慕容复":{"人物经历":{"天龙第四十一回08-扫地老僧手持破帚现身藏经阁":"与父亲并肩倾尽残余真气击出指力，甫一出手，刚猛劲风便被一名枯瘦老僧周身气墙化解得干干净净，自身被浑厚力道反震退开数步，骇然不知所措。"}}},"update":{},"后续事件":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"},"参与人物":["萧远山","乔峰","慕容博","慕容复"]},"天龙第四十二回01-老僧现身宣讲佛法化解戾气":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":7,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":8,"分":0},"事件引子":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。","事件详情":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。","事件概要":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。","insert":{"萧远山":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}},"乔峰":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}},"慕容博":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}},"慕容复":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}},"扫地老僧":{"人物经历":{"天龙第四十二回01-老僧现身宣讲佛法化解戾气":"扫地老僧已现身止住两家对攻，接着向阁中众人讲明少林绝技须以慈悲佛理化解戾气，强练多门绝技则会积成内伤。四人听罢暂缓争斗。"}}},"update":{},"后续事件":{"天龙第四十二回02-老僧道破隐疾双雄试气骇然":"藏经阁内残帚横陈，扫地老僧目光深邃，凝视着剑拔弩张的萧远山与慕容博。"},"参与人物":["萧远山","乔峰","慕容博","慕容复","扫地老僧"]},"天龙第四十二回02-老僧道破隐疾双雄试气骇然":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":8,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":9,"分":0},"事件引子":"藏经阁内残帚横陈，扫地老僧目光深邃，凝视着剑拔弩张的萧远山与慕容博。","事件详情":"藏经阁内，扫地老僧在阐明佛法化解戾气之理后，目光平静而深邃地投向萧远山与慕容博二人。老僧言辞如炬，当面一语道破二人三十年来潜伏在少林藏经阁内强行兼练多门绝技、导致体内早已积聚下致命隐疾的惊天秘密。萧远山与慕容博闻听此言，心神剧震，面上虽强自镇定，暗中却各自暗提丹田真气，沿周天经脉飞速流转以验虚实。岂料真气甫一运转行至关隘，二人胸口与丹田处猛然传来一阵剧烈难当的撕裂刺痛，真气逆冲乱撞，痛彻骨髓，令二人身形微晃、呼吸受阻，险些难以自持。二人三十年来苦练绝技所积攒的凶煞戾气，此刻在老僧点拨下彻底发作显形。面对体内这般无法逆转的致命内伤绝症，萧远山与慕容博面色惨白、骇然失色，彻底认清了自身早已病入膏肓的严酷现实，原本不可一世的腾腾杀气顿时被无尽的惊恐与动摇所取代，阁内原本剑拔弩张的死斗局势由此产生剧烈转折。","事件概要":"扫地老僧当面道破萧远山与慕容博强练少林绝技已积下致命隐疾。二人暗提真气自验，关隘处剧痛攻心、经脉逆乱，彻底证实内伤已深入脏腑、无药可救。二人骇然失色，原本不可一世的滔天杀气化作惊恐，阁内生死搏杀之势骤生逆转。","insert":{"扫地老僧":{"人物经历":{"天龙第四十二回02-老僧道破隐疾双雄试气骇然":"面对凶悍对峙的萧远山与慕容博二人，平静道破其三十年来偷潜藏经阁强练绝技、戾气积聚致生致命暗疾之实，待二人试气受挫后温言点化执念。"}},"萧远山":{"人物经历":{"天龙第四十二回02-老僧道破隐疾双雄试气骇然":"闻听老僧一语道破自己三十年偷练少林绝技所积下的隐患，暗自提气运转周天以验虚实，不料关隘处猛遭真气逆冲、剧痛锥心，骇然发觉体内恶疾果已深入膏肓。"}},"慕容博":{"人物经历":{"天龙第四十二回02-老僧道破隐疾双雄试气骇然":"听闻老僧直指自己强练多门绝技致使周身经络潜藏致命隐疾，表面不动声色暗催真气查验，岂料真气刚至丹田胸口便剧痛如撕，面色惨白惊觉自身早已危在旦夕。"}}},"update":{"萧远山":{"状态":"内伤"},"慕容博":{"状态":"内伤"}},"后续事件":{"天龙第四十二回03-鸠摩智偷袭老僧气墙化刀劲":"藏经阁内佛法回荡、杀气初敛，暗角阴影处潜伏之人却已运劲蓄势，杀机暗涌。"},"参与人物":["扫地老僧","萧远山","慕容博"]},"天龙第四十二回03-鸠摩智偷袭老僧气墙化刀劲":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":9,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":10,"分":0},"事件引子":"藏经阁内佛法回荡、杀气初敛，暗角阴影处潜伏之人却已运劲蓄势，杀机暗涌。","事件详情":"吐蕃国师鸠摩智一直悄然潜伏于少林藏经阁暗处，窥伺良机。见老僧言谈之间震慑全场，鸠摩智既忌惮老僧莫测高深的神通，又欲彰显自身强绝武功以称霸武林，遂决定暗施辣手突袭老僧。鸠摩智屏息凝神，毫无预兆地自暗处暴起出手，运起毕生功力悍然轰出足以开山裂石、无坚不摧的少林绝技“火焰刀”，炽热霸道的无形刀劲裹挟着狂暴杀气直逼老僧后心。面对这突如其来的致命突袭，扫地老僧神色安详未变，甚至未曾回头，仅仅轻描淡写地袍袖微拂。刹那之间，老僧周身自然涌现出一股厚达三尺的无形护体真气墙。鸠摩智那开碑裂石、势不可挡的火焰刀神力重重撞击在无形气墙之上，犹如泥牛入海，没有激起半分狂澜，顷刻间便被消融得无影无踪。鸠摩智引以为傲的杀招被老僧以通天神功轻描淡写彻底化解，偷袭图谋瞬间化为泡影，全场绝顶高手皆为老僧这般鬼神莫测的护体神通而深感骇然。","事件概要":"鸠摩智潜伏于藏经阁暗处窥伺，为慑服全场并试探虚实，骤施辣手以毕生功力暗发无形火焰刀直袭老僧后心。不料老僧不闪不避亦未回身，仅拂袖间便以三尺浑厚护体气墙将至刚刀劲尽数化散融解，偷袭瞬成泡影，全场无不震骇于其通天神威。","insert":{"鸠摩智":{"人物经历":{"天龙第四十二回03-鸠摩智偷袭老僧气墙化刀劲":"潜伏阁中暗处窥伺老僧声威，为立威并除大患骤施辣手，自后方运足十成内力暗发火焰刀突袭其后心；岂料至刚劲力触及对方三尺护体真气墙竟如泥牛入海般消融殆尽，心头大骇，深忌其鬼神莫测之神通。"}},"扫地老僧":{"人物经历":{"天龙第四十二回03-鸠摩智偷袭老僧气墙化刀劲":"正立于阁中点化群雄，察觉暗处突来凌厉霸道的无形刀劲偷袭后心，神色自若未曾回身，仅微拂袍袖布下三尺护体真气墙，将狂暴劲力尽数化散无形。"}}},"update":{},"后续事件":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"藏经阁内檀香沉寂、散落书册狼藉，老僧佛法震慑之下，慕容博内伤发作、面色惨白。"},"参与人物":["扫地老僧","鸠摩智"]},"天龙第四十二回04-慕容博求死老僧击其天灵盖":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":10,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":11,"分":0},"事件引子":"藏经阁内檀香沉寂、散落书册狼藉，老僧佛法震慑之下，慕容博内伤发作、面色惨白。","事件详情":"在体内致命隐疾发作与神僧佛法的浩瀚震慑之下，慕容博深知自己当年挑起雁门关惨案罪孽深重，且身患绝症早已时日无多。但他一生执念于大燕复国大业，企图以自身的性命为筹码，当众提出愿以自身一死来换取大燕复国。然而扫地老僧闻言却只是慈悲长叹一声，宣了一声“冤冤相报何时了，阿弥陀佛”。话音未落，老僧看似轻描淡写地抬起一掌，掌势看似缓慢柔和毫无杀气，实则快逾闪电，正正击中慕容博的天灵盖！这看似轻飘飘的一掌落下，慕容博甚至未能做出任何抵挡与闪避，整个人浑身剧烈一震，顶门受击之下体内气息瞬间断绝，双眼翻白，当场颓然倒地气息断绝、陷入假死！一心筹谋复国的绝顶枭雄慕容博猝然毙命，这一惊天变故发生得快如电光石火，令一旁的萧峰与慕容复惊骇欲绝，藏经阁内的局势瞬间从博弈交锋陷入了极度的死寂与惊恐之中。","事件概要":"慕容博深知自身恶疾缠身、时日无多，遂以性命为筹码提出愿以己死换取大燕复国。扫地老僧长叹慈悲，看似轻描淡写地抬掌击中慕容博天灵盖，慕容博当场气息断绝倒地暴毙，阁内众人骇异失色。","insert":{"慕容博":{"人物经历":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"深知自身隐疾缠身且大势已去，遂当众提出以己一死换取大燕复国之诺，未料老僧悲叹声中看似轻柔的一掌快逾闪电按落顶门，不及变招闪避便觉周身剧震、真气尽绝，颓然仆地气绝。"}},"扫地老僧":{"人物经历":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"闻听慕容博执迷不悟仍欲以死作赌图谋复燕，慈悲宣佛叹惋因果，随即以柔掌拍中其天灵盖，令其陷入假死龟息。"}},"慕容复":{"人物经历":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"惊闻父亲竟欲舍命以全大燕复国之谋，尚未来得及劝阻，忽见扫地老僧轻飘飘一掌正中父亲顶门，眼睁睁看着父亲双目翻白、气绝仆地，惊骇欲绝、肝胆俱裂。"}},"乔峰":{"人物经历":{"天龙第四十二回04-慕容博求死老僧击其天灵盖":"冷眼听闻大仇慕容博甘愿舍命换取复燕图谋，正惊异戒备间，骤见扫地老僧电光石火间抬掌拍落其天灵，亲睹三十载血海深仇之元凶瞬间断气暴毙，心神剧震、骇异莫名。"}}},"update":{"慕容博":{"状态":"假死龟息"}},"后续事件":{"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":"藏经阁内书架森然，慕容博方才仆地气绝，残存掌风犹自回旋，空气中杀意与死寂交织。"},"参与人物":["慕容博","扫地老僧","乔峰","慕容复"]},"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":11,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":12,"分":0},"事件引子":"藏经阁内书架森然，慕容博方才仆地气绝，残存掌风犹自回旋，空气中杀意与死寂交织。","事件详情":"眼见慕容博瞬间毙命于老僧掌下，萧峰心头大骇，误以为这神秘老僧乃是手段狠辣、滥杀无辜之徒。为了护卫父亲周全并讨还公道，萧峰怒发冲冠，丹田内力如怒涛狂涌，奋起平生全部神力，轰出一记十成威力的“降龙廿八掌”，刚猛绝伦的霸道掌力排空而出，直击扫地老僧胸口！这一记当世至刚至强的降龙掌力结结实实轰在老僧胸膛之上，掌力澎湃雄浑，打得老僧身形剧震倒退数步，肋骨当场断裂，嘴角亦溢出殷红鲜血。然而老僧借着这股狂暴的反震之势顺势反手一掌，轻柔无匹地正中萧远山顶门。萧远山根本来不及闪避，双目一闭，同样气息断绝，重重倒地气息断绝、陷入假死！老僧虽承受萧峰至强一击受创吐血，却成功顺势击杀萧远山，使得两位纠缠三十年的宿敌在瞬息之间双双气绝倒地，阁内父子死别，场面惨烈至极。","事件概要":"见慕容博暴毙，萧峰惊怒之下催动十成降龙掌力直轰老僧胸膛，震断其肋骨并迫其吐血；老僧却借反震之势顺势反拍萧远山顶门，致其立毙当场。三十年宿敌双双倒地气绝，阁中局势骤变。","insert":{"乔峰":{"人物经历":{"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":"见慕容博猝死老僧掌下，大骇之下恐生父遭难，怒发冲冠催动平生神力轰出十成降龙掌力，虽震裂老僧肋骨迫其吐血，却惊见对方借反震之势反掌击杀父亲，心胆俱裂、悲痛欲绝。"}},"扫地老僧":{"人物经历":{"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":"承受萧峰十成威力的至刚降龙掌力直击胸膛，虽肋骨断裂受创吐血，仍借其雄浑反震之力反手一掌按落萧远山顶门，当场断其气息以解宿怨。"}},"萧远山":{"人物经历":{"天龙第四十二回05-萧峰出掌伤僧老僧顺毙远山":"见慕容博气绝与峰儿出掌，猝不及防间被受创借力的老僧轻柔一掌印上顶门，眼前发黑，重重仆地陷入假死。"}}},"update":{"萧远山":{"状态":"假死龟息"}},"后续事件":{"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":"藏经阁内弥漫着浓重的死寂与血腥，两位老者颓然仆地绝气，四壁书架在劲气余波中微颤。"},"参与人物":["乔峰","扫地老僧","萧远山"]},"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":{"事件地点":"大宋/少室山/少林寺/藏经阁","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":12,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":13,"分":0},"事件引子":"藏经阁内弥漫着浓重的死寂与血腥，两位老者颓然仆地绝气，四壁书架在劲气余波中微颤。","事件详情":"目睹至亲双双气绝倒地，萧峰与慕容复悲痛欲绝，心中的宿怨敌意瞬间被巨大的丧父之痛吞没，两人发狂般扑向各自父亲冰冷的尸身痛哭。就在二人扑至尸身旁的刹那，原本受创吐血的扫地老僧却身形微动，双手如电探出，一手提起萧远山尸身，另一手提起慕容博尸身。老僧双臂各负一人，神态从容安详，当即施展出超凡脱俗的“缩地成寸”绝顶神通。老僧身法快如鬼魅，宛若一缕青烟般轻飘飘掠出藏经阁窗棂，其绝世轻功让天下无双的萧峰与慕容复根本无从阻拦与追及。瞬息之间，老僧已负二人身躯掠过少林寺的重重殿宇屋脊，足不点地般飘然落在了少林寺后山一片清幽宁静的开阔草地之上。老僧将两具尸身平稳安置于芳草之上，彻底摆脱了阁内的纠缠纷扰，为后续施展佛门神功创造了清幽绝佳的环境。","事件概要":"目睹至亲断气，萧峰与慕容复悲痛欲绝扑尸痛哭。受创的老僧忽现缩地成寸神通，双臂各提一具尸身破窗遁走，瞬息掠过重重殿宇飞落后山草地安置，摆脱阁内纠缠。","insert":{"乔峰":{"人物经历":{"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":"扑至气绝的生父身旁悲恸痛哭，尚未回神，忽见负伤老僧身形如电掠至，一把提起父亲尸身破窗飞遁，自己惊怒之下提气追赶却不及阻拦。"}},"慕容复":{"人物经历":{"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":"眼见父亲暴毙仆地，万念俱灰扑向尸身放声号哭，惊见重伤老僧竟以鬼魅身法携走父亲遗体掠向阁外，自身仓皇追阻却被绝世轻功甩脱。"}},"扫地老僧":{"人物经历":{"天龙第四十二回06-二子悲痛扑尸老僧携尸飞遁":"趁二子扑尸痛哭之际，双手如电分别提起萧远山与慕容博身躯，施展缩地成寸身法掠出藏经阁，足踏重重屋脊飞遁至少林后山草地稳妥安置。"}}},"update":{"扫地老僧":{"所在位置":"大宋/少室山/少林寺/后山草地"},"萧远山":{"所在位置":"大宋/少室山/少林寺/后山草地"},"慕容博":{"所在位置":"大宋/少室山/少林寺/后山草地"}},"后续事件":{"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":"少林后山微风拂动幽静草木，两具假死之躯并卧草地，四下静寂无声。"},"参与人物":["乔峰","慕容复","扫地老僧"]},"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":{"事件地点":"大宋/少室山/少林寺/后山草地","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":13,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":14,"分":0},"事件引子":"少林后山微风拂动幽静草木，两具假死之躯并卧草地，四下静寂无声。","事件详情":"少林寺后山幽静草地之上，微风拂动草木，四下寂静无声。扫地老僧将萧远山与慕容博并排平放于草地之间，其先前出手击杀两人的慈悲深意终于彻底显露——唯有通过假死闭气之法，方能彻底洗髓伐毛、化解体内经络深处的宿疾。老僧神情肃穆安详，双手互按在萧远山与慕容博头顶百会穴之上，沛然运起少林无上佛门神功。醇厚纯净的佛门真气如春风化雨般源源不断灌入二人顶门，以玄妙莫测的假死龟息之法洗涤二人体内积攒了三十年的凶煞戾气与经脉剧毒。在无上佛门神功的反复冲刷与滋养下，二人受损郁结的经脉逐渐舒张平复，体内剧毒与戾气尽数消解，冰冷的体温亦渐渐回暖。片刻之后，萧远山与慕容博双双眼睫微颤，悠悠从假死状态中苏醒转来。二人只觉体内三十年的陈年顽疾尽数消融，周身经脉清爽通透，内息变得前所未有的纯正清纯。","事件概要":"扫地老僧将萧远山与慕容博并排平放于后山草地，双手互按二人顶门百会穴，沛然运起无上佛门神功。醇厚真气藉龟息假死之法洗涤冲刷二人三十年积攒的凶煞戾气与经脉剧毒。待得体内宿疾尽消、体温渐暖，萧远山与慕容博双双苏醒，周身经络通透清正，重获生机。","insert":{"扫地老僧":{"人物经历":{"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":"双手分按萧远山与慕容博顶门百会穴，沛然运转无上佛门内力，施展龟息假死之法为二人洗髓冲脉，彻底化解其体内郁积三十年的戾气宿疾与经络剧毒。"}},"萧远山":{"人物经历":{"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":"在醇厚清纯的佛门真气反复冲刷灌注下悠悠自假死中苏醒，顿觉困扰三十年的周身阴毒顽疾尽数冰消瓦解，体内经络前所未有地清爽通畅。"}},"慕容博":{"人物经历":{"天龙第四十二回07-老僧运功龟息洗尽宿疾剧毒":"承接老僧自百会穴灌入的浩瀚佛门内劲，自闭气假死之态渐次回暖苏醒，惊觉纠缠多年的致命经络暗疾已彻底荡涤无存，浑身真气变得纯正澄澈。"}}},"update":{"萧远山":{"状态":"正常"},"慕容博":{"状态":"正常"}},"后续事件":{"天龙第四十二回08-双雄顿悟前非剃度皈依佛门":"后山幽谷草地清风拂面，经历生死轮回的萧远山与慕容博缓缓起立，四目相对间旧恨化解。"},"参与人物":["扫地老僧","萧远山","慕容博"]},"天龙第四十二回08-双雄顿悟前非剃度皈依佛门":{"事件地点":"大宋/少室山/少林寺/后山草地","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":14,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":15,"分":0},"事件引子":"后山幽谷草地清风拂面，经历生死轮回的萧远山与慕容博缓缓起立，四目相对间旧恨化解。","事件详情":"历经这场从生到死、又由死转生的龟息与轮回洗礼，萧远山与慕容博恍如大梦初醒，心境发生了彻底的蜕变与升华。二人缓缓自草地上站起身来，彼此四目相对，数十年来纠缠不休的家国血仇、杀妻之恨与复国狂念，在死亡边缘真正走过一遭之后，皆化作了虚妄的过眼云烟。萧远山与慕容博相视一笑，彻底消解了心中的滔天仇怨与复国魔障。大彻大悟的当世两大绝顶高手神情虔诚肃穆，双双跪倒在扫地神僧脚下，恭敬叩首恳求剃度出家、皈依三宝。老僧面带慈悲微笑欣然受礼，当场为萧远山与慕容博摩顶受戒、剃度落发，赐予法名“圆融”，正式引渡二人皈依佛门清净之地。一代神僧以通天彻地的无上神功与广大慈悲，彻底化解了两代人的滔天世仇与武林浩劫，少林古刹与天下武林自此重归祥和安宁。","事件概要":"萧远山与慕容博经历假死轮回大梦初醒，三十年来纠缠不休的家国血仇与复国执念皆化作过眼云烟。二人相视一笑泯恩仇，双双跪倒在扫地神僧座前恳求剃度。老僧欣然应允，当场为二人摩顶受戒赐号圆融，彻底化解两代深仇宿怨。","insert":{"萧远山":{"身份":{"少林僧人":"法名圆融，皈依佛门参禅修持"},"关系网":{"慕容博":"同门同修/80"},"人物经历":{"天龙第四十二回08-双雄顿悟前非剃度皈依佛门":"自假死轮回中悠然醒转，心境空明澄澈，三十年杀妻深仇与怨毒执念皆化作过眼云烟；与对面的慕容博相视一笑泯尽仇障，肃穆跪拜扫地神僧叩求剃度，受摩顶落发赐名圆融，正式皈依佛门。"}},"慕容博":{"身份":{"少林僧人":"法名圆融，皈依佛门参禅修持"},"人物经历":{"天龙第四十二回08-双雄顿悟前非剃度皈依佛门":"死生回转之间如梦初醒，顿觉数十年复国狂念与机关算尽皆是虚妄魔障；见萧远山起身释怀而笑，自身亦彻底放下宿怨，恭敬跪倒于神僧脚下乞求出家，受老僧摩顶受戒赐号圆融。"}}},"update":{"慕容博":{"关系网":{"萧远山":"同门同修/80"}}},"后续事件":{"天龙第四十三回01-群雄聚殿开审武林公案":"大雄宝殿内戒棍森列、香烟缭绕，群雄屏息凝神，静候方丈开堂宣示三十年武林隐秘。"},"参与人物":["萧远山","慕容博"]},"天龙第四十三回01-群雄聚殿开审武林公案":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":15,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":16,"分":15},"事件引子":"大雄宝殿内戒棍森列、香烟缭绕，群雄屏息凝神，静候方丈开堂宣示三十年武林隐秘。","事件详情":"藏经阁宿世恩怨暂歇，天下各派豪杰随少林僧众移步至大雄宝殿前。法堂阶下人头攒动，玄慈方丈身披袈裟、端坐正中法椅，戒律院达摩院众僧各执戒棍分列两厢，法度森严。群雄低声议论，急欲探究三十年武林隐秘。正当玄慈合十垂目、欲开堂宣谕之际，殿外忽起急促破风之声。值守武僧厉声喝阻，手中熟铜棍呼啸合围，来人却全然不顾自身安危，如疯虎般合身硬撞。只听得“砰砰”两声闷响，两名武僧受巨力反震踉跄退开，一道青黑身影跌撞冲入殿中，正是四大恶人之二的叶二娘。她披头散发，面上泪痕与血渍交错，怀中死死攥着一件残破的婴孩旧襁褓，双眼布满血丝，在殿内众僧脸上疯狂梭巡，厉声尖啸逼问当年抢走婴儿的蒙面黑衣人所在。面对突如其来的闯殿之举，玄慈拨动念珠的枯指骤然一僵，殿内群雄纷纷按剑拔刀、严阵以待。叶二娘踉跄摔扑在冰冷石阶上，怀中婴儿旧物‘长命百岁’银锁滑落，在空旷大殿中砸出刺耳脆响。少林戒律威严瞬间被撕裂，一桩尘封二十四载的佛门孽案在大殿中心正式揭开序幕。","事件概要":"群雄齐聚大雄宝殿，静候玄慈开堂宣谕以决武林公案。未料叶二娘癫狂闯殿、合身撞开值守武僧，怀抱残破襁褓厉声逼问夺子元凶，长命百岁银锁随之震落阶前。佛门戒律威严骤然被破，一桩尘封二十四载的孽案随之揭开帷幕。","insert":{"玄慈":{"人物经历":{"天龙第四十三回01-群雄聚殿开审武林公案":"端坐大雄宝殿法椅正欲开堂宣谕，忽见叶二娘披发浴血撞退武僧直冲殿内，待见其失手跌落的长命银锁与残破襁褓，拨弄念珠的枯指骤僵，心知深埋二十余年的旧孽因果终已临头。"}},"叶二娘":{"人物经历":{"天龙第四十三回01-群雄聚殿开审武林公案":"全然不顾少林武僧棍阵阻拦，拼死撞入大雄宝殿，紧抱残破襁褓在众僧面孔间狂乱梭巡，摔跌于冷硬石阶上致使贴身银锁坠地，满含血泪厉声尖啸逼问当年夺走爱子的黑衣人下落。"}}},"update":{},"后续事件":{"天龙第四十三回02-虚竹验明戒疤母子相认":"大雄宝殿内戒备森严，群雄屏息凝神，行刑僧按棍肃立两侧，殿内气氛压抑如铁。"},"参与人物":["玄慈"]},"天龙第四十三回02-虚竹验明戒疤母子相认":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":16,"分":15},"事件结束时间":{"年":1203,"月":6,"日":21,"时":17,"分":30},"事件引子":"大雄宝殿内戒备森严，群雄屏息凝神，行刑僧按棍肃立两侧，殿内气氛压抑如铁。","事件详情":"萧远山在藏经阁抛出的身世线索直指少林，戒律院首座当即下令当堂查验虚竹身躯以正视听。虚竹面色煞白，双手连连摆动，口中急切分辩：“小僧自幼在寺中剃度，绝非恶人之子！”然而两名行刑僧不由分说跨步上前，反剪其臂，当众褪去虚竹身上的粗布僧袍与中单。众目睽睽之下，虚竹后背及两股之间赫然显露出九处呈梅花状排列的自幼灼烙香疤，痕迹焦深。叶二娘见状浑身剧震，发出撕心裂肺的悲鸣，踉跄扑倒在虚竹脚边。她颤抖着双手抚摸那些凹凸不平的疤痕，指尖因极度激动而泛白，旋即自怀中掏出珍藏二十四年的半截染血襁褓，比对之下，襁褓破损处的焦痕与虚竹背上戒疤严丝合缝。叶二娘再无半分疑虑，一把将木雕泥塑般的虚竹死死抱入怀中，热泪滚落打湿其裸背。虚竹脑中一片空白，浑身僵直，合十的双手无力垂落，僧衣委顿在地。群雄目睹这铁证如山的骨肉相认，大殿四周顿时爆发出一片惊叹与窃窃私语，虚竹二十四年来作为少林孤儿的清白身世在此刻彻底颠覆。","事件概要":"少林戒律院当众褪去虚竹僧袍查验身躯，其背部九处梅花焦痕戒疤赫然显露。叶二娘见状悲鸣扑出，取出珍藏二十四年的残破襁褓严密比对，确认虚竹即为当年被盗亲子并相拥痛哭。群雄皆惊，虚竹二十余年的孤儿身世由此真相大白。","insert":{"叶二娘":{"关系网":{"虚竹":"亲子/100"},"人物经历":{"天龙第四十三回02-虚竹验明戒疤母子相认":"见僧人当众褪去虚竹衣衫露出背脊九处梅花戒疤，心头巨震抢步扑倒其脚下，取出珍藏多年的染血残破襁褓严丝合缝对齐焦痕，再无疑虑死死抱住亲儿放声恸哭。"}},"虚竹":{"关系网":{"叶二娘":"生母/80"},"人物经历":{"天龙第四十三回02-虚竹验明戒疤母子相认":"面对戒律院查验百般分辩自幼清白未果，被行刑僧强行反剪双臂褪去僧袍露出背股戒疤；骤见叶二娘持残襁哭扑而来抱住自身相认，满心惊骇慌乱、手足无措僵立当场。"}}},"update":{},"后续事件":{"天龙第四十三回03-玄慈当众坦承破戒生子":"大雄宝殿内群情鼎沸，各派豪杰厉声逼问虚竹生父，禅台前肃穆沉郁，风波骤起。"},"参与人物":["虚竹","叶二娘"]},"天龙第四十三回03-玄慈当众坦承破戒生子":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":17,"分":30},"事件结束时间":{"年":1203,"月":6,"日":21,"时":18,"分":45},"事件引子":"大雄宝殿内群情鼎沸，各派豪杰厉声逼问虚竹生父，禅台前肃穆沉郁，风波骤起。","事件详情":"母子相认引得大雄宝殿内群情激愤，丐帮长老与各派豪杰纷纷按捺不住，指着叶二娘厉声逼问：“这小和尚的生父究竟是哪个少林贼秃？还不快快招来！”叶二娘紧咬牙关，将虚竹护在身后，宁死不吐半字。面对满堂汹涌的质询与唾骂，端坐法台正中的玄慈方丈缓缓合上双目，面容悲悯而释然。沉寂片刻后，他口中长宣一声佛号：“阿弥陀佛！”沛然纯阳内力如暮鼓晨钟激荡开来，瞬间将大殿内嘈杂的人声强行压制。在全寺僧众惊骇的目光中，玄慈毅然起身，亲手解下象征少林至高法统的锦斓袈裟，郑重递交到身旁戒律院首座手中。随后他缓步走下台阶，面向阶下数千武林英豪深深合十稽首，朗声说道：“既造如是因，当受如是果。虚竹的生父并非旁人，正是老衲玄慈。二十四年前老衲犯下根本淫戒，贻害无穷，今日当向天下谢罪。”言罢，玄慈躬身垂首。此言如平地炸雷，殿内群雄惊得瞠目结舌，少林众僧尽皆面如死灰，一代佛门领袖当众卸下法衣自承破戒，神圣威望刹那间荡然无存。","事件概要":"大雄宝殿内群雄激愤逼问虚竹生父，叶二娘誓死护子不吐一字。玄慈长宣佛号以纯阳内力震慑喧嚣，毅然解下象征法统的锦斓袈裟，步下石阶当众坦承二十四年前犯戒生下虚竹并向天下谢罪，满殿震骇。","insert":{"叶二娘":{"人物经历":{"天龙第四十三回03-玄慈当众坦承破戒生子":"面对满堂群雄唾骂逼问生父，紧咬牙关将虚竹死死护在身后宁死不言；忽闻玄慈长宣佛号当众解下袈裟承认真相，心神俱震、悲喜交加间泪如雨下。"},"关系网":{"玄慈":"昔日情郎/90"}},"玄慈":{"人物经历":{"天龙第四十三回03-玄慈当众坦承破戒生子":"端坐法台闭目宣号以深厚内力压制喧嚣，毅然解下锦斓袈裟移交戒律院首座，步下石阶面向数千群雄合十躬身，坦承二十四年前犯下根本淫戒且虚竹实为己出，当众向天下谢罪。"},"关系网":{"虚竹":"亲子/85","叶二娘":"昔日孽缘/60"}},"虚竹":{"人物经历":{"天龙第四十三回03-玄慈当众坦承破戒生子":"僵立殿阶下被生母护在身后承受群雄叱骂，突见素来敬仰的方丈大师卸下袈裟缓步走下法台，朗声承认乃是自己生父并垂首谢罪，心神如遭五雷轰顶、惊骇万分。"}}},"update":{"玄慈":{"外貌":"年过花甲的高僧，面容庄严慈和，身材魁伟方正，颌下飘银髯，已卸下大红锦缎袈裟，身着缁色布袍。"},"虚竹":{"关系网":{"玄慈":"生父/85"}}},"后续事件":{"天龙第四十三回04-玄慈自承雁门关带头大哥":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。"},"参与人物":["叶二娘","玄慈","虚竹"]},"天龙第四十三回04-玄慈自承雁门关带头大哥":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":18,"分":45},"事件结束时间":{"年":1203,"月":6,"日":21,"时":20,"分":0},"事件引子":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。","事件详情":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。","事件概要":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。","insert":{"玄慈":{"人物经历":{"天龙第四十三回04-玄慈自承雁门关带头大哥":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。"}},"萧远山":{"人物经历":{"天龙第四十三回04-玄慈自承雁门关带头大哥":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。"}},"乔峰":{"人物经历":{"天龙第四十三回04-玄慈自承雁门关带头大哥":"已皈依佛门的萧远山在殿中平静作证，讲述雁门关旧案与妻子遇害。玄慈面对群雄承认受慕容博假消息误导，召集中原豪杰设伏，并坦然认下带头大哥的责任。萧峰听完父亲证言，沉痛注视玄慈；旧案由此得到当众确认。"}}},"update":{},"后续事件":{"天龙第四十三回05-玄慈肉身受杖二百重刑":"大殿内执法僧铁杖森然伫立，玄慈坦然解衣跌坐青石，满堂群雄屏息凝视。"},"参与人物":["玄慈","萧远山","乔峰"]},"天龙第四十三回05-玄慈肉身受杖二百重刑":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":20,"分":0},"事件结束时间":{"年":1203,"月":6,"日":21,"时":21,"分":15},"事件引子":"大殿内执法僧铁杖森然伫立，玄慈坦然解衣跌坐青石，满堂群雄屏息凝视。","事件详情":"认下双重罪业后，玄慈神色决然，面向戒律院首座肃容道：“国有国法，寺有寺规。老衲破戒犯僧律、妄造杀业，请依寺规施以重刑，以正少林清规！”戒律院首座含泪宣判杖责二百。四名身形魁梧的执法僧手持数十斤重的粗大铁木刑杖大步出列。玄慈坦然褪去上衣，盘膝垂目端坐于大殿冰冷青石上，主动散去丹田内的护体纯阳真气，纯以血肉残躯受刑。刑杖挟着凌厉破空风声重重砸落，只听得沉闷的“砰！砰！”击打声响彻法堂。初时数十杖下去，玄慈脊背皮肉撕裂、紫涨充血；行至百杖，衣衫碎屑与血沫横飞，鲜血顺着脊梁汩汩流淌，将地面青石染得触目惊心。玄慈面色惨白如纸，唇角溢血，身形虽因剧痛剧烈颤抖，却咬紧牙关始终不发一声痛呼，亦不调动半丝内力御伤。叶二娘与虚竹撕心裂肺地哭喊着欲上前阻拦，却被执法僧以长棍死死架住。二百重杖实打实地行刑完毕，刑杖前端已被鲜血浸透，玄慈脊背血肉模糊、重伤濒死，以最惨烈的皮肉之苦全了佛门戒律的森严威仪。","事件概要":"玄慈主动依律请罚，散去护体真气纯以肉身硬受戒律院二百重刑。行刑铁杖击碎皮肉、血染青石，叶二娘与虚竹号哭扑救遭僧棍阻隔。玄慈咬牙受尽酷刑濒死，以残躯恪守少林戒律威仪。","insert":{"叶二娘":{"人物经历":{"天龙第四十三回05-玄慈肉身受杖二百重刑":"见玄慈褪衣散去真气甘受严刑，眼睁睁看重杖击碎其背脊皮肉、鲜血横流，撕心裂肺哭喊着欲扑上前阻拦，却被执法僧以长棍死死架隔。"}},"玄慈":{"人物经历":{"天龙第四十三回05-玄慈肉身受杖二百重刑":"为正寺规坦然散尽护体纯阳真气，盘坐石地纯以肉身承受戒律院二百刑杖，任由皮开肉绽、鲜血流淌，咬紧牙关不运内力亦不哼一声。"}},"虚竹":{"人物经历":{"天龙第四十三回05-玄慈肉身受杖二百重刑":"骤见方才认下的生父褪衣受戮，二百铁杖重砸之下血肉横飞、重伤垂危，悲恸欲绝哭号抢步上前阻拦，却被执法僧结阵棍棒严密架退。"}}},"update":{"玄慈":{"状态":"濒死"}},"后续事件":{"天龙第四十三回06-玄慈震断心脉含笑圆寂":"大雄宝殿内鸦雀无声，二百刑杖方毕，受刑台前血渍犹存，群雄屏息静默。"},"参与人物":["玄慈","叶二娘","虚竹"]},"天龙第四十三回06-玄慈震断心脉含笑圆寂":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":21,"分":15},"事件结束时间":{"年":1203,"月":6,"日":21,"时":22,"分":30},"事件引子":"大雄宝殿内鸦雀无声，二百刑杖方毕，受刑台前血渍犹存，群雄屏息静默。","事件详情":"受刑完毕，玄慈已是气若游丝，但他深知皮肉之苦仅能偿还寺规，唯有以死谢天下方能洗雪少林之耻、化解萧氏父子三十年的刻骨血仇。在大雄宝殿满堂群雄的屏息注视下，玄慈用尽残存力气强行端正坐姿，双腿盘结，面容重归平静祥和。虚竹泪流满面地扑到身前，颤抖着握住父亲冰凉的手掌；玄慈垂目凝视虚竹，眼中流露出深沉的慈爱与歉疚，随后缓缓将双手合十于胸前。他暗中调动丹田内仅存的一股精纯少林九阳真气，毫不犹豫地倒灌逆行，向着自身心脉猛然一撞！只听得其胸腔内传出一声细微的骨骼闷响，强劲内力瞬间将周身心脉尽数震断。玄慈面色骤然红润如霞，旋即转为蜡白，嘴角浮现出一抹彻底解脱与慈悲的含笑之意，头颅微低，当堂断气圆寂。少林寺内顿时钟磬齐鸣，众僧齐齐合十跪拜、诵念《往生咒》，满堂武林豪杰皆被其自断心脉以命偿罪的气魄所震慑。三十年‘带头大哥’的恩怨纠葛，随同这位少林方丈的生机断绝彻底画上休止符。","事件概要":"受刑已毕的玄慈为雪佛门之耻并消弭三十年血仇，在大雄宝殿内毅然端坐合十，暗催残存九阳真气倒灌震断自身心脉。他在虚竹泪眼注视下含笑圆寂，众僧齐跪诵念往生咒，满堂豪杰尽皆耸然动容。","insert":{"玄慈":{"人物经历":{"天龙第四十三回06-玄慈震断心脉含笑圆寂":"深知唯有以死谢罪方能洗雪少林名誉并化解萧氏血仇，于虚竹握手垂泪之际端正盘坐，调动残存少林九阳真气逆冲心脉自尽，心脉尽断之际含笑圆寂。"}},"虚竹":{"人物经历":{"天龙第四十三回06-玄慈震断心脉含笑圆寂":"见生父受刑后气若游丝，悲恸万分扑上前紧握其冰凉双手，却惊觉父亲双手合十暗催内力自断心脉，眼见生父嘴角含笑当堂断气，悲痛欲绝。"}}},"update":{"玄慈":{"状态":"死亡"},"玄寂":{"身份":{"少林寺方丈":"玄慈圆寂后继任少林寺方丈，主持寺务"}}},"后续事件":{"天龙第四十三回07-叶二娘拔刀自刎殉情而死":"大雄宝殿内玄慈气绝倒地，满堂僧俗惊呼未歇，空气中弥漫着浓重的血腥与沉寂。"},"参与人物":["玄慈","虚竹"],"delete":{"玄慈":{"身份":{"少林寺方丈":{}}},"玄寂":{"身份":{"少林寺戒律院首座":{}}}}},"天龙第四十三回07-叶二娘拔刀自刎殉情而死":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":22,"分":30},"事件结束时间":{"年":1203,"月":6,"日":21,"时":23,"分":45},"事件引子":"大雄宝殿内玄慈气绝倒地，满堂僧俗惊呼未歇，空气中弥漫着浓重的血腥与沉寂。","事件详情":"目睹玄慈震断心脉气绝倒下，叶二娘发出一声凄厉至极的啼哭，整个人疯了般扑倒在玄慈遗体之上。二十四载的相思煎熬与苦寻，未曾想骨肉重逢之日竟是与夫君永诀之时。叶二娘抚摸着玄慈尚有余温的面颊，万念俱灰，眼中疯狂之色尽褪，唯余无限温柔与死志。她转过头，泪眼婆娑地深深看了虚竹最后一眼，凄声呜咽道：“好孩子，娘苦了你二十四年，可你爹爹一个人在黄泉路上太苦，娘得去陪他！”言罢，她右手快如闪电般自腰间皮鞘中拔出一柄薄如柳叶的精钢短刀。虚竹惊骇欲绝，急呼“娘亲”并纵身伸手抓向刀背，殿旁数名少林高僧亦飞身施救。然而叶二娘死意决绝，反手横刃，内力催动下刀锋化作一道雪白匹练，狠绝地割裂自身咽喉。动脉断裂，一股猩红鲜血激喷而出，染红了玄慈胸前的灰白僧袍。精钢短刀当啷坠地，叶二娘软软倒在玄慈怀中，合目气绝。四大恶人中作恶多端的‘无恶不作’，终以血刃割喉自殉，同玄慈交叠瞑目于少林大殿之上。","事件概要":"目睹玄慈圆寂，叶二娘万念俱灰扑倒在其遗体上，抚尸痛哭。二十四载相思化作同穴死志，她在凄声别过骨肉虚竹后，断然拔出精钢短刀狠绝自刎。少林众僧与虚竹抢救未及，叶二娘割喉绝命，倒在玄慈怀中合目同殉。","insert":{"叶二娘":{"人物经历":{"天龙第四十三回07-叶二娘拔刀自刎殉情而死":"目睹玄慈散功绝命，万念俱灰下扑倒在其遗体上痛哭，深感相思二十余载终难相守，决意殉情相伴；凄声别过亲儿虚竹后，迅即拔出腰间柳叶短刀狠绝割喉，伏在玄慈怀中闭目同殉。"}},"虚竹":{"人物经历":{"天龙第四十三回07-叶二娘拔刀自刎殉情而死":"见生父刚逝、生母复悲呼拔刀欲殉，大骇之下急呼抢步抓向刀背施救，奈何慢了一瞬，眼睁睁看着母亲挥刀割裂咽喉、血溅父身倒地气绝，悲痛万分。"}}},"update":{"叶二娘":{"状态":"死亡"}},"后续事件":{"天龙第四十三回08-虚竹痛失双亲悲恸昏厥":"大雄宝殿内血腥刺鼻，玄慈与叶二娘相继绝命陈尸，满堂群雄肃然噤声，殿内死寂如铁。"},"参与人物":["叶二娘","虚竹"]},"天龙第四十三回08-虚竹痛失双亲悲恸昏厥":{"事件地点":"大宋/少室山/少林寺/大雄宝殿","触发条件":{"类型":"时间","年":1203,"月":6,"日":21,"时":23,"分":45},"事件结束时间":{"年":1203,"月":6,"日":22,"时":1,"分":0},"事件引子":"大雄宝殿内血腥刺鼻，玄慈与叶二娘相继绝命陈尸，满堂群雄肃然噤声，殿内死寂如铁。","事件详情":"大雄宝殿之内血腥弥漫，虚竹在短短一个时辰内经历了身世大白与双亲暴毙的人间至痛。他跪倒在血泊之中，左手死死揽住玄慈冰硬的遗体，右手拼命按住叶二娘鲜血狂涌的颈间伤口，泪如雨下，状若疯魔。虚竹急运体内逍遥派深厚精纯的北冥真气，疯狂灌入父母经脉之中妄图起死回生。然而双亲心脉已碎、咽喉断绝，雄浑真气如泥牛入海毫无回音。面对两具冰冷交叠的至亲尸身，虚竹万念俱灰，仰天发出撕心裂肺的绝望哀嚎：“爹！娘！小僧才刚知道你们是谁，为何要弃我而去啊！”极度的悲恸与暴冲的内力在体内激荡反噬，虚竹气血逆行攻心，面色由惨白转为紫金，蓦地仰天喷出一大口殷红鲜血。他眼前骤然漆黑，身躯晃了晃，脱力栽倒在父母的血衣遗体之上昏死过去。段誉与灵鹫宫梅兰竹菊诸女惊呼抢上，急忙点穴护住其心脉并抬下救治。满堂群雄与少林众僧见此惨状无不扼腕叹息，三十年牵动武林风云的恩怨情仇，终在这场白发人送黑发人、骨肉同归于尽的血色残局中惨烈落幕。","事件概要":"虚竹痛失双亲悲恸狂乱，跪伏血泊中疯狂灌输北冥真气妄图救活父母，却回天乏术。万念俱灰之下他仰天绝望哀嚎，体内暴冲内力反噬攻心，当堂狂喷鲜血脱力昏厥，终由段誉抢上点穴护住心脉并抬下救治，惨烈残局至此落幕。","insert":{"虚竹":{"人物经历":{"天龙第四十三回08-虚竹痛失双亲悲恸昏厥":"跪倒在双亲冰冷遗体间泪如雨下，拼命调动体内深厚北冥真气疯狂灌入二老体内妄图起死回生；见真气石沉大海、双亲绝命不还，万念俱灰下仰天发出绝望凄号，终致气血暴冲反噬心脉，仰天喷血脱力昏厥过去。"}},"段誉":{"人物经历":{"天龙第四十三回08-虚竹痛失双亲悲恸昏厥":"忽见二哥因双亲暴毙发出撕心裂肺的绝望哀嚎，旋即狂喷鲜血脱力栽倒在血泊中昏死过去，惊骇欲绝之下抢步冲上前去，急展内力点穴护住其心脉并协助众人将其抬下救治。"}}},"update":{"虚竹":{"状态":"气血反噬昏厥"}},"后续事件":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"少林寺山门外残阳如血，群雄散尽古刹凄清，灵鹫宫九部侍女与铁骑肃立待命。"},"参与人物":["虚竹"]},"天龙第四十四回00-人物登场":{"事件类型":"登场事件","所属回目":"第四十四回","触发条件":{"类型":"时间","年":1203,"月":6,"日":24,"时":16,"分":0},"新登场人物":["余婆","符敏仪"],"insert":{"余婆":{"性别":"女","外貌":"年约五六十岁，面容端肃沉稳，鬓发微白，身着深色布袍，身形矫健沉着。","性格":"沉稳老练，御下严明，忠心耿耿","境界":"二流-中期","初始属性":{"臂力":6,"根骨":8,"机敏":7,"洞察":13,"悟性":6},"出生年份":1148,"状态":"健康","所在位置":"大宋/少室山/少林寺/山门外","身份":{"灵鹫宫昊天部首领":"统领"},"功法":{"天山折梅手":{"掌握程度":"略有小成"},"天山六阳掌":{"掌握程度":"略有小成"}},"重要物品":{},"人物经历":{},"关系网":{"虚竹":"尊主/95","符敏仪":"同僚/80"}},"符敏仪":{"性别":"女","外貌":"三十余岁年纪，容貌清秀端正，身着葱绿色长衫，腰悬长剑，指法灵巧。","性格":"精明利落，手巧心细，忠贞不二","境界":"二流-中期","初始属性":{"臂力":4,"根骨":7,"机敏":14,"洞察":9,"悟性":7},"出生年份":1170,"状态":"健康","所在位置":"大宋/少室山/少林寺/山门外","身份":{"灵鹫宫阳天部首领":"统领"},"功法":{"天山折梅手":{"掌握程度":"略有小成"}},"重要物品":{},"人物经历":{"天龙第四十四回00-人物登场":"原“针法暗器”（炉火纯青）缺乏飞针暗器对敌的原著证据。原著称符敏仪为“针神”，所示本领是缝制衣袍；因此保留为针线女红经历，不作为战斗功法，也不误归为“金匮针法”等医疗针术。"},"关系网":{"虚竹":"尊主/95","余婆":"同僚/80"}}}},"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":{"事件地点":"大宋/少室山/少林寺/山门外","触发条件":{"类型":"时间","年":1203,"月":6,"日":24,"时":16,"分":0},"事件结束时间":{"年":1203,"月":6,"日":24,"时":22,"分":0},"事件引子":"少林寺山门外残阳如血，群雄散尽古刹凄清，灵鹫宫九部侍女与铁骑肃立待命。","事件详情":"少室山少林寺外残阳如血，中原群雄散尽，古刹前一片凄清。玄慈自受杖刑圆寂、叶二娘殉情自戕，虚竹身世大白却骤失双亲，悲恸难抑，但他谨记父母临终前教其立身从善的嘱托，决意收敛心神承担起灵鹫宫尊主重任。启程前，结义大哥萧峰因自知未必能再返丐帮，专程于少室山门外将打狗棒法要诀逐招传予虚竹，并与其研讨降龙廿八掌的运劲变化，删并繁复而威力重复的末十式，凝成日后传世的降龙十八掌，嘱虚竹代授继任帮主。虚竹以逍遥派修为和悟性将两门武学学得纯熟，郑重接下托付；萧峰则保留这套精炼后的十八掌自身所学。虚竹强忍泪水向少林山门三叩首，转身步至山下阵前。九天九部侍女及附属部众黑压压肃立待命，余婆与符敏仪率众躬身抱拳：“请尊主示下！”段誉见虚竹面带戚容，快步上前扶住其臂膀温言道：“二哥莫忧，小弟愿率大理随从伴兄西行。”虚竹心中感念，合十还礼。面对前路茫茫，虚竹毅然斩断徘徊，接过符敏仪双手呈上的七宝灵鹫令符与随身佩剑，翻身上马下达拔营号令。灵鹫宫九部众刀剑归鞘、严整结阵护卫两侧，段誉引大理铁骑随行相顾，车马辎重齐备，浩浩荡荡踏上远离中原、迢迢西赴天山缥缈峰之路，确立了虚竹统领缥缈峰的全新格局。","事件概要":"临别前萧峰将打狗棒法传予虚竹，二人将降龙廿八掌去繁成十八掌，托虚竹代传丐帮；双亲骤逝后虚竹谨遵父母遗言，收敛悲恸决意担负尊主重任。他向少林寺山门三叩首辞别祖庭，于阵前接过灵鹫令符与佩剑，在三弟段誉引大理铁骑相伴随行下，下令拔营率部众浩浩荡荡西赴天山。","insert":{"虚竹":{"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"临别前受萧峰传授打狗棒法，二人共研廿八掌删繁为十八掌，受其托付代传丐帮；强忍丧亲剧痛谨记父母从善遗言，面向少林山门含泪三叩首拜别祖庭；步至山前接过符敏仪呈递的灵鹫令符与佩剑，感激三弟段誉护送之谊，翻身上马下令拔营启程西赴天山。"},"重要物品":{"七宝灵鹫令符":"符敏仪所呈递的灵鹫宫九天九部尊主令符"},"功法":{"降龙十八掌":{"掌握程度":"融会贯通（少室山临别时与萧峰共研降龙廿八掌，删并末十式后学得传承）"},"打狗棒法":{"掌握程度":"融会贯通（临别时萧峰亲授，受托将来代传丐帮继任帮主）"}}},"段誉":{"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"见二哥神情戚容悲戚难抑，快步上前扶住其臂膀温言抚慰，主动引大理随行铁骑随军护持，与灵鹫宫部众结阵并肩踏上西行之途。"}},"余婆":{"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"率昊天部及各部属众在少室山门前整肃列阵，恭迎尊主出山抱拳请示，待号令一下即指挥部众收刀归鞘、结阵护卫启程西进。"}},"符敏仪":{"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"随余婆肃立阵前护驾，待尊主虚竹步至阵前，双手恭敬呈上七宝灵鹫令符与佩剑，随后整饬部属随行护驾踏上西赴缥缈峰之路。"}},"乔峰":{"功法":{"降龙十八掌":{"掌握程度":"出神入化（与虚竹共同精简降龙廿八掌，形成十八掌传世版本）"}},"人物经历":{"天龙第四十四回01-虚竹遵遗愿率部众西赴天山":"少室山惜别前亲授虚竹打狗棒法，并与二弟删繁为降龙十八掌，嘱其日后代传丐帮新主；从此将毕生所学降龙廿八掌归整为传世十八掌。"}}},"update":{"虚竹":{"状态":"悲痛隐忍"}},"后续事件":{"天龙第四十四回02-阿紫换眼复明嫌丑弃游坦之":"僻静草堂内弥漫着浓烈血腥与刺鼻药香，染血白纱散落狼藉，案头锋刃银针泛着森森寒芒。"},"参与人物":["虚竹","段誉","余婆","符敏仪","乔峰"],"delete":{"乔峰":{"功法":{"降龙廿八掌":{}}}}},"天龙第四十四回02-阿紫换眼复明嫌丑弃游坦之":{"事件地点":"大宋/少室山/荒山草堂","触发条件":{"类型":"时间","年":1203,"月":6,"日":25,"时":8,"分":0},"事件结束时间":{"年":1203,"月":6,"日":25,"时":14,"分":0},"事件引子":"僻静草堂内弥漫着浓烈血腥与刺鼻药香，染血白纱散落狼藉，案头锋刃银针泛着森森寒芒。","事件详情":"僻静荒山草堂之中，药香混杂着浓烈血腥。阎王敌薛神医施展移目接脉秘术，替失明的阿紫缝合完毕。游坦之双腿早被震断，此番自愿忍受生挖眼珠的钻心之痛献出双目，瘫在榻下血水里虚弱喘息。随着薛神医剪开重重白纱，阿紫眼界骤然大放光明，她抚摸双眼欣喜若狂地娇笑跳起。游坦之听闻笑语，凭借残存双臂在碎石泥泞中艰难爬向阿紫，带血的手指试图触碰其裙角，颤声乞怜：“阿紫姑娘……你看见了吗？这是我的眼睛……”阿紫垂首看清眼前之人：游坦之面容被铁面毁损狰狞如鬼，眼眶只剩两个乌黑淌血的空洞，双腿瘫软如泥。阿紫毫无半分怜惜与感激，反觉恶寒彻骨，尖叫着运足内力飞起一脚狠狠踹在游坦之胸口，厉斥：“滚开！哪来的丑怪怪物，莫弄脏了本姑娘的衣裳！”游坦之重创之下肋骨断裂、狂喷鲜血倒飞数尺。薛神医递上的止血药膏被阿紫扬手打翻，阿紫整肃衣衫绝情拂袖而去，将双目尽盲、瘫痪残喘且身负内伤的游坦之弃于荒山冰冷泥泞中。","事件概要":"薛神医施移目接脉秘术，将游坦之双眼缝予阿紫。阿紫解开眼纱重见光明，正狂喜娇笑间，见双目剜空、面容毁损如鬼且双腿残疾的游坦之爬来攀扯相认。阿紫心生恶寒嫌弃，运足内力飞起一脚踢断其肋骨，绝情拂袖而去，将重创残喘的游坦之弃于荒山泥泞血泊中。","insert":{"阿紫":{"人物经历":{"天龙第四十四回02-阿紫换眼复明嫌丑弃游坦之":"在荒山草堂内承接移目接脉秘术，剪去层层白纱后双目骤然大放光明，重见天日喜不自胜；垂首见一双眼流血空洞、容颜如恶鬼且双腿瘫软的丑怪爬来触碰裙角相认，只觉恶寒彻骨，愤而运足内力一脚将其踹断肋骨吐血震飞，拂袖绝情离去。"}},"游坦之":{"人物经历":{"天龙第四十四回02-阿紫换眼复明嫌丑弃游坦之":"自愿忍受生挖眼珠之奇痛将双目献予阿紫，双腿早折瘫卧在榻下血水残喘；听闻阿紫复明笑语，拼尽残力在泥泞碎石中爬向对方试图触碰裙角表白，未料反被其厌恶斥为丑怪，更遭其凌厉一脚踢断胸口肋骨喷血倒飞，惨遭彻底抛弃于荒山寒泞。"}}},"update":{"阿紫":{"外貌":"约十五六岁年纪，身穿紫色衣衫，身形娇小，一张瓜子脸，双眸清亮复明且灵动有神","状态":"正常","关系网":{"游坦之":"嫌恶抛弃/-20"}},"游坦之":{"外貌":"身形消瘦单薄，面容受铁具毁损狰狞如鬼，眼眶化为两个乌黑淌血空洞，浑身血污泥泞","状态":"濒死（双目失明、双腿骨折、肋骨断裂）"}},"后续事件":{"天龙第四十四回03-游坦之万念俱灰跳崖自尽":"荒山绝顶狂风厉啸，刺骨寒雨倾泻，断崖边泥泞血迹蜿蜒伸向万丈迷雾。"},"参与人物":["阿紫","游坦之"]},"天龙第四十四回03-游坦之万念俱灰跳崖自尽":{"事件地点":"大宋/少室山/少室绝顶","触发条件":{"类型":"时间","年":1203,"月":6,"日":25,"时":14,"分":0},"事件结束时间":{"年":1203,"月":6,"日":25,"时":15,"分":0},"事件引子":"荒山绝顶狂风厉啸，刺骨寒雨倾泻，断崖边泥泞血迹蜿蜒伸向万丈迷雾。","事件详情":"荒山绝顶狂风厉啸，刺骨寒雨漫天倾泻。游坦之双目已剜、双腿尽断且胸骨碎裂，瘫卧在血泥碎石中。他为阿紫倾尽毕生骨血与光明，换来的却只有嫌恶辱骂与绝情弃置，心中最后一丝苟活执念轰然崩塌，万念俱灰只求一死。在无边黑暗与剧痛中，游坦之不再哀嚎，而是咬碎牙关，凭借残存双臂将十指如鹰爪般狠狠抠入坚硬岩缝，拖着毫无知觉的残废下肢向悬崖边缘艰难爬行。嶙峋怪石划破其胸腹，指甲尽数崩裂翻卷，在荒崖泥径上拖曳出一条十余丈长的触目惊心血痕。风声愈发凄厉，游坦之血肉模糊的右手掌心终于探出岩台、抓入一片虚无。感知到下方深不可测的万丈渊薮，游坦之惨然凄笑，经脉中残存的冰蚕寒气最后一次激荡，双臂运足残劲向崖边猛力一推，残躯决绝腾空翻滚，径直坠入深渊白雾之中。崖风呼啸吞没一切，游坦之粉身碎骨殒命崖底，唯余岩边数道带血抓痕与几片撕裂的破烂衣布在寒风中摇曳。","事件概要":"游坦之双目尽盲且残躯碎裂，惨遭阿紫绝情弃置后万念俱灰。他在黑暗与剧痛中咬牙以十指抠石，拖着残废躯体在荒岩间爬行十余丈；探至断崖边缘，游坦之惨然凄笑，运尽残存冰蚕寒劲决绝跃入万丈深渊，粉身碎骨殒命崖底。","insert":{"游坦之":{"人物经历":{"天龙第四十四回03-游坦之万念俱灰跳崖自尽":"遭阿紫嫌恶弃置后万念俱灰，再无苟活之念；在无边剧痛与黑暗中以十指抠入坚岩硬石，拖着残废下肢在泥泞中爬向崖边，终在万丈深渊前惨然凄笑，运尽残存冰蚕寒劲腾身翻入白雾深渊，粉身碎骨自尽殒命。"}}},"update":{"游坦之":{"状态":"死亡"}},"后续事件":{"天龙第四十四回05-萧峰恩怨平息决意返大辽":"少林诸事平息后，萧峰与虚竹、段誉以及少林众人作别。他念及辽国旧职与结义兄长，决定先返辽探知边境局势；众人相约有事互通消息，萧峰遂北上启程。"},"参与人物":["游坦之"],"delete":{"游坦之":{"身份":{"丐帮帮主":{}},"重要物品":{"打狗棒":{}}}}},"天龙第四十四回05-萧峰恩怨平息决意返大辽":{"事件地点":"大宋/少室山/少林寺/山门","触发条件":{"类型":"时间","年":1203,"月":6,"日":25,"时":17,"分":0},"事件结束时间":{"年":1203,"月":6,"日":25,"时":18,"分":0},"事件引子":"少林诸事平息后，萧峰与虚竹、段誉以及少林众人作别。他念及辽国旧职与结义兄长，决定先返辽探知边境局势；众人相约有事互通消息，萧峰遂北上启程。","事件详情":"少林诸事平息后，萧峰与虚竹、段誉以及少林众人作别。他念及辽国旧职与结义兄长，决定先返辽探知边境局势；众人相约有事互通消息，萧峰遂北上启程。","事件概要":"少林诸事平息后，萧峰与虚竹、段誉以及少林众人作别。他念及辽国旧职与结义兄长，决定先返辽探知边境局势；众人相约有事互通消息，萧峰遂北上启程。","insert":{"乔峰":{"人物经历":{"天龙第四十四回05-萧峰恩怨平息决意返大辽":"少林诸事平息后，萧峰与虚竹、段誉以及少林众人作别。他念及辽国旧职与结义兄长，决定先返辽探知边境局势；众人相约有事互通消息，萧峰遂北上启程。"}},"虚竹":{"人物经历":{"天龙第四十四回05-萧峰恩怨平息决意返大辽":"少林诸事平息后，萧峰与虚竹、段誉以及少林众人作别。他念及辽国旧职与结义兄长，决定先返辽探知边境局势；众人相约有事互通消息，萧峰遂北上启程。"}},"段誉":{"人物经历":{"天龙第四十四回05-萧峰恩怨平息决意返大辽":"少林诸事平息后，萧峰与虚竹、段誉以及少林众人作别。他念及辽国旧职与结义兄长，决定先返辽探知边境局势；众人相约有事互通消息，萧峰遂北上启程。"}}},"update":{},"后续