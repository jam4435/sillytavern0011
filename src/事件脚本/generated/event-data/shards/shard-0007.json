与自己肌肤相亲、共度春宵且柔情万种的“梦姑”，令他魂牵梦萦。即便此刻身为万众俯首、威名赫赫的灵鹫宫尊主，虚竹亦难掩心中的刻骨相思与落寞，陷入了修行精进与情思难断的内心煎熬之中。","事件概要":"虚竹率九天九部众女深入灵鹫宫密室，潜心参悟石壁所刻逍遥派绝顶图谱，依律运功使内力贯通融会，武学更臻化境。然而夜阑人静独归寝殿之时，西夏冰窖中与梦姑的温存旧事仍挥之不去，令他在神功精进与深种情根间备受相思煎熬。","insert":{"虚竹":{"人物经历":{"天龙第三十六回01-虚竹参悟石壁绝学夜思梦姑":"率领九天九部众女潜入密室面壁揣摩石刻图谱，运功调息使体内三家内力融会贯通；夜深独自返回寝殿后，冰窖中与梦姑缱绻温存的旧梦却挥之不去，辗转反侧备受相思折磨。"}}},"update":{"虚竹":{"所在位置":"西域/天山/灵鹫宫/寝殿"}},"后续事件":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"天山缥缈峰上朔风呼啸，灵鹫宫总坛石阶前快马急报突至，打破了雪域连日来的宁静。"},"参与人物":["虚竹"]},"天龙第三十六回02-西夏放榜招婿引动天下豪杰":{"事件地点":"西域/天山/灵鹫宫/总坛","触发条件":{"类型":"时间","年":1203,"月":7,"日":11,"时":8,"分":0},"事件结束时间":{"年":1203,"月":7,"日":13,"时":8,"分":0},"事件引子":"天山缥缈峰上朔风呼啸，灵鹫宫总坛石阶前快马急报突至，打破了雪域连日来的宁静。","事件详情":"灵鹫宫总坛的宁静被一份自天山传来的加急文书所打破。西夏国皇妃李秋水之孙女、银川公主李清露正式昭告天下，颁布皇室榜文，面向全天下广招青年才俊与王孙公子前往西夏皇宫应聘选婿。这一消息如同平地惊雷，以极快的速度传遍大江南北，令整个中原与边陲江湖为之震动。各国青年俊彦与各路江湖势力纷纷蠢蠢欲动，大理国镇南王世子段誉、心怀复国大计的姑苏慕容复、西域吐蕃国王子宗赞，以及天下间无数自命不凡的英雄豪杰，皆各自怀揣着截然不同的目的与野心，整顿行装启程西赴西夏。他们或是为了求娶倾国倾城的绝色佳人，或是贪图西夏皇室的至高权柄与联姻助力，天下各方风云随之迅速汇聚于西夏皇城。皇榜的传阅不仅在大江南北掀起了滔天波澜，更彻底点燃了中原与外邦青年才俊之间的角逐战火，形成了一场天下英豪竞相西进的浩大声势。","事件概要":"西夏银川公主正式颁布皇室榜文广招天下才俊为婿，消息如平地惊雷传遍大江南北。灵鹫宫接获飞书急报，天下各路势力亦闻风而动。段誉为顾念王语嫣痴心、慕容复为图谋复国权柄，各怀异心的豪杰纷纷整装西行，西夏皇城顿成天下风云交汇之所。","insert":{"虚竹":{"人物经历":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"在灵鹫宫总坛拆阅自西夏传来的飞书榜文，得知李秋水之孙女银川公主昭告天下选婿，心头骤然忆起冰窖中与梦姑的刻骨缠绵，又虑及西夏联姻恐牵动天下局势，当即下定决心西行赴会。"}},"慕容复":{"人物经历":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"得悉西夏皇室放榜为银川公主选婿，深觉此乃借助西夏雄厚国力与精锐甲兵以图光复大燕的天赐良机，当即决意暂搁私情，携四大家臣收拾行装奔赴西夏竞夺驸马之位。"}},"段誉":{"人物经历":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"闻听西夏放榜招婿而慕容复决意前往应聘，见王姑娘为此伤心欲绝、愁容满面，唯恐慕容复另娶她人会令王姑娘心碎轻生，遂打点行装随众前往西夏，暗自立誓护卫王姑娘周全。"}},"李清露":{"人物经历":{"天龙第三十六回02-西夏放榜招婿引动天下豪杰":"因苦寻黑暗冰窖中倾心相许的温热情郎无果，遂奏请皇室颁下榜文面向天下招选驸马，意图广聚各国青年才俊入宫应试，借机寻出刻骨铭心的梦郎重续前缘。"}}},"update":{},"后续事件":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"缥缈峰巅云雾缭绕，总坛殿内传书飞至，西夏银川公主选婿的榜文打破了灵鹫宫的宁静。"},"参与人物":["虚竹","李清露","慕容复","段誉"]},"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":{"事件地点":"西域/天山/灵鹫宫/总坛","触发条件":{"类型":"时间","年":1203,"月":7,"日":13,"时":8,"分":0},"事件结束时间":{"年":1203,"月":7,"日":21,"时":8,"分":0},"事件引子":"缥缈峰巅云雾缭绕，总坛殿内传书飞至，西夏银川公主选婿的榜文打破了灵鹫宫的宁静。","事件详情":"在缥缈峰灵鹫宫中，虚竹获悉了西夏国银川公主选婿的传书消息后，心绪翻江倒海，久久不能平静。他细细推想，西夏冰洞与西夏皇室有着千丝万缕的联系，自己苦苦寻觅、朝思暮想的“梦姑”，极有可能正深居于西夏皇宫大内之中。为了求证心中的执念并寻回挚爱，一向清心寡欲的虚竹毅然决定离开缥缈峰，亲赴西夏国都兴庆府一探究竟。灵鹫宫属下对尊主的安全极为挂念，俏丽忠诚的梅剑、兰剑、竹剑、菊剑四位近身侍女领命随行，贴身护卫左右。虚竹身着尊主锦袍，在四剑侍女的紧密簇拥与严密护持下步下天山。一行人快马加鞭，踏上了漫长而险峻的西行驿道。虚竹一路之上虽有四剑悉心照料饮食起居，但心中唯有对冰洞旧事的追忆与对相见的期盼。此次启程，不仅标志着灵鹫宫之主正式介入西夏局势，也让虚竹彻底踏入了一场关乎情缘与宿命的波澜征途。","事件概要":"虚竹获悉西夏招婿传书，推想朝思暮想的“梦姑”极可能身在西夏皇宫，遂决意西行寻觅挚爱。梅兰竹菊四剑挂念尊主安危，领命贴身护卫。虚竹换上锦袍，在四剑簇拥下步下缥缈峰，策马踏上奔赴西夏的征途。","insert":{"虚竹":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"见西夏选婿传书后推想梦姑定与西夏皇室大有关联，难耐相思执念遂决意亲赴兴庆府寻访；身着尊主锦袍，在梅兰竹菊四剑侍女的贴身护持下步下缥缈峰，策马踏上西行漫漫长路。"}},"梅剑":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"见尊主获悉西夏传书后心绪不宁并执意远赴西夏，唯恐其沿途有所闪失，遂与三位姐妹领命随行护驾，佩剑策马紧紧簇拥在尊主身侧步下天山。"}},"兰剑":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"得知尊主欲远赴西夏国都，心忧尊主安危，当即与三姐妹一同领命贴身护卫，整备行装鞍马，随侍尊主离开灵鹫宫总坛踏上西行驿道。"}},"竹剑":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"见尊主下定决心前往西夏，深感护卫之责重大，与梅、兰、菊三姐妹一同躬身领命相随，严密护卫在尊主周遭步下缥缈峰险径。"}},"菊剑":{"人物经历":{"天龙第三十六回03-虚竹携灵鹫四剑启程赴西夏":"见尊主决意前往西夏，与三位姊姊齐声领命贴身随侍，细心照应起居鞍马，寸步不离左右护持尊主启程西去。"}}},"update":{},"后续事件":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"官道两旁枯杨疏朗，风卷黄沙漫卷荒原，远处数骑快马踏尘而来，得得蹄声清晰可闻。"},"参与人物":["虚竹","梅剑","兰剑","竹剑","菊剑"]},"天龙第三十六回04-虚竹中途重逢段誉结伴同行":{"事件地点":"西夏/凉州/凉州荒漠/官道","触发条件":{"类型":"时间","年":1203,"月":7,"日":21,"时":8,"分":0},"事件结束时间":{"年":1203,"月":7,"日":21,"时":12,"分":0},"事件引子":"官道两旁枯杨疏朗，风卷黄沙漫卷荒原，远处数骑快马踏尘而来，得得蹄声清晰可闻。","事件详情":"虚竹此前与段誉自少林同行西赴天山，处理灵鹫宫事务后又与他及王语嫣、阿碧结伴往西夏。途中兄弟谈及近日际遇，虚竹感谢段誉相伴；众人并辔前往兴庆府。","事件概要":"少室山别后，虚竹与段誉同行处理天山事务，随后与王语嫣、阿碧结伴赴西夏。","insert":{"虚竹":{"人物经历":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"与三弟一路同行，料理灵鹫宫事务后结伴赴西夏。"}},"段誉":{"人物经历":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"陪二哥前往天山，又与众人结伴赴西夏。"}},"王语嫣":{"人物经历":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"随段誉等人同行前往西夏，心中仍挂念表哥。"}},"阿碧":{"人物经历":{"天龙第三十六回04-虚竹中途重逢段誉结伴同行":"随众人西行，温言相伴。"}}},"update":{},"后续事件":{"天龙第三十六回05-慕容复谋求复国决意弃表妹":"荒原官道上黄沙漫漫，西行队伍缓缓前行，车马旁三人各怀心事，暗流涌动。"},"参与人物":["虚竹","段誉","王语嫣","阿碧"]},"天龙第三十六回05-慕容复谋求复国决意弃表妹":{"事件地点":"西夏/凉州/凉州荒漠/官道","触发条件":{"类型":"时间","年":1203,"月":7,"日":21,"时":12,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":12,"分":0},"事件引子":"荒原官道上黄沙漫漫，西行队伍缓缓前行，车马旁三人各怀心事，暗流涌动。","事件详情":"在西行队伍缓缓前行的漫长路途上，众人之间暗流涌动。段誉对王语嫣一往情深，一路上嘘寒问暖、体贴入微，时刻竭尽所能关怀照料王语嫣的饮食起居，然而王语嫣心中眼中唯有自己朝思暮想的表哥慕容复，对段誉的真挚深情视若无睹、漠不关心。与此同时，姑苏慕容复内心却被巨大的野心与焦虑所吞噬。他一心汲汲于光复大燕帝业，深知单凭姑苏慕容氏残存的江湖势力根本无法与中原王朝抗衡，唯有夺得西夏驸马的大位，才能借助西夏一国的倾国精锐军力作为争夺天下的资本。在冷酷的帝王大业权衡之下，慕容复认为表妹王语嫣的儿女私情已然成为自己求娶西夏公主的最大障碍与累赘。经过激烈的权谋算计，慕容复彻底泯灭了青梅竹马的昔日情义，暗中决意斩断情丝，不惜彻底抛弃王语嫣，以此扫清自己争夺西夏乘龙快婿之位的一切羁绊。","事件概要":"西行途中段誉对王语嫣体贴备至，王语嫣却满心只有表哥。慕容复为借西夏重兵光复大燕，深感儿女私情已成争夺驸马的绊脚石，权衡之下泯灭青梅竹马情义，暗中决意彻底抛弃王语嫣。","insert":{"段誉":{"人物经历":{"天龙第三十六回05-慕容复谋求复国决意弃表妹":"随西行队伍前行，一路上对王姑娘嘘寒问暖、体贴照料，见其对自己视若无睹、唯独痴恋表哥，心中虽泛起酸楚，仍甘愿一路相随护其周全。"}},"王语嫣":{"人物经历":{"天龙第三十六回05-慕容复谋求复国决意弃表妹":"行于西夏荒原官道上，虽见段誉沿途殷勤体贴，但满心只系挂表哥争选驸马之事，对段誉的照料冷淡相对，唯盼表哥能顾念昔日情义。"}},"慕容复":{"人物经历":{"天龙第三十六回05-慕容复谋求复国决意弃表妹":"深知仅凭姑苏残存势力绝难复兴大燕，唯有夺得西夏驸马方能借助倾国重兵，冷酷权衡下终将表妹私情视为争夺大位的羁绊，暗自决意斩断情丝将其彻底舍弃。"}}},"update":{"慕容复":{"关系网":{"王语嫣":"视为累赘/30"}}},"后续事件":{"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":"斜阳残照荒郊逆旅，风卷黄沙掠过空地，四下萧索寂静，杀机暗伏。"},"参与人物":["段誉","王语嫣","慕容复"]},"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":{"事件地点":"西夏/凉州/荒漠客栈/门外空地","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":18,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":19,"分":0},"事件引子":"斜阳残照荒郊逆旅，风卷黄沙掠过空地，四下萧索寂静，杀机暗伏。","事件详情":"在荒野客栈外的空地上，慕容复为了彻底断绝王语嫣的念想，当众对王语嫣横加斥责、恶语相向，言辞极其冰冷刻薄，将多年兄妹情分践踏殆尽。王语嫣闻听表哥如此绝情言论，如遭晴天霹雳，顿时心碎神伤、悲痛欲绝，泪流满面地瘫软在侧。段誉见心仪之人受此奇耻大辱与无情折磨，胸中义愤填膺，按捺不住怒火挺身而出，厉声斥责慕容复寡情薄义、枉为君子。慕容复本就因复国大计屡屡受挫而心胸狭隘，见段誉横加干涉并戳中痛处，眼中杀机骤起。趁段誉全神贯注关切王语嫣、毫无防备之际，慕容复骤施辣手，暗中运起狠辣掌力对其暴起突袭。段誉措手不及之下胸口中掌，登时被击得气血翻涌、负伤倒退。这场言语与武力的剧烈冲突，令慕容复与段誉、王语嫣之间的关系彻底决裂，也让事态滑向了更为凶险失控的深渊。","事件概要":"慕容复为断绝痴念当众以刻薄恶语斥责王语嫣，致其心碎瘫软；段誉义愤填膺挺身怒斥其薄幸，反遭慕容复趁隙运狠辣掌力暴起暗算击伤胸口，三人彻底决裂。","insert":{"慕容复":{"人物经历":{"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":"为绝王语嫣痴念当众厉声喝斥、斩断旧情，见段誉挺身斥责戳中痛处，杀机骤起，趁其不备暴施狠辣掌力重击其胸口。"}},"王语嫣":{"人物经历":{"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":"闻听表哥当众严词斥责、将多年兄妹情分践踏殆尽，如遭晴天霹雳，万念俱灰下心碎神伤、瘫软倒地泪流不止。"}},"段誉":{"人物经历":{"天龙第三十六回06-慕容复恶语伤表妹暗算段誉":"目睹王姑娘受尽屈辱折磨，义愤填膺挺身斥责慕容复寡情薄义，分神关切王姑娘之际骤遭慕容复暗施毒手击中胸口，气血翻涌负伤退避。"}}},"update":{"段誉":{"状态":"胸部中掌、气血翻涌"},"王语嫣":{"状态":"心碎神伤、周身酸软","关系网":{"慕容复":"绝望心碎/25"}},"慕容复":{"关系网":{"王语嫣":"绝情弃绝/10","段誉":"心存杀意/10"}}},"后续事件":{"天龙第三十六回07-慕容复趁夜推王语嫣坠枯井":"夜色笼罩死寂荒野，残月如钩，一口干涸幽深的废弃枯井森然矗立在乱石枯草之间。"},"参与人物":["慕容复","王语嫣","段誉"]},"天龙第三十六回07-慕容复趁夜推王语嫣坠枯井":{"事件地点":"西夏/凉州/凉州荒漠/枯井旁","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":19,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":20,"分":0},"事件引子":"夜色笼罩死寂荒野，残月如钩，一口干涸幽深的废弃枯井森然矗立在乱石枯草之间。","事件详情":"夜幕笼罩荒野，四野一片死寂。遭受表哥绝情痛斥与抛弃的王语嫣万念俱灰，失魂落魄地游荡在荒野深处，神情恍惚已无生念。慕容复在暗中紧随其后，眼见王语嫣痴情纠缠不休，生怕她尾随至西夏皇宫破坏自己应聘驸马的大局。为绝后患并彻底抹去这一羁绊，慕容复眼中掠过一丝狠厉与决绝，悄然潜行至荒野中一座废弃已久的深邃干枯枯井旁。趁王语嫣毫无防备、神志恍惚之际，慕容复狠心运力猛然出手，将王语嫣一把推入了漆黑不见底的枯井深渊之中。王语嫣只觉身躯骤然悬空下坠，凄厉惊恐的惨呼声划破了寂静的黑夜，回荡在空旷荒野之上。慕容复伫立井口，眼见表妹坠入黑暗深处，心中毫无悔意，只觉复国路上的重大障碍已被彻底清除。这一冷酷狠毒的举动不仅将王语嫣推向了生死未卜的绝境，更在荒原上掀起了一场致命危机。","事件概要":"遭受抛弃的王语嫣万念俱灰、游荡荒野。慕容复深恐其纠缠破坏争选西夏驸马的大计，尾随至废井旁，趁其恍惚无备狠施掌力将表妹推入万丈深渊，绝情灭口以图复燕霸业。","insert":{"王语嫣":{"人物经历":{"天龙第三十六回07-慕容复趁夜推王语嫣坠枯井":"万念俱灰下游荡至荒野深处，神思恍惚间忽遭表哥运力狠推，猝不及防下跌入漆黑不见底的深邃枯井，凄声哀呼直坠幽暗绝境。"}},"慕容复":{"人物经历":{"天龙第三十六回07-慕容复趁夜推王语嫣坠枯井":"为绝后患以免表妹痴缠破坏竞选西夏驸马大计，暗中尾随至荒野枯井旁，趁其失魂落魄之际骤施毒手推入井底，自忖复国障碍已除。"}}},"update":{"王语嫣":{"状态":"坠落井底、生死未卜","关系网":{"慕容复":"心死绝望/0"}},"慕容复":{"关系网":{"王语嫣":"痛下杀手/0"}}},"后续事件":{"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":"荒原深夜死寂无声，枯井深处骤然响起凄厉惊恐的少女惨叫，撕裂了沉沉夜幕。"},"参与人物":["王语嫣","慕容复"]},"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":20,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":21,"分":0},"事件引子":"荒原深夜死寂无声，枯井深处骤然响起凄厉惊恐的少女惨叫，撕裂了沉沉夜幕。","事件详情":"王语嫣下坠时的凄厉惨叫声划破夜空，正在附近带伤寻找的段誉闻声大惊失色。段誉甚至来不及细想枯井到底有多深、井底有何凶险，出于对王语嫣舍生忘死的深情与护持之心，毫不犹豫地施展轻功，纵身向着漆黑阴森的枯井深处飞扑跃下，誓要以肉身护住心上人的周全。与此同时，一直在暗中窥伺觊觎的吐蕃国师鸠摩智亦现身于附近，他误以为枯井之中藏有绝世罕见的武学秘籍与神功图谱，贪念大炽之下不甘落后，施展身法紧随其后纵身跃入井中，企图抢夺机缘。三人接连坠入冰冷刺骨、漆黑不见五指的枯井底部。这一突发变故使得大理世子、姑苏佳人与吐蕃国师同时困于逼仄深井之内，重伤未愈与贪念交织，彼此立场错综复杂。一场奇绝玄妙、惊心动魄的枯井奇缘，就在这冰冷黑暗的深井底部悄然拉开了序幕。","事件概要":"闻得王语嫣坠井呼号，段誉不顾伤痛舍命扑入深井相护；暗中窥伺的鸠摩智误认井下藏有武学秘籍，贪念驱使下亦纵身随坠。三人相继跌入阴寒逼仄的枯井底部，因缘际会同陷死地。","insert":{"王语嫣":{"人物经历":{"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":"身子急剧坠向无底深渊，正万念俱灰凄声呼救之际，忽见段公子不顾生死随之扑落护持身旁，随后双双跌入刺骨泥泞的井底，惊魂未定间暗暗感念其舍命深情。"}},"段誉":{"人物经历":{"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":"忽闻王姑娘凄厉的呼救声自枯井深处传来，心胆俱裂下全然不顾自身掌伤与深井凶险，唯恐其香消玉殒，当即施展轻功纵身飞扑入井，誓以肉身护其周全，接连坠入漆黑冰冷的井底。"}},"鸠摩智":{"人物经历":{"天龙第三十六回08-段誉舍命救美鸠摩智随坠井":"暗中窥伺见段誉奋不顾身跃入深井，误以为枯井底部藏有不世出的神功秘籍与绝顶图谱，唯恐机缘遭他人抢占，利欲熏心下当即运起轻功紧随跃下，重重跌落入幽暗冰冷的井底。"}}},"update":{"王语嫣":{"状态":"身陷枯井、惊魂未定"}},"后续事件":{"天龙第三十七回01-鸠摩智走火入魔扣脉发难":"幽暗深陷的枯井中泥泞没胫、寒气彻骨，骤然响起野兽濒死般的凄厉咆哮。"},"参与人物":["王语嫣","段誉","鸠摩智"]},"天龙第三十七回00-人物登场":{"事件类型":"登场事件","所属回目":"第三十七回","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":21,"分":0},"新登场人物":["宗赞王子"],"insert":{"宗赞王子":{"性别":"男","外貌":"生得大头大耳，身躯雄伟魁梧，满腮短虬髯，头戴金冠，身着吐蕃华丽锦袍貂裘。","性格":"粗豪狂妄，好色庸俗，心高气傲","境界":"二流-中期","初始属性":{"臂力":15,"根骨":12,"机敏":6,"洞察":5,"悟性":4},"出生年份":1176,"状态":"健康","所在位置":"西夏/灵州/西夏皇宫/偏殿","身份":{"吐蕃王子":"吐蕃赞普之子"},"功法":{},"重要物品":{},"人物经历":{},"关系网":{"鸠摩智":"国师/70"}}},"update":{"李清露":{"所在位置":"西夏/灵州/西夏皇宫/偏殿纱帘后"}}},"天龙第三十七回01-鸠摩智走火入魔扣脉发难":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":21,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":22,"分":0},"事件引子":"幽暗深陷的枯井中泥泞没胫、寒气彻骨，骤然响起野兽濒死般的凄厉咆哮。","事件详情":"黑漆冰冷、污泥没胫的西夏枯井深处，吐蕃国师大轮明王鸠摩智因平生贪求武功天下第一，强行兼修少林七十二绝技、逍遥派小无相功以及少林《易筋经》，体内数股截然相反的至阳至阴霸道真气彻底失衡冲撞，陷入经脉逆乱的走火入魔绝境。鸠摩智周身穴道如万蚁噬咬、烈火灼烧，剧痛之下神智彻底沦入魔障，双目赤红如血，口中发出犹如凶兽濒死般的凄厉咆哮。在逼仄幽暗的井底烂泥中，他狂性大发，挥舞双掌使出狂乱无章的凶狠杀招，四处扑击乱抓。段誉唯恐王语嫣受创，死死将她护在身后，在湿滑泥泞中左支右绌、狼狈翻滚闪避，后背险些被凌厉罡风撕裂。生死一线之际，彻底失控的鸠摩智猛然欺身暴起，右爪如铁箍般咔嚓一声狠厉扣住了段誉的右手腕脉。鸠摩智意欲吐劲震断段誉心脉，却因脉门死死相锁，瞬间沟通了二人体内气血经络，令双方在冰冷泥沼中僵持锁死，直接引动了后续不可逆转的内力狂吸剧变。","事件概要":"鸠摩智因兼修多门神功致真气失衡，经脉逆乱彻底走火入魔，神智尽失下在泥沼中四处扑杀。段誉死命将王语嫣护在身后狼狈翻滚闪避，生死关头右手腕脉被狂乱的鸠摩智如铁箍般死死扣住，二人气血经络瞬间交汇锁死。","insert":{"鸠摩智":{"人物经历":{"天龙第三十七回01-鸠摩智走火入魔扣脉发难":"体内至阴至阳真气彻底冲撞失衡，周身剧痛如蚁噬火灼，癫狂之下神智尽失沦入魔障，双目赤红厉声咆哮四处扑击，狂乱中欺身暴起，右爪如铁箍般狠厉扣死段誉的右手腕脉。"}},"段誉":{"人物经历":{"天龙第三十七回01-鸠摩智走火入魔扣脉发难":"见鸠摩智狂性大发盲目扑杀，唯恐王姑娘受创而拼死将其护在身后，在湿滑烂泥中左支右绌狼狈翻滚，危急之际右手腕脉猝不及防被其铁爪狠厉扣死，二人经络顿时相通僵持难脱。"}},"王语嫣":{"人物经历":{"天龙第三十七回01-鸠摩智走火入魔扣脉发难":"蜷缩在冰冷井底烂泥中，目睹鸠摩智如厉鬼般狂暴扑击，惊骇万状中见段公子舍命将自己护在身后连番躲闪，转瞬见段公子腕脉被狂僧死死扣住僵持不起，心提至嗓子眼惊惧难言。"}}},"update":{"鸠摩智":{"状态":"走火入魔、经脉逆乱"},"段誉":{"状态":"腕脉受制、经络僵持"}},"后续事件":{"天龙第三十七回02-段誉北冥逆转吸尽敌内力":"幽暗冰冷的枯井深处泥泞腥臭，癫狂的低吼声与剧烈搏击的水响混杂回荡。"},"参与人物":["鸠摩智","段誉","王语嫣"]},"天龙第三十七回02-段誉北冥逆转吸尽敌内力":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":22,"分":0},"事件结束时间":{"年":1203,"月":7,"日":27,"时":23,"分":0},"事件引子":"幽暗冰冷的枯井深处泥泞腥臭，癫狂的低吼声与剧烈搏击的水响混杂回荡。","事件详情":"段誉右腕脉门遭走火入魔的鸠摩智如钢箍般死死扣住，外来暴虐内劲骤然侵入体内的极度危局下，段誉体内潜伏的《北冥神功》受此生死剧震刺激，护体气机自发产生强烈感应，瞬间犹如巨鲸吞海、天池倒泻般狂暴逆向运转起来。鸠摩智苦修数十载、融汇少林七十二绝技与小无相功的震古烁今浑厚真气，在北冥神功霸道绝伦的吞噬牵引下，化作狂涛怒浪，顺着交接的手太阴肺经不可遏止地倾泻涌入段誉周身百骸。体内积蓄一生的磅礴内力急速流失，撕心裂肺的空虚与脏腑抽搐令鸠摩智神智骤然清醒，眼中布满极度的恐惧与绝望。他凄厉惨嚎，双足在井底冰冷污泥中拼命扑腾蹬踹，左掌疯狂拍打泥泞试图借力震脱手腕自保。然而北冥吸力犹如强力胶漆牢不可破，将二人身躯如焊接般死死锁扣。段誉亦无法主动敛气收功，只能任由经脉承受气海翻涌膨胀的剧痛。真气狂澜持续倾注，直至鸠摩智一身雄浑霸道之内力被彻底抽吸得干干净净、涓滴不剩，狂暴倒灌方休，段誉由此尽纳明王毕生真元。 段誉静心调息，将新纳真气导入六脉，渐能自如催发六脉神剑。","事件概要":"鸠摩智走火入魔扣死段誉腕脉，暴虐内劲倒灌逼发段誉体内北冥神功自发逆行吞噬。鸠摩智清醒后剧痛惊恐挣扎难脱，段誉亦无法收敛神功，任由狂暴真元奔涌灌注。直至鸠摩智毕生功力被涓滴不剩尽数抽干，段誉尽纳其浑厚真气。 段誉调息融通新纳真气，六脉剑气渐能收发自如。","insert":{"段誉":{"人物经历":{"天龙第三十七回02-段誉北冥逆转吸尽敌内力":"右手脉门被鸠摩智死死扣住，生死存亡之际忽觉体内北冥神功如巨浪般狂暴反卷逆行，对方雄浑暴虐的内力如天池倒泻顺经脉源源涌入，周身经脉胀痛难忍却无法敛气罢手，直至强行将其毕生真气尽数吞纳气海。"}},"鸠摩智":{"人物经历":{"天龙第三十七回02-段誉北冥逆转吸尽敌内力":"扣住对方腕脉本欲倾泻杀力，不料反遭对方体内极霸道的怪异吸力牢牢吸附锁定，毕生苦修的深厚真元如决堤狂涛般疯狂流失；自惊惧中清醒后拼死蹬踹挣扎皆无法挣脱，凄厉惨嚎中任由一身磅礴内力被彻底吸噬一空。"}}},"update":{"段誉":{"境界":"绝顶-初期","状态":"真元充盈、经脉胀痛","功法":{"六脉神剑":{"掌握程度":"融会贯通"}}},"鸠摩智":{"境界":"不入流-圆满","状态":"功力尽失、虚脱萎顿"}},"后续事件":{"天龙第三十七回03-鸠摩智散尽内力顿悟出井":"幽暗阴冷的枯井底泥泞刺骨，狂暴撕扯的内力狂澜骤然消歇，四壁唯余粗重喘息。"},"参与人物":["段誉","鸠摩智"]},"天龙第三十七回03-鸠摩智散尽内力顿悟出井":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":27,"时":23,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":2,"分":0},"事件引子":"幽暗阴冷的枯井底泥泞刺骨，狂暴撕扯的内力狂澜骤然消歇，四壁唯余粗重喘息。","事件详情":"毕生雄浑内力被段誉彻底吸干之后，鸠摩智周身筋骨极度虚脱，经脉空荡无物，整个人如同一滩烂泥般瘫软在冰冷潮湿的井底泥泞中。然而，体内原先如焚似绞的逆乱真气荡然无存，这一场武功的彻底荡尽与死生剧变，犹如当头棒喝，反而彻底击碎了深植其心中数十年的贪嗔痴狂与心魔妄念。鸠摩智眸中原本狂暴狰狞的戾气尽数消退，神色骤然恢复了明镜般的澄澈与宁静。他在污泥中艰难挣扎着坐起身来，神态安详地拂去僧袍上的泥垢，整肃凌乱衣襟，随后神色平和地面向段誉与王语嫣双手合十，微微躬身宣佛号道：“阿弥陀佛，贫僧今日方识本来面目，多谢段公子化解此劫。”历经这番失却神功的大劫难，鸠摩智大彻大悟，彻底放下了对天下武学第一与虚荣名利的贪执妄求，选择皈依佛法本真。他仰天发出三声畅快淋漓的大笑，心无挂碍地攀着湿滑井壁青砖飘然翻身出井，从此彻底远离江湖血雨腥风与纷争恩怨，真正成为了一代名副其实、弘法利生的得道高僧。","事件概要":"内力散尽的鸠摩智瘫软于井底烂泥，经脉空荡反令心魔尽碎、大彻大悟。他神态安详向段誉合十道谢化解魔障之劫，仰天三声朗笑翻身攀壁跃出深井，从此遁离江湖恩怨皈依佛法；段誉与王语嫣劫后余生留在井底。","insert":{"鸠摩智":{"人物经历":{"天龙第三十七回03-鸠摩智散尽内力顿悟出井":"内力尽失瘫卧污泥之中，忽觉体内焚身真气消散殆尽，死生剧变如当头棒喝荡涤数十年贪嗔妄念，心境彻底明澈澄净，遂合十向段公子肃穆道谢，仰天畅笑翻身出井重归佛门。"}},"段誉":{"人物经历":{"天龙第三十七回03-鸠摩智散尽内力顿悟出井":"吞纳毕对方内力后满身真气胀痛难抑，见原本凶狂的吐蕃国师戾气全消、面容安详向自己合十行礼致谢，又见其朗笑攀壁跃出井去，心下既惊奇又感叹佛法玄妙。"}},"王语嫣":{"人物经历":{"天龙第三十七回03-鸠摩智散尽内力顿悟出井":"蜷缩泥泞中惊魂未定，眼见狂暴如恶鬼的吐蕃僧周身戾气退尽，整肃僧袍向段公子躬身致谢后朗笑跃出深井，见段公子安然无恙，紧绷的心弦方才松弛下来。"}}},"update":{"鸠摩智":{"状态":"顿悟通透、心无挂碍","所在位置":"西夏/凉州/凉州荒漠","性格":"慈悲祥和，四大皆空"}},"后续事件":{"天龙第三十七回04-王语嫣看清真相依许段誉":"鸠摩智去后，泥水没膝的幽暗枯井深处重归死寂，唯余二人狼狈相倚。"},"参与人物":["段誉","鸠摩智","王语嫣"]},"天龙第三十七回04-王语嫣看清真相依许段誉":{"事件地点":"西夏/凉州/凉州荒漠/枯井底","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":2,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":5,"分":0},"事件引子":"鸠摩智去后，泥水没膝的幽暗枯井深处重归死寂，唯余二人狼狈相倚。","事件详情":"鸠摩智离去后，冰冷幽暗、泥水没膝的枯井深处重归死寂，只剩下满身污泥的段誉与王语嫣二人相依独处。经历方才生死悬于一线的剧烈冲击，王语嫣心神巨震，神情凄楚迷茫。她回想起此前在枯井边，表哥慕容复为了争当西夏驸马、图谋复国霸业，竟对自己痛下杀手推入深井，而段誉却毫不犹豫纵身跃下舍命相救，更在鸠摩智发狂时用血肉之躯死死护住自己。这一冷一热的强烈对比，彻底粉碎了她自幼对表哥的盲目痴情与崇拜幻梦。王语嫣凝视着眼前狼狈不堪却满眼关切赤诚的段誉，泪水如断线珍珠般滚滚滑落，哽咽颤声道：“段公子，我表哥待我如此薄情狠毒，你……你为何却待我这般好？”段誉急忙笨拙地替她擦拭泪水，真诚剖白愿为她粉身碎骨。多年痛苦执念瞬间冰消瓦解，王语嫣毅然决然斩断旧情，主动扑入段誉怀中依偎相许。段誉惊喜交集，紧紧搂住心爱姑娘，二人在污泥中定下白首之约，两情相悦终成眷属。","事件概要":"枯井死寂之中，王语嫣回思表哥推己坠井的绝情残忍与段誉舍命相救的赤诚深情，多年盲目执念彻底冰消瓦解。面对段誉的真挚剖白，她痛斩旧情并主动投怀依偎，段誉惊喜交集紧紧相拥，二人于污泥绝境中互许白首之约。","insert":{"段誉":{"人物经历":{"天龙第三十七回04-王语嫣看清真相依许段誉":"见王姑娘神情凄楚垂泪质问，急忙笨拙为她拭泪并剖白甘愿为其粉身碎骨的痴心赤诚；忽见朝思暮想的姑娘主动投怀依偎相许，惊喜交集下紧紧将她搂入怀中，在这污泥深井中定下白首之约。"}},"王语嫣":{"人物经历":{"天龙第三十七回04-王语嫣看清真相依许段誉":"念及表哥狠心下毒手推己坠井、而段公子却舍命相随护持，幡然醒悟表哥寡情薄义而彻底粉碎多年执念；悲咽质问后得闻段公子赤诚剖白，心防冰释下毅然斩断旧情，扑入其怀中依偎托付终身。"}}},"update":{"段誉":{"关系网":{"王语嫣":"白首之约/95"}},"王语嫣":{"状态":"心有所属、互许白首","关系网":{"段誉":"白首之约/95"}}},"后续事件":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"幽暗泥泞的枯井深处寒意刺骨，井口上方忽地传来凌乱急促的脚步声与焦灼呼喊。"},"参与人物":["段誉","王语嫣"]},"天龙第三十七回05-虚竹垂绳救人同赴选婿会":{"事件地点":"西夏/凉州/凉州荒漠/枯井","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":5,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":17,"分":0},"事件引子":"幽暗泥泞的枯井深处寒意刺骨，井口上方忽地传来凌乱急促的脚步声与焦灼呼喊。","事件详情":"段誉与王语嫣在枯井定下终身盟约后，身陷数丈之深的滑腻泥坑无法自行脱困，正在商议如何脱险之际，井口上方忽然传来了急促的脚步声与呼唤声。逍遥派掌门、灵鹫宫尊主虚竹因担忧结拜三弟段誉的安危，亲自率领灵鹫宫梅兰竹菊四剑及九天九部部众一路循迹搜寻至此。虚竹伏在井口向下探视，惊喜高呼：“三弟！你可无恙？”井底段誉闻声大喜，扬声回应报平安。虚竹当机立断，吩咐侍女取来灵鹫宫特制的坚韧长绳垂入幽深井底。段誉细心地先将绳索牢牢系在王语嫣腰间，虚竹以内力与众女合力将王语嫣安稳拽上井沿，随后再次垂绳将段誉拉出泥潭。脱险出井后，众人在井旁引清冽泉水洗去满身污泥秽渍，换上干净素雅的新衣，整肃仪容。段誉与虚竹互道别后情由，决定结伴一同前往西夏皇宫赴银川公主的招婿盛会。众人行至皇宫主殿广场，只见慕容复、吐蕃宗赞王子等数百名青年才俊早已云集列队，正式拉开了选婿角逐的序幕。","事件概要":"段誉与王语嫣身陷湿滑枯井难以脱身，虚竹率灵鹫宫部众循迹寻至井口，垂下长绳以内力将二人拉出泥坑。众人引泉涤净泥污、整肃仪容，段誉与虚竹互叙别情后结伴同赴招婿盛会，抵达皇宫主殿广场与慕容复等百余才俊同列待选。","insert":{"段誉":{"人物经历":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"困于泥泞深井忽闻义兄虚竹呼唤，喜出望外下依言将垂落长绳系于王姑娘腰间护其先登，随后自身亦被拉出枯井脱困；引泉净身更衣后，欣然与二哥结伴奔赴西夏皇宫主殿广场共赴选婿大会。"}},"虚竹":{"人物经历":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"率领灵鹫部众一路搜寻至荒野枯井，喜见三弟段誉与王姑娘受困井底，当即垂下坚韧长绳以内力将二人拽出险境；听闻三弟别后经历后，遂与之相伴前往西夏皇宫广场，欲探明选婿真相与梦姑线索。"}},"王语嫣":{"人物经历":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"陷于枯井烂泥中得段公子悉心照料，忽遇其义兄虚竹垂绳施救，任由段公子细致将绳索系牢腰间拉上井沿脱离死地；更衣涤尘后随众人同赴皇宫广场，默默注视前方整肃待选的表哥慕容复。"}},"慕容复":{"人物经历":{"天龙第三十七回05-虚竹垂绳救人同赴选婿会":"除却表妹羁绊后疾行赶至西夏皇宫主殿广场列队待选，见各国公侯才俊云集，按捺心神静待内廷召选以图光复大燕。"}}},"update":{"段誉":{"所在位置":"西夏/灵州/西夏皇宫/主殿广场"},"虚竹":{"所在位置":"西夏/灵州/西夏皇宫/主殿广场"},"王语嫣":{"所在位置":"西夏/灵州/西夏皇宫/主殿广场"},"慕容复":{"所在位置":"西夏/灵州/西夏皇宫/主殿广场"}},"后续事件":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"西夏偏殿内幽香浮动，明珠纱帘重垂，侍女执灯宣示三问，阶下求婚群雄屏息肃立。"},"参与人物":["段誉","王语嫣","虚竹"]},"天龙第三十七回06-侍女隔帘设三问群雄竞答":{"事件地点":"西夏/灵州/西夏皇宫/偏殿","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":17,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":19,"分":0},"事件引子":"西夏偏殿内幽香浮动，明珠纱帘重垂，侍女执灯宣示三问，阶下求婚群雄屏息肃立。","事件详情":"西夏皇宫偏殿内烛影摇曳、香烟袅袅，深处重重垂挂着一层薄如蝉翼的明珠纱帘。西夏银川公主李清露端坐帘后暗影中，为从数百名求婚者中寻觅昔日冰洞旧人，特遣贴身侍女手持宫灯款步走出。侍女立于玉阶之上，神情肃穆地向阶下环列的慕容复、宗赞王子、段誉、虚竹等各路青年才俊当众宣示三道古怪考题：一问平生在何处最感逍遥快乐，二问生平最心爱之人容貌若何，三问这心爱之人闺名唤作什么。群雄闻言各怀机心逐一作答：慕容复急于攀附西夏借兵复国，冠冕堂皇答道平生最乐在将来光复大燕，所爱之人容貌绝美却不知闺名，言语满是权谋做作；吐蕃宗赞王子粗俗狂妄，大声道最乐在王宫打猎饮酒，最爱之人便是帘后公主；段誉则坦荡赤诚，直言最快乐在黑暗冰冷的枯井底，最心爱之人便是王语嫣姑娘，闺名即是语嫣。众才俊或虚伪或狂妄，回答皆未能触及帘后公主心弦，大殿内气氛逐渐紧张凝滞，静候最终裁决。","事件概要":"银川公主李清露端坐纱帘后，遣侍女抛出三道古怪问答以寻昔日梦郎。宗赞狂言嗜酒猎艳，慕容复满口复国权谋，段誉赤诚坦陈枯井定情。各路才俊各怀机心逐一作答，皆非意中人，殿内气氛凝滞，只待虚竹应答。","insert":{"李清露":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"端坐重重明珠纱帘之后，遣侍女提出关乎冰洞旧事的三问以寻梦郎；隔帘细听群豪答复，闻其或狂妄庸俗、或虚伪功利，皆非刻骨铭心的意中人，心下惆怅焦灼。"}},"慕容复":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"立于偏殿阶下迎对侍女三问，一心借联姻招揽西夏兵力光复大燕，遂冠冕堂皇答称生平至乐在未来复燕大业，所爱之人绝美却不知闺名，自恃应对得体定能博得公主青睐。"}},"宗赞王子":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"粗声大嗓当众夸口，昂然高呼平生最乐乃在王宫饮酒行猎，所爱之人便是帘后西夏公主，意图以吐蕃王族声势压倒群豪夺得驸马之位。"}},"段誉":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"面对侍女提问毫无争夺驸马之念，坦荡直言生平最快乐在黑暗冰冷的枯井之中，所爱之人唯有王语嫣姑娘，当众表明心迹无悔相许。"}},"虚竹":{"人物经历":{"天龙第三十七回06-侍女隔帘设三问群雄竞答":"随三弟立于殿中旁观群豪应试，听闻侍女提出平生何处最乐、所爱何人等古怪考题，心头蓦地泛起冰窖缱绻旧忆，见众人竞相争答，唯恐轮及自身而暗自局促不安。"}}},"update":{},"后续事件":{"天龙第三十七回07-虚竹坦陈梦境被选为驸马":"殿内檀香幽微，众俊彦竞答方歇，侍女忽执名册遥遥指向偏隅静立的丑僧。"},"参与人物":["李清露","慕容复","宗赞王子","段誉","虚竹"]},"天龙第三十七回07-虚竹坦陈梦境被选为驸马":{"事件地点":"西夏/灵州/西夏皇宫/偏殿","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":19,"分":0},"事件结束时间":{"年":1203,"月":7,"日":28,"时":20,"分":0},"事件引子":"殿内檀香幽微，众俊彦竞答方歇，侍女忽执名册遥遥指向偏隅静立的丑僧。","事件详情":"侍女点名询问虚竹。虚竹据实答出平生至乐在黑暗冰窖，心爱之人只知唤作梦姑。珠帘后传来失声与茶盏碎裂之响，众人惊疑，虚竹尚不知帘后之人是谁，静候回应。","事件概要":"虚竹坦陈冰窖旧梦与梦姑之名，帘后女子失声碎盏，众人静候回应。","insert":{"虚竹":{"人物经历":{"天龙第三十七回07-虚竹坦陈梦境被选为驸马":"据实答出冰窖旧梦和梦姑之名，闻帘后碎盏，茫然静候。"}},"李清露":{"人物经历":{"天龙第三十七回07-虚竹坦陈梦境被选为驸马":"闻虚竹道出冰窖旧事与梦姑之名，惊喜交集，失手碎盏。"}},"段誉":{"人物经历":{"天龙第三十七回07-虚竹坦陈梦境被选为驸马":"听二哥坦陈冰窖旧梦，闻帘后失声碎盏，静候结果。"}}},"update":{},"后续事件":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"珠帘后茶盏破碎，殿上众人屏息静候。"},"参与人物":["虚竹","李清露","段誉"]},"天龙第三十八回00-人物登场":{"事件类型":"登场事件","所属回目":"第三十八回","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":20,"分":0},"新登场人物":["甘宝宝","秦红棉","李青萝"],"insert":{"甘宝宝":{"性别":"女","外貌":"三十余岁少妇模样，容貌娇艳俏丽，身段苗条婀娜，身着锦缎袄裙，眉目含情。","性格":"柔情似水，机敏多心，爱憎分明","境界":"三流-中期","初始属性":{"臂力":5,"根骨":7,"机敏":13,"洞察":8,"悟性":5},"出生年份":1168,"状态":"健康","所在位置":"大宋/太湖/曼陀山庄","身份":{"万劫谷谷主夫人":"俏夜叉"},"功法":{},"重要物品":{},"人物经历":{},"关系网":{"段正淳":"情人/85","钟灵":"母女/90","秦红棉":"同门师妹/60"}},"秦红棉":{"性别":"女","外貌":"三十余岁年纪，长挑身材，容貌俏丽而神色冷峻，身着黑色劲装，腰佩修罗双刀。","性格":"孤僻暴躁，执着痴情，性格刚烈","境界":"二流-中期","初始属性":{"臂力":9,"根骨":8,"机敏":14,"洞察":8,"悟性":6},"出生年份":1166,"状态":"健康","所在位置":"大宋/太湖/曼陀山庄","身份":{"修罗刀":"幽谷隐士"},"功法":{"修罗刀法":{"掌握程度":"略有小成"}},"重要物品":{},"人物经历":{},"关系网":{"段正淳":"情人/85","木婉清":"母女/90","甘宝宝":"同门师姐/60"}},"李青萝":{"性别":"女","外貌":"四十岁上下年纪，面容端庄美艳，眉宇间颇具威严，身穿华贵锦袍，体态丰腴。","性格":"傲慢狠辣，喜怒无常，深情偏执","境界":"二流-中期","初始属性":{"臂力":5,"根骨":7,"机敏":6,"洞察":10,"悟性":13},"出生年份":1162,"状态":"健康","所在位置":"大宋/太湖/曼陀山庄","身份":{"曼陀山庄庄主":"王夫人"},"功法":{},"重要物品":{},"人物经历":{},"关系网":{"段正淳":"旧情人/70","王语嫣":"母女/85","慕容复":"姑甥/40"}}},"update":{"包不同":{"所在位置":"西夏/灵州/城郊荒原/荒谷"}}},"天龙第三十八回01-虚竹成西夏驸马慕容复落选":{"事件地点":"西夏/灵州/西夏皇宫/偏殿","触发条件":{"类型":"时间","年":1203,"月":7,"日":28,"时":20,"分":0},"事件结束时间":{"年":1203,"月":7,"日":29,"时":0,"分":0},"事件引子":"珠帘后茶盏破碎，殿上众人屏息静候。","事件详情":"帘后李清露认出虚竹便是梦郎，掀帘相见，二人欣喜相认。西夏国主随即宣旨赐婚，择虚竹为驸马，赐予金印与龙凤佩饰；虚竹与段誉出列谢恩，西夏、灵鹫宫和大理借此结好。慕容复借婚复国的计划落空，羞愤离殿。","事件概要":"李清露揭帘与虚竹相认，国主赐婚并赐金印佩饰，三方结好；慕容复落选离殿。","insert":{"虚竹":{"人物经历":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"见公主揭帘认出梦姑，领旨受赐金印佩饰，与段誉出列谢恩。"},"身份":{"西夏驸马":"西夏国银川公主之夫婿"},"关系网":{"李清露":"结发夫妻/95"},"重要物品":{"西夏御赐金印":"西夏国主御赐象征皇室联姻与驸马尊荣的金印","龙凤佩饰":"西夏皇室赐予驸马迎娶公主之大婚佩饰信物"}},"慕容复":{"人物经历":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"自恃应对高雅得体定能博取公主青睐借兵复燕，岂料内廷竟将驸马之位钦定予少林丑僧虚竹；眼见数载谋划化为泡影且颜面尽失，胸中妒恨怨毒翻涌，愤然拂袖离殿。"}},"李清露":{"人物经历":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"揭帘与梦郎相认，同受赐婚。"}},"段誉":{"人物经历":{"天龙第三十八回01-虚竹成西夏驸马慕容复落选":"为二哥与公主相认欢喜，与二哥出列谢恩，见西夏、灵鹫宫与大理结好。"}}},"update":{"李清露":{"关系网":{"虚竹":"结发夫妻/95"}}},"后续事件":{"天龙第三十八回02-慕容复屈膝投靠段延庆为父":"太湖曼陀山庄花厅内冷风萧索，段延庆铁杖拄地铮铮作响，慕容复神色阴鸷踏入厅堂。"},"参与人物":["慕容复","虚竹","李清露","段誉"]},"天龙第三十八回02-慕容复屈膝投靠段延庆为父":{"事件地点":"大宋/太湖/曼陀山庄","触发条件":{"类型":"时间","年":1203,"月":8,"日":19,"时":8,"分":0},"事件结束时间":{"年":1203,"月":8,"日":19,"时":10,"分":0},"事件引子":"太湖曼陀山庄花厅内冷风萧索，段延庆铁杖拄地铮铮作响，慕容复神色阴鸷踏入厅堂。","事件详情":"慕容复在西夏招亲彻底落选之后，深感单凭姑苏慕容氏残存之力绝难实现光复大燕之宏愿，复国欲念炽烈攻心之下，决意破罐子破摔，与四大恶人之首“恶贯满盈”段延庆暗中接洽勾结。段延庆一心夺取大理国皇位，二人各怀鬼胎、一拍即合。为了换取段延庆与四大恶人势力的全力相助，慕容复彻底抛弃大燕皇室之尊严与历代祖宗清誉，在密会之中当众推金山倒玉柱，双膝重重跪倒在段延庆铁杖之下，口称“义父”，甘愿沦为大理段氏之干儿子，立下重誓要借助大理国政权与精锐军力起兵复国。段延庆见名满天下的姑苏慕容公子竟如此卑躬屈膝、甘充义子爪牙，大为快意与满意，当场应允结为父子同盟。至此，慕容复彻底抛弃武林世家道义与正道名节，与邪道恶徒达成政治盟约，确立了借大理夺权的阴毒计划，为其日后掀起滔天血雨腥风铺平了道路。","事件概要":"西夏招亲落选后，慕容复复国心切，决意放下身段与四大恶人之首段延庆暗中勾结。为换取段延庆与大理政权兵力支持，慕容复甘弃大燕尊严，当众屈膝跪拜其为义父，立誓借大理军力起兵复燕；段延庆快意应允，邪道与世家彻底结为政治同盟。","insert":{"慕容复":{"人物经历":{"天龙第三十八回02-慕容复屈膝投靠段延庆为父":"眼见西夏招亲成空、复燕大业无望，决意不惜一切代价借势夺权，遂抛下大燕皇室体面与家训，当众重重跪倒在段延庆铁杖之下口称义父，誓借大理之兵以图复兴大业。"}},"段延庆":{"人物经历":{"天龙第三十八回02-慕容复屈膝投靠段延庆为父":"见姑苏慕容氏家主竟为图谋大业当众向自己屈膝下跪、甘认义父，心下大感快意与受用，当即以腹语应允结为父子同盟，决意借其武功与声势助自己夺回大理皇位。"}}},"update":{"慕容复":{"关系网":{"段延庆":"义父/50"}},"段延庆":{"关系网":{"慕容复":"义子/50"}}},"后续事件":{"天龙第三十八回03-慕容复暴起击杀家臣包不同":"曼陀山庄庄内死寂肃杀，包不同双目喷火怒视方才屈膝认贼的慕容复，空气森冷如铁。"},"参与人物":["慕容复","段延庆"]},"天龙第三十八回03-慕容复暴起击杀家臣包不同":{"事件地点":"大宋/太湖/曼陀山庄","触发条件":{"类型":"时间","年":1203,"月":8,"日":19,"时":10,"分":0},"事件结束时间":{"年":1203,"月":8,"日":19,"时":11,"分":0},"事件引子":"曼陀山庄庄内死寂肃杀，包不同双目喷火怒视方才屈膝认贼的慕容复，空气森冷如铁。","事件详情":"慕容复跪拜认贼作父的屈辱丑态，被其身旁忠心耿耿的家臣包不同等在场众人尽收眼底。包不同向来性格刚烈耿直、对大燕慕容氏忠心不二，眼见少主为了虚无缥缈的权位竟彻底丧尽廉耻与人格，顿时气血翻涌、痛心疾首。包不同按捺不住满腔悲愤，当众厉声痛斥慕容复，怒骂其下跪认贼是不忠不孝不仁不义，甘愿沦为天下走狗、奴颜婢膝，令姑苏慕容数百年英名扫地以尽。其言辞如刀，字字句句直戳慕容复痛处。慕容复被当众揭穿痛处，恼羞成怒之下凶性彻底大发。为了向段延庆交纳投名状以表忠心，同时杀人灭口掩盖自己认贼作父的丑行，慕容复面露狰狞，趁包不同毫无防备之际自其背后悍然暴起，汇聚毕生内力狠辣无情地击出一掌，重重击碎了包不同的背心大穴。包不同护体真气瞬间崩溃，口喷鲜血，圆睁双目倒地气绝身亡。","事件概要":"包不同痛心慕容复屈膝认贼作父，当众厉声斥其不忠不孝、辱没大燕英名。慕容复被戳中痛处恼羞成怒，为向段延庆纳投名状并灭口遮丑，自背后猝施辣手一掌震碎包不同背心大穴，致其当场气绝毙命。","insert":{"慕容复":{"人物经历":{"天龙第三十八回03-慕容复暴起击杀家臣包不同":"见包不同当众破口痛骂、字字戳中自身认贼作父的屈辱痛处，恼羞成怒之下杀机大发；为向段延庆纳投名状并杀人灭口，趁其不备自背后猝施毒手，聚毕生功力一掌震碎其背心要穴，将其当场击毙。"}},"包不同":{"人物经历":{"天龙第三十八回03-慕容复暴起击杀家臣包不同":"眼见少主竟为虚名权位向段延庆屈膝认贼作父，悲愤交加之下当众厉声痛斥其不忠不孝、辱没大燕数百年英名；万没想到背后猝遭慕容复悍然暴起偷袭，背心大穴被其重手震碎，气血溃散当场毙命。"}},"段延庆":{"人物经历":{"天龙第三十八回03-慕容复暴起击杀家臣包不同":"冷眼看着包不同当众痛骂慕容复认贼作父，旋即见慕容复恼羞成怒暴起偷袭、自背后辣手击杀亲信家臣以纳投名状，心中冷哂其心性残忍凉薄，却也乐见其斩断退路效忠自身。"}}},"update":{"包不同":{"状态":"死亡"}},"后续事件":{"天龙第三十八回04-风波恶公冶乾折兵断义而去":"曼陀山庄庭院中弥漫着刺鼻血腥，包不同尸身横卧血泊，周遭空气凝固如冰。"},"参与人物":["慕容复","包不同","段延庆"]}}}
